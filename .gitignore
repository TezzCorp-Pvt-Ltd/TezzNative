# Allow specific files
!README.md
!LICENSE.txt
!SECURITY.md
!version.json
!install.ps1
!install.sh
!install.cmd
!install-gui.ps1
!install-gui.sh
!tezz
!tezz.cmd
!tezz.ps1
!tezz.mod
!tezz.lock
!registry.tnx
!hello.tn
!.gitignore
!.gitattributes

# Exclude compiled binaries and node_modules inside extension
tezznative-vscode/node_modules/
tezznative-vscode/*.vsix

# ── TezzCorp Language Portal Website Sources ─────────────────────────────────
!TezzCorp_WebSites/
!TezzCorp_WebSites/tn_tezzcorp_com/
!TezzCorp_WebSites/tn_tezzcorp_com/**

# Never commit real secrets / log files / disaster recovery archives
TezzCorp_WebSites/tn_tezzcorp_com/.env
TezzCorp_WebSites/tn_tezzcorp_com/logs/
TezzCorp_WebSites/tn_tezzcorp_com/logs/**
TezzCorp_WebSites/tn_tezzcorp_com/storage/
TezzCorp_WebSites/tn_tezzcorp_com/storage/**
TezzCorp_WebSites/tn_tezzcorp_com/tezznative_source_backup.tar.gz
TezzCorp_WebSites/tn_tezzcorp_com/*source_backup*

# Temporary scratch scripts, logs, and artifacts
# Local speech datasets, training checkpoints, and generated audio stay local.
tezzmodel/
tezzmodel/**
tools/vocoder/checkpoints/
tools/vocoder/__pycache__/
*.pt
TezzCorp_WebSites/tn_tezzcorp_com/download/sdk/build/CMake*
TezzCorp_WebSites/tn_tezzcorp_com/download/sdk/build/CMakeFiles/
TezzCorp_WebSites/tn_tezzcorp_com/download/sdk/build_mingw/
tests/regression/**/*.exe
tests/regression/**/__pycache__/
tests/hardware/**/__pycache__/
tools/hardware/**/__pycache__/
scratch/
scratch/**
temp/
tmp/
*.tmp
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.log
tests/*.exe
benchmarks/*.exe
examples/**/*.exe

# Editor & OS artifacts
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Credentials & Sensitive Files
ssh.txt
*ssh*.txt
*pass*.cmd
*pass*.bat
*pass*.ps1
*.pem
*.key
*.env
*.env.*
