// Native CPU baseline: real CTC training and checkpoint inference.
// train/resume manifest.tsv checkpoint epochs limit [rate_ppm hidden context]
// evaluate manifest.tsv checkpoint predictions.tsv limit
// fit-text train.tsv checkpoint output.tns limit [width weight_ppm insertion_ppm]
import "../lib/stt.tn"

fn manifest_line(file:*char) -> str:
  unsafe:
    let line:*char = malloc(8193)
    if line == 0: ret 0 as str
    let n:int = 0
    while n < 8192:
      let value:char = 0 as char
      if fread(&value, 1, 1, file) != 1: break
      if value == 10 as char: break
      unsafe:
        line[n] = value
      n = n + 1
    unsafe:
      line[n] = 0 as char
    if n == 0:
      free(line)
      ret 0 as str
    ret line as str

fn positive(s:str, cap:int) -> int:
  unsafe:
    if s == 0: ret 0
    let n:int = len(s)
    if n < 1 || n > 8: ret 0
    let value:int = 0
    let i:int = 0
    while i < n:
      let digit:int = s[i] as int - 48
      if digit < 0 || digit > 9: ret 0
      value = value * 10 + digit
      if value > cap: ret 0
      i = i + 1
    ret value

fn encode(text:str, labels:*int) -> int:
  unsafe:
    let n:int = len(text)
    if n < 1 || n > 448: ret 0
    let i:int = 0
    while i < n:
      let ch:int = text[i] as int
      let label:int = 0
      if ch == 32:
        label = 1
      else if ch == 39:
        label = 2
      else if ch >= 97 && ch <= 122:
        label = ch - 97 + 3
      else:
        ret 0
      unsafe:
        labels[i] = label
      i = i + 1
    ret n

fn run_epoch(engine:*SttEngine, manifest:str, limit:int, output:*char, rate_ppm:int) -> int:
  unsafe:
    let file:*char = fopen(manifest, "rb")
    if file == 0: ret -1
    let labels:[int;448]
    let count:int = 0
    let total:float = 0.0
    while count < limit:
      let line:str = manifest_line(file)
      if line == 0: break
      let n:int = len(line)
      if n == 0:
        unsafe:
          free(line)
        break
      if n > 8192:
        unsafe:
          free(line)
        fclose(file)
        ret -1
      let separator:int = 0
      while separator < n && line[separator] != 9 as char:
        separator = separator + 1
      if separator == 0 || separator == n:
        unsafe:
          free(line)
        fclose(file)
        ret -1
      unsafe:
        line[separator] = 0 as char
      let text:str = 0 as str
      unsafe:
        text = ((line as *char) + separator + 1) as str
      let text_len:int = len(text)
      while text_len > 0 && (text[text_len - 1] == 10 as char || text[text_len - 1] == 13 as char):
        text_len = text_len - 1
        unsafe:
          text[text_len] = 0 as char
      if output == 0:
        let label_count:int = 0
        unsafe:
          label_count = encode(text, &labels[0])
        let loss:float = 0.0
        let result:int = -1
        unsafe:
          if label_count > 0:
            if rate_ppm < 0:
              result = stt.stt_train_text(engine, &labels[0], label_count)
            else:
              result = stt.stt_train_file(engine, line, &labels[0], label_count, rate_ppm, &loss)
        if result != 0:
          say "TRAIN_ERROR", line
          unsafe:
            free(line)
          fclose(file)
          ret -1
        total = total + loss
      else:
        let prediction:str = stt.stt_from_file(engine, line)
        if prediction == 0:
          say "PREDICT_ERROR", line
          unsafe:
            free(line)
          fclose(file)
          ret -1
        let tab:[char;2] = [9 as char, 0 as char]
        let newline:[char;2] = [10 as char, 0 as char]
        unsafe:
          if fwrite(line, 1, len(line), output) != len(line) || fwrite(&tab[0], 1, 1, output) != 1 || fwrite(prediction, 1, len(prediction), output) != len(prediction) || fwrite(&newline[0], 1, 1, output) != 1:
            free(line)
            fclose(file)
            ret -1
      unsafe:
        free(line)
      count = count + 1
    fclose(file)
    if count == 0: ret -1
    if output == 0:
      if rate_ppm < 0:
        say "TEXT_ITEMS", count, "STEPS", stt.stt_training_steps(engine)
      else:
        say "TRAIN_ITEMS", count, "CTC_MEAN", total / (count as float), "STEPS", stt.stt_training_steps(engine)
    else:
      say "EVALUATED_ITEMS", count
    ret 0

fn main() -> int:
  unsafe:
    if args_count() < 5:
      say "usage: train/resume manifest.tsv checkpoint epochs limit [rate_ppm hidden context]; evaluate manifest.tsv checkpoint predictions.tsv limit"
      ret 2
    let command:str = arg(0)
    let manifest:str = arg(1)
    let checkpoint:str = arg(2)
    let engine:*SttEngine = stt.stt_new()
    if engine == 0: ret 3
    say "SPEECH_DEVICE cpu; own native float32 MLP/CTC; no external model"
    let result:int = -1
    if strcmp(command, "train") == 0 || strcmp(command, "resume") == 0:
      let epochs:int = positive(arg(3), 10000)
      let limit:int = positive(arg(4), 20000)
      let rate_ppm:int = 1000
      let hidden:int = 64
      let context:int = 5
      if args_count() >= 6: rate_ppm = positive(arg(5), 100000)
      if args_count() >= 7: hidden = positive(arg(6), 256)
      if args_count() >= 8: context = positive(arg(7), 10)
      if epochs == 0 || limit == 0 || rate_ppm == 0 || hidden < 8 || context == 0 || args_count() > 8:
        stt.stt_free(engine)
        ret 2
      let ready:int = -1
      if strcmp(command, "resume") == 0:
        ready = stt.stt_load_model(engine, checkpoint)
      else:
        ready = stt.stt_create_trainable(engine, hidden, context, 42)
      if ready != 0:
        stt.stt_free(engine)
        ret 4
      let epoch:int = 0
      while epoch < epochs:
        say "EPOCH", epoch + 1
        result = run_epoch(engine, manifest, limit, 0 as *char, rate_ppm)
        if result != 0: break
        result = stt.stt_save_model(engine, checkpoint)
        if result != 0: break
        epoch = epoch + 1
    else if strcmp(command, "fit-text") == 0:
      let limit:int = positive(arg(4), 20000)
      let width:int = 32
      let weight:int = 500000
      let insertion:int = 500000
      if args_count() >= 6: width = positive(arg(5), 128)
      if args_count() >= 7:
        weight = positive(arg(6), 2000000)
        if weight == 0 && strcmp(arg(6), "0") != 0: width = 0
      if args_count() >= 8:
        insertion = positive(arg(7), 5000000)
        if insertion == 0 && strcmp(arg(7), "0") != 0: width = 0
      if limit == 0 || width == 0 || args_count() > 8 || strcmp(checkpoint, arg(3)) == 0:
        stt.stt_free(engine)
        ret 2
      if stt.stt_load_model(engine, checkpoint) != 0 || stt.stt_reset_text_model(engine) != 0:
        stt.stt_free(engine)
        ret 4
      result = run_epoch(engine, manifest, limit, 0 as *char, -1)
      if result == 0: result = stt.stt_set_decoder(engine, width, weight, insertion)
      if result == 0: result = stt.stt_save_model(engine, arg(3))
    else if strcmp(command, "evaluate") == 0:
      let limit:int = positive(arg(4), 20000)
      if limit == 0 || stt.stt_load_model(engine, checkpoint) != 0:
        stt.stt_free(engine)
        ret 4
      let output:*char = fopen(arg(3), "wb")
      if output == 0:
        stt.stt_free(engine)
        ret 5
      result = run_epoch(engine, manifest, limit, output, 0)
      if fclose(output) != 0: result = -1
    stt.stt_free(engine)
    if result != 0: ret 1
    ret 0

