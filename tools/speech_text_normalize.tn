// Canonical English TTS manifests: input.tsv output.tsv.
// The output must be new. Invalid input never publishes a partial manifest.
import "../lib/tts.tn"

fn normalize_manifest(input_path:str, output_path:str) -> int:
  unsafe:
    if strcmp(input_path, output_path) == 0: ret -1
    if io.file_exists(output_path) != 0: ret -1
    temporary:str = tts._tts_join2(output_path, ".tmp")
    if temporary == 0: ret -1
    if io.file_exists(temporary) != 0:
      free(temporary)
      ret -1
    input:*char = fopen(input_path, "rb")
    if input == 0:
      free(temporary)
      ret -1
    if fseek(input, 0, 2) != 0:
      fclose(input)
      free(temporary)
      ret -1
    input_size:int = ftell(input)
    if input_size < 0 || fseek(input, 0, 0) != 0:
      fclose(input)
      free(temporary)
      ret -1
    output:*char = fopen(temporary, "wb")
    if output == 0:
      fclose(input)
      free(temporary)
      ret -1
    line:[char;16385]
    count:int = 0
    failed:int = 0
    finished:int = 0
    consumed:int = 0
    while finished == 0 && failed == 0:
      length:int = 0
      while 1:
        value:char = 0 as char
        if fread(&value, 1, 1, input) != 1:
          finished = 1
          if consumed != input_size: failed = 1
          break
        consumed = consumed + 1
        if value == 10 as char: break
        if value == 0 as char || length >= 16384:
          failed = 1
          break
        line[length] = value
        length = length + 1
      if failed != 0: break
      if length == 0 && finished != 0: break
      if length > 0 && line[length - 1] == 13 as char: length = length - 1
      line[length] = 0 as char
      separator:int = 0
      while separator < length && line[separator] != 9 as char:
        separator = separator + 1
      if separator == 0 || separator + 1 >= length:
        failed = 1
        break
      i:int = separator + 1
      while i < length:
        if line[i] == 9 as char:
          failed = 1
          break
        i = i + 1
      if failed != 0: break
      text:str = ((&line[0]) + separator + 1) as str
      canonical:str = tts.tts_normalize_text(text)
      if canonical == 0:
        failed = 1
        break
      size:int = len(canonical)
      if size == 0:
        failed = 1
      else if fwrite(&line[0], 1, separator + 1, output) != separator + 1:
        failed = 1
      else if fwrite(canonical as *char, 1, size, output) != size:
        failed = 1
      else if fwrite("\n" as *char, 1, 1, output) != 1:
        failed = 1
      free(canonical)
      if failed == 0: count = count + 1
    if fclose(input) != 0: failed = 1
    if fclose(output) != 0: failed = 1
    if count == 0: failed = 1
    if failed == 0:
      if io.file_rename(temporary, output_path) != 0: failed = 1
    if failed != 0: io.file_delete(temporary)
    free(temporary)
    if failed != 0:
      say "TTS_NORMALIZE_ERROR", count + 1
      ret -1
    say "TTS_NORMALIZED_ITEMS", count
    ret 0

fn main() -> int:
  if args_count() != 2: ret 2
  if normalize_manifest(arg(0), arg(1)) != 0: ret 1
  ret 0
