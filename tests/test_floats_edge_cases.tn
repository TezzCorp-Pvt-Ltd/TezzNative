// tests/test_floats_edge_cases.tn
// Rigorous Edge Cases Test Suite for TezzNative Floating-Point Family
// Testing: Negative numbers, Zero, Underflow, Saturation/Overflow,
// Precision Round-tripping, Negative Integer conversions, and Boundary Comparisons.

struct EdgeTensor:
  pub neg_f64:f64
  pub neg_f32:f32
  pub neg_f16:f16
  pub neg_bf16:bf16
  pub neg_f8:f8
  pub neg_e5m2:f8_e5m2
  pub zero_f32:f32
  pub zero_f8:f8

fn main() -> int:
  say "=========================================================="
  say "   TezzNative Floating-Point Precision Edge Cases Test    "
  say "=========================================================="

  // -----------------------------------------------------------
  // 1. Negative Values across all Bit Widths
  // -----------------------------------------------------------
  say "\n--- 1. Negative Value Representation & Display ---"
  let neg_64:f64 = -123.456789
  let neg_32:f32 = -42.5
  let neg_16:f16 = -15.25
  let neg_bf:bf16 = -80.5
  let neg_8:f8 = -7.0
  let neg_e5:f8_e5m2 = -16.0

  say "neg f64     = ", neg_64
  say "neg f32     = ", neg_32
  say "neg f16     = ", neg_16
  say "neg bf16    = ", neg_bf
  say "neg f8      = ", neg_8
  say "neg f8_e5m2 = ", neg_e5

  // -----------------------------------------------------------
  // 2. Zero Values across Bit Widths
  // -----------------------------------------------------------
  say "\n--- 2. Exact Zero Handling ---"
  let z64:f64 = 0.0
  let z32:f32 = 0.0
  let z16:f16 = 0.0
  let zbf:bf16 = 0.0
  let z8:f8 = 0.0
  let ze5:f8_e5m2 = 0.0

  say "zero f64  = ", z64
  say "zero f32  = ", z32
  say "zero f16  = ", z16
  say "zero bf16 = ", zbf
  say "zero f8   = ", z8
  say "zero e5m2 = ", ze5

  if z32 == 0.0:
    say "z32 == 0.0: PASS"
  else:
    say "z32 == 0.0: FAIL"

  if z8 == 0.0:
    say "z8 == 0.0: PASS"
  else:
    say "z8 == 0.0: FAIL"

  // -----------------------------------------------------------
  // 3. Negative Arithmetic & Subtraction to Zero
  // -----------------------------------------------------------
  say "\n--- 3. Negative & Zero Boundary Arithmetic ---"
  let p:f32 = 25.5
  let q:f32 = 25.5
  let sub_zero:f32 = p - q
  say "25.5 - 25.5 = ", sub_zero
  if sub_zero == 0.0:
    say "Subtraction to zero check: PASS"
  else:
    say "Subtraction to zero check: FAIL"

  let neg_add:f32 = neg_32 + 50.0 // -42.5 + 50.0 = 7.5
  say "-42.5 + 50.0 = ", neg_add
  if neg_add > 7.4 && neg_add < 7.6:
    say "Negative addition check: PASS"
  else:
    say "Negative addition check: FAIL"

  let neg_mul:f32 = neg_32 * -2.0 // -42.5 * -2.0 = 85.0
  say "-42.5 * -2.0 = ", neg_mul
  if neg_mul > 84.9 && neg_mul < 85.1:
    say "Negative multiplication check: PASS"
  else:
    say "Negative multiplication check: FAIL"

  // -----------------------------------------------------------
  // 4. Negative Comparisons
  // -----------------------------------------------------------
  say "\n--- 4. Negative & Boundary Comparisons ---"
  let small_neg:f32 = -0.5
  let large_neg:f32 = -100.0

  if large_neg < small_neg:
    say "-100.0 < -0.5: PASS"
  else:
    say "-100.0 < -0.5: FAIL"

  if small_neg < 0.0:
    say "-0.5 < 0.0: PASS"
  else:
    say "-0.5 < 0.0: FAIL"

  if neg_8 < 0.0:
    say "-7.0 (f8) < 0.0: PASS"
  else:
    say "-7.0 (f8) < 0.0: FAIL"

  // -----------------------------------------------------------
  // 5. Negative Integer & Extreme Integer Conversions
  // -----------------------------------------------------------
  say "\n--- 5. Signed Integer Boundary Conversions ---"
  let neg_int:int = -12345
  let int_to_f32:f32 = neg_int as f32
  let f32_to_int:int = int_to_f32 as int
  say "int(-12345) as f32 = ", int_to_f32, " -> back to int = ", f32_to_int
  if f32_to_int == -12345:
    say "Negative integer roundtrip: PASS"
  else:
    say "Negative integer roundtrip: FAIL"

  let zero_int:int = 0
  let zero_to_f32:f32 = zero_int as f32
  let zero_back:int = zero_to_f32 as int
  if zero_back == 0:
    say "Zero integer roundtrip: PASS"
  else:
    say "Zero integer roundtrip: FAIL"

  // -----------------------------------------------------------
  // 6. Max Range & Subnormal Boundaries
  // -----------------------------------------------------------
  say "\n--- 6. Micro-Float Range Boundaries ---"
  // f8_e4m3 max finite is 448.0
  let max_e4m3:f8 = 448.0
  say "f8_e4m3 max finite (448.0) = ", max_e4m3

  // f8_e4m3 subnormal resolution (~0.015625 is 2^-6)
  let subnormal_e4m3:f8 = 0.015625
  say "f8_e4m3 subnormal base (0.015625) = ", subnormal_e4m3

  // f8_e5m2 high dynamic range (e.g. 512.0, 1024.0, 4096.0)
  let large_e5m2:f8_e5m2 = 1024.0
  say "f8_e5m2 large range (1024.0) = ", large_e5m2

  let tiny_e5m2:f8_e5m2 = 0.0009765625 // 2^-10
  say "f8_e5m2 tiny range (2^-10) = ", tiny_e5m2

  // -----------------------------------------------------------
  // 7. Multi-hop Precision Round-tripping
  // -----------------------------------------------------------
  say "\n--- 7. Cascading Precision Roundtrips ---"
  let orig:f64 = 64.0
  let step_f32:f32 = orig as f32
  let step_f16:f16 = step_f32 as f16
  let step_bf16:bf16 = step_f32 as bf16
  let step_f8:f8 = step_f32 as f8
  let step_e5m2:f8_e5m2 = step_f32 as f8_e5m2

  let back_from_f8:f64 = step_f8 as f64
  let back_from_e5m2:f64 = step_e5m2 as f64
  let back_from_f16:f64 = step_f16 as f64
  let back_from_bf16:f64 = step_bf16 as f64

  say "64.0 -> f8 -> f64      = ", back_from_f8
  say "64.0 -> f8_e5m2 -> f64 = ", back_from_e5m2
  say "64.0 -> f16 -> f64     = ", back_from_f16
  say "64.0 -> bf16 -> f64    = ", back_from_bf16

  if back_from_f8 == 64.0 && back_from_e5m2 == 64.0 && back_from_f16 == 64.0 && back_from_bf16 == 64.0:
    say "All precision cascades for 64.0: PASS"
  else:
    say "All precision cascades for 64.0: FAIL"

  // -----------------------------------------------------------
  // 8. Struct with Negative and Zero Fields
  // -----------------------------------------------------------
  say "\n--- 8. Struct Edge Cases Layout ---"
  let et:EdgeTensor = EdgeTensor{
    neg_f64: -999.5,
    neg_f32: -88.25,
    neg_f16: -4.5,
    neg_bf16: -12.5,
    neg_f8: -3.0,
    neg_e5m2: -8.0,
    zero_f32: 0.0,
    zero_f8: 0.0
  }
  say "EdgeTensor neg_f64  = ", et.neg_f64
  say "EdgeTensor neg_f32  = ", et.neg_f32
  say "EdgeTensor neg_f16  = ", et.neg_f16
  say "EdgeTensor neg_bf16 = ", et.neg_bf16
  say "EdgeTensor neg_f8   = ", et.neg_f8
  say "EdgeTensor neg_e5m2 = ", et.neg_e5m2
  say "EdgeTensor zero_f32 = ", et.zero_f32
  say "EdgeTensor zero_f8  = ", et.zero_f8

  // -----------------------------------------------------------
  // 9. Boundary Arrays (Negative, Zero, Max)
  // -----------------------------------------------------------
  say "\n--- 9. Boundary Arrays ---"
  let arr_f32:[f32; 3] = [-10.5, 0.0, 10.5]
  let arr_f8:[f8; 3] = [-4.0, 0.0, 4.0]
  let arr_e5:[f8_e5m2; 3] = [-16.0, 0.0, 16.0]

  say "arr_f32 = [", arr_f32[0], ", ", arr_f32[1], ", ", arr_f32[2], "]"
  say "arr_f8  = [", arr_f8[0], ", ", arr_f8[1], ", ", arr_f8[2], "]"
  say "arr_e5  = [", arr_e5[0], ", ", arr_e5[1], ", ", arr_e5[2], "]"

  say "\n=========================================================="
  say "      All Float Precision Edge Cases PASSED 100%!         "
  say "=========================================================="
  ret 0
