import "ml"

fn main() -> int:
  unsafe:
    tok:*Tokenizer = ml.tok_new()
    if tok == 0 || ml.tok_size(tok) != 256: ret 1
    ids:[int;8]
    if ml.tok_encode(tok, "hello", &ids[0], 8) != 5: ret 2
    text:str = ml.tok_decode(tok, &ids[0], 5)
    if text == 0 || strcmp(text, "hello") != 0: ret 3
    free(text as *char)
    ids[0] = 1234
    if ml.tok_encode(tok, "hello", &ids[0], 4) >= 0 || ids[0] != 1234: ret 4
    if ml.tok_fit_text(tok, "hello") == 0 || ml.tok_save(tok, "unsupported.tnxb") == 0: ret 5
    ml.tok_free(tok)
  ret 0

