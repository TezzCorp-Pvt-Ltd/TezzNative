import "ml"
import "tensor"
import "tensor_gpu"
import "tzgpu"

fn main() -> int:
  shape:[int;1] = [2]
  unsafe:
    if ml.backend_cpu() != 0 || ml.backend_gpu() == 0 || ml.backend_npu() == 0: ret 1
    invalid:*Tensor = ml.tensor_new_dtype(&shape[0], 1, tensor.tensor_dtype_f32(), 0)
    if invalid != 0: ret 2
    a:*Tensor = ml.tensor_new(&shape[0], 1, 0)
    b:*Tensor = ml.tensor_new(&shape[0], 1, 0)
    if a == 0 || b == 0: ret 3
    a.data[0] = 2.0
    a.data[1] = 3.0
    b.data[0] = 4.0
    b.data[1] = 5.0
    added:*Tensor = tensor_gpu.add(a, b)
    product:*Tensor = tensor_gpu.mul(a, b)
    if tzgpu.tz_cuda_device_count() <= 0:
      if added != 0 || product != 0: ret 4
    else:
      if added == 0 || product == 0: ret 5
      if added.data[0] != 6.0 || added.data[1] != 8.0 || product.data[0] != 8.0 || product.data[1] != 15.0: ret 6
    ml.tensor_free(added)
    ml.tensor_free(product)
    ml.tensor_free(a)
    ml.tensor_free(b)
  ret 0

