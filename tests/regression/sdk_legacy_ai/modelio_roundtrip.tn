import "modelio"
import "tensor"

fn main() -> int:
  unsafe:
    model:*DenseModel = modelio.dense_new(2, 2, "dense-test")
    if model == 0: ret 1
    model.w.data[0] = 1.0
    model.w.data[1] = 2.0
    model.w.data[2] = 3.0
    model.w.data[3] = 4.0
    model.b.data[0] = 0.5
    model.b.data[1] = 0.0 - 0.5
    input:Tensor = tensor.tensor_zeros_2d(1, 2)
    tensor.tensor_set2(input, 0, 0, 5.0)
    tensor.tensor_set2(input, 0, 1, 6.0)
    out:*Tensor = modelio.dense_forward(model, &input)
    if out == 0: ret 2
    failed:int = 0
    if out.data[0] != 23.5 || out.data[1] != 33.5: failed = 1
    if modelio.dense_save(model, "dense-test.tnxb") != 0: failed = 1
    copy:*DenseModel = modelio.dense_load("dense-test.tnxb")
    if copy == 0: ret 3
    again:*Tensor = modelio.dense_forward(copy, &input)
    if again == 0: ret 4
    if again.data[0] != 23.5 || again.data[1] != 33.5: failed = 1
    if modelio.tensor_save_tnxb(&input, "tensor-test.tnxb") != 0: failed = 1
    loaded:*Tensor = modelio.tensor_load_tnxb("tensor-test.tnxb")
    if loaded == 0: ret 5
    if loaded.dtype != tensor.tensor_dtype_f64() || loaded.ndim != 2 || loaded.shape0 != 1 || loaded.shape1 != 2 || loaded.data[1] != 6.0: failed = 1
    tensor.tape_reset()
    tensor.tensor_free_tensor(*loaded)
    free(loaded as *char)
    tensor.tensor_free_tensor(*again)
    free(again as *char)
    tensor.tensor_free_tensor(*out)
    free(out as *char)
    tensor.tensor_free_tensor(input)
    modelio.dense_free(copy)
    modelio.dense_free(model)
    if failed != 0: say "FAIL: dense/tensor serialization must preserve shapes, f64 values, and ownership"
    ret failed
