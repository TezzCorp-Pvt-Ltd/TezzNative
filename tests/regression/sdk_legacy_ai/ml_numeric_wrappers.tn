import "ml"
import "math"

fn main() -> int:
  unsafe:
    logits:[float;2] = [0.0, 0.0 - 40.0]
    if ml.llm_softmax_rows_f32_inplace_nn(&logits[0], 1, 2) != 0: ret 1
    silu:[float;1] = [1.0]
    if ml.f32_silu_inplace_nn(&silu[0], 1) != 0: ret 2
    input:[float;1] = [1.0e10]
    norm:[float;1]
    if ml.llm_rmsnorm_rows_f32_nn(&norm[0], &input[0], 0 as *float, 1, 1, 0.00001) != 0: ret 3
    expected:float = 1.0 / (1.0 + math.exp(0.0 - 1.0))
    if math.absf(logits[0] - 1.0) > 0.000001 || logits[1] < 0.0 || math.absf(silu[0] - expected) > 0.000001 || math.absf(norm[0] - 1.0) > 0.000001:
      say "FAIL: ML delegated softmax/SiLU/RMS ", logits[0], ", ", silu[0], ", ", norm[0]
      ret 4
  ret 0
