import "ml"
import "tensor"
import "tensor_ptr"

fn main() -> int:
  shape:[int;2] = [2, 2]
  values:[float;4] = [1.0, 2.0, 3.0, 4.0]
  vshape:[int;1] = [2]
  strides:[int;1] = [2]
  unsafe:
    x:*Tensor = ml.tensor_from_slice(&values[0], &shape[0], 2, 1)
    if x == 0: ret 1
    view:*Tensor = ml.tensor_view(x, &vshape[0], &strides[0], 1, 1)
    if view == 0 || tensor_ptr.get_f(view, 0) != 2.0 || tensor_ptr.get_f(view, 1) != 4.0: ret 2
    loss:*Tensor = ml.sum(view)
    if loss == 0 || ml.backward(loss) != 0: ret 3
    if ml.tensor_grad_get_f(x, 0) != 0.0 || ml.tensor_grad_get_f(x, 1) != 1.0 || ml.tensor_grad_get_f(x, 2) != 0.0 || ml.tensor_grad_get_f(x, 3) != 1.0: ret 4
    if ml.sgd_step(x, 0.5) != 0: ret 5
    if tensor_ptr.get_f(x, 1) != 1.5 || tensor_ptr.get_f(x, 3) != 3.5: ret 6
    tensor.tape_reset()
    ml.tensor_free(loss)
    ml.tensor_free(view)
    ml.tensor_free(x)
  ret 0

