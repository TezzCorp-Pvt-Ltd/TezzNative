import "nn"
import "math"

fn main() -> int:
  logits:[float;2] = [0.0, -1000.0]
  gradient:[float;2]
  unsafe:
    loss:float = nn.nn_cross_entropy(&logits[0], 1, &gradient[0], 2)
    if math.absf(loss - 1000.0) > 1.0e-12:
      say "FAIL log-space loss for rare target", loss
      ret 1
    if gradient[0] != 1.0 || gradient[1] != -1.0:
      say "FAIL cross entropy gradient"
      ret 1
    loss = nn.nn_cross_entropy(&logits[0], 1, &logits[0], 2)
    if loss != 1000.0 || logits[0] != 1.0 || logits[1] != -1.0:
      say "FAIL aliased gradient buffer"
      ret 1
  ret 0
