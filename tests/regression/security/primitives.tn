import "tezzdb.auth"

fn main() -> int:
  record:str = tezzdb.auth.password_hash("regression password")
  if record == 0:
    ret 1
  if tezzdb.auth.password_verify("regression password", record) != 1:
    ret 2
  if tezzdb.auth.password_verify("wrong", record) != 0:
    ret 3
  if tezzdb.auth.password_verify("regression password", "legacy-fnv-hash") != 0:
    ret 4
  first:str = tezzdb.auth.random_token()
  second:str = tezzdb.auth.random_token()
  if first == 0 || second == 0 || len(first) != 64 || len(second) != 64:
    ret 5
  if strcmp(first, second) == 0:
    ret 6
  hashed:str = tezzdb.auth.token_hash(first)
  if hashed == 0 || len(hashed) != 64 || strcmp(hashed, first) == 0:
    ret 7
  if tezzdb.auth.token_hash("not-a-token") != 0:
    ret 8
  unsafe:
    free(record)
    free(first)
    free(second)
    free(hashed)
  ret 0
