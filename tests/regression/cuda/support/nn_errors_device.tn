import "tznn"
import "tzgpu"
import "tzcpu"

fn pointer_error(value:int, owned:int, id:int) -> int:
  if value == 0: ret 0
  say "FAIL: NN accepted invalid input", id
  if owned != 0: tzgpu.gpu_free(value)
  ret 1

fn status_error(value:int, id:int) -> int:
  if value < 0: ret 0
  say "FAIL: NN dropped error status", id
  ret 1

fn main() -> int:
  if tzgpu.tz_cuda_device_count() <= 0: ret 99
  p:int = tzgpu.gpu_ones_f32(4)
  z:int = tzgpu.gpu_zeros_f32(9)
  failed:int = 0
  failed = failed + pointer_error(tznn.nn_relu_fwd(0, 4), 1, 1)
  failed = failed + pointer_error(tznn.nn_gelu_fwd(0, 4), 1, 2)
  failed = failed + pointer_error(tznn.nn_sigmoid_fwd(0, 4), 1, 3)
  failed = failed + pointer_error(tznn.nn_tanh_fwd(0, 4), 1, 4)
  failed = failed + pointer_error(tznn.nn_relu_inplace(p, 5), 0, 5)
  failed = failed + pointer_error(tznn.nn_gelu_inplace(p, 5), 0, 6)
  failed = failed + pointer_error(tznn.nn_softmax(p, 2, 3), 0, 7)
  failed = failed + pointer_error(tznn.nn_layernorm(p, 2, 3), 0, 8)
  failed = failed + pointer_error(tznn.nn_dropout(p, z, 4, 1.0, 1), 0, 9)
  failed = failed + pointer_error(tznn.nn_cross_entropy(p, 0, 2, 2), 1, 10)
  failed = failed + pointer_error(tznn.nn_mse(p, 0, 4), 1, 11)
  failed = failed + pointer_error(tznn.nn_embedding_fwd(0, p, 2, 2), 1, 12)
  failed = failed + pointer_error(tznn.nn_relu_bwd_wrap(0, p, z, 4), 0, 13)
  failed = failed + status_error(tznn.nn_adam_step(p, 0, z, z, 4, 0.1, 0.9, 0.999), 14)
  failed = failed + status_error(tznn.nn_sgd_step(p, 0, z, 4, 0.1, 0.9), 15)
  failed = failed + status_error(tznn.nn_dense_bwd_db(0, z, 2, 2), 16)
  failed = failed + status_error(tznn.nn_dense_bwd_dX(0, p, z, 2, 2, 2), 17)
  failed = failed + status_error(tznn.nn_xavier_init(z, 4, 0, 1), 18)
  failed = failed + pointer_error(tznn.nn_transformer_fwd(p, z, z, z, z, z, z, 0, 0, 1, 3, 3, 0), 1, 19)
  // A zero-weight pre-norm transformer must retain the original residual.
  host:int = tzcpu.tz_cpu_zeros(2)
  unsafe:
    values:*f32 = host as *f32
    values[0] = 2.0 as f32
    values[1] = 4.0 as f32
  x:int = tzgpu.gpu_upload_f32(host, 2)
  out:int = tznn.nn_transformer_fwd(x, z, z, z, z, z, z, 0, 0, 1, 2, 2, 0)
  if out == 0:
    failed = failed + 1
  else:
    tzgpu.gpu_download_f32(out, host, 2)
    unsafe:
      values:*f32 = host as *f32
      if values[0] != 2.0 as f32 || values[1] != 4.0 as f32:
        say "FAIL: transformer residual was overwritten"
        failed = failed + 1
    tzgpu.gpu_free(out)
  tzgpu.gpu_download_f32(x, host, 2)
  unsafe:
    values:*f32 = host as *f32
    if values[0] != 2.0 as f32 || values[1] != 4.0 as f32:
      say "FAIL: transformer mutated input"
      failed = failed + 1
  tzgpu.gpu_free(x)
  tzcpu.tz_cpu_free(host)
  failed = failed + status_error(tznn.nn_dense_free(p + 1, 0), 20)
  tzgpu.gpu_free(p)
  tzgpu.gpu_free(z)
  ret failed
