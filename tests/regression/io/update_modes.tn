fn main() -> int:
  unsafe:
    file:*char = fopen("update_modes.bin", "w+b")
    if file == 0: ret 1
    data:str = "abcd"
    if fwrite(data as *char, 2, 2, file) != 4: ret 2
    if fseek(file, 0, 0) != 0: ret 3
    buffer:[char;5]
    if fread(&buffer[0], 2, 2, file) != 4: ret 4
    buffer[4] = 0 as char
    if strcmp((&buffer[0]) as str, "abcd") != 0: ret 5
    if ftell(file) != 4 || fclose(file) != 0: ret 6
    file = fopen("update_modes.bin", "r+b")
    if file == 0: ret 7
    if fwrite("X" as *char, 1, 1, file) != 1: ret 8
    if fseek(file, 0, 0) != 0 || fread(&buffer[0], 1, 4, file) != 4: ret 9
    if strcmp((&buffer[0]) as str, "Xbcd") != 0: ret 10
    if fclose(file) != 0: ret 11
    file = fopen("update_modes.bin", "a+b")
    if file == 0: ret 12
    if fseek(file, 0, 0) != 0 || fread(&buffer[0], 1, 4, file) != 4: ret 13
    if fseek(file, 0, 1) != 0: ret 18
    if fwrite("Y" as *char, 1, 1, file) != 1: ret 14
    if fseek(file, 0, 2) != 0 || ftell(file) != 5: ret 15
    if fclose(file) != 0: ret 16
    if fseek(0 as *char, 0, 0) != -1 || ftell(0 as *char) != -1: ret 17
    ret 0
