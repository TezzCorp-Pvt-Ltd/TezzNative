import "tls"

fn main() -> int:
  if tls.policy_reset() != 0: ret 1
  if tls.policy_get_min() != 0: ret 2
  if tls.policy_set_min(12) != 0: ret 3
  if tls.policy_set_min(11) != -1: ret 4
  if tls.policy_get_min() != 12: ret 5
  if tls.policy_set_handshake_timeout(200) != 0: ret 6
  if tls.policy_set_handshake_timeout(-1) != -1: ret 7
  if tls.policy_get_handshake_timeout() != 200: ret 8
  if tls.policy_set_pin_sha256("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") != 0: ret 9
  if tls.policy_pin_enabled() != 1: ret 10
  if tls.policy_set_pin_sha256("invalid") != -1: ret 11
  if tls.policy_pin_enabled() != 1: ret 12
  if tls.policy_set_pin_sha256("") != 0: ret 13
  if tls.policy_pin_enabled() != 0: ret 14
  if tls.policy_reset() != 0: ret 15
  ret 0
