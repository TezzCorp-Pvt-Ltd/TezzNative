import "math"

fn close(actual:float, expected:float, tolerance:float) -> int:
  if actual != actual:
    ret 0
  if math.absf(actual - expected) > tolerance:
    ret 0
  ret 1

fn main() -> int:
  failures:int = 0
  if close(math.exp(-20.0) / 2.061153622438558e-9, 1.0, 1.0e-12) == 0:
    say "FAIL exp(-20)"
    failures = failures + 1
  if close(math.exp(20.0) / 485165195.4097903, 1.0, 1.0e-12) == 0:
    say "FAIL exp(20)"
    failures = failures + 1
  if close(math.exp(-700.0) / 9.85967654375977e-305, 1.0, 1.0e-12) == 0:
    say "FAIL exp(-700)"
    failures = failures + 1
  if close(math.exp(700.0) / 1.0142320547350045e304, 1.0, 1.0e-12) == 0:
    say "FAIL exp(700)"
    failures = failures + 1
  if close(math.exp(-740.0) / 4.2e-322, 1.0, 0.02) == 0:
    say "FAIL exp subnormal"
    failures = failures + 1
  if close(math.sqrt(1.0e40) / 1.0e20, 1.0, 1.0e-14) == 0:
    say "FAIL sqrt large"
    failures = failures + 1
  if close(math.sqrt(1.0e-40) / 1.0e-20, 1.0, 1.0e-14) == 0:
    say "FAIL sqrt small"
    failures = failures + 1
  if close(math.sqrt(1.0e300) / 1.0e150, 1.0, 1.0e-14) == 0:
    say "FAIL sqrt very large"
    failures = failures + 1
  if close(math.sqrt(1.0e-300) / 1.0e-150, 1.0, 1.0e-14) == 0:
    say "FAIL sqrt very small"
    failures = failures + 1
  if close(math.pow(2.0, -40.0) / 9.094947017729282e-13, 1.0, 1.0e-12) == 0:
    say "FAIL negative power"
    failures = failures + 1
  if close(math.pow(-2.0, 3.0), -8.0, 1.0e-12) == 0:
    say "FAIL signed integer power"
    failures = failures + 1
  if close(math.log(1.4), 0.3364722366212129, 1.0e-13) == 0:
    say "FAIL logarithm accuracy"
    failures = failures + 1
  if close(math.atan(1.0), 0.7853981633974483, 1.0e-13) == 0:
    say "FAIL atan accuracy"
    failures = failures + 1
  if math.floor(1.0e30) != 1.0e30 || math.ceil(-1.0e30) != -1.0e30 || math.trunc(1.0e30) != 1.0e30:
    say "FAIL large integral rounding"
    failures = failures + 1
  if math.sqrt(0.0) != 0.0 || math.exp(0.0) != 1.0 || math.log(1.0) != 0.0:
    say "FAIL identity values"
    failures = failures + 1
  say "ASSERTION_FAILURES", failures
  ret failures
