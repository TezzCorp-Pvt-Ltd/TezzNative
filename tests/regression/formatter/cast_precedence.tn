fn main() -> int:
  unsafe:
    header:[int;2] = [65, 66]
    bytes:*char = (&header[0]) as *char
    pointer:*int = bytes as *int
    if pointer[0] != 65 || pointer[1] != 66: ret 1
    text:[char;3] = [65 as char, 66 as char, 0 as char]
    message:str = (&text[0]) as str
    if strcmp(message, "AB") != 0: ret 2
    value:float = (*pointer) as float
    if value != 65.0: ret 3
    narrowed:u8 = (-1) as u8
    if narrowed != 255: ret 4
    negative:int = -(1 as u8)
    if negative != -1: ret 5
    ret 0
