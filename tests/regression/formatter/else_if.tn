fn choose(value:int) -> int:
  if value == 0: ret 11
  else if value == 1: ret 22
  else if value == 2:
    if value < 0: ret 99
    else if value > 1: ret 33
    else: ret 98
  else: ret 44

fn main() -> int:
  if choose(0) != 11: ret 1
  if choose(1) != 22: ret 2
  if choose(2) != 33: ret 3
  if choose(3) != 44: ret 4
  ret 0
