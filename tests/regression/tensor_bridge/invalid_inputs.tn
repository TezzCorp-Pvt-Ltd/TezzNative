import "tensor_bridge"
import "tensor"
import "tztensor"

fn main() -> int:
  empty:Tensor = tensor.tensor_empty_raw(0, 0, 0, 0, 0)
  if tensor_bridge.to_tztensor(empty) != 0: ret 1
