import "tensor"

fn main() -> int:
  x:Tensor = tensor.tensor_1d(4)
  tensor.tensor_set1(x, 0, 0.0)
  tensor.tensor_set1(x, 1, 1.0)
  tensor.tensor_set1(x, 2, 2.0)
  tensor.tensor_set1(x, 3, 3.0)
  view:Tensor = tensor.tensor_slice(x, 0, 1, 3, 1)
  tensor.tensor_fill(view, 9.0)
  failed:int = 0
  if tensor.tensor_get1(x, 0) != 0.0 || tensor.tensor_get1(x, 1) != 9.0 || tensor.tensor_get1(x, 2) != 9.0 || tensor.tensor_get1(x, 3) != 3.0:
    failed = 1
    say "FAIL: fill must respect a sliced view's offset and strides"
  tensor.tensor_free_tensor(view)
  tensor.tensor_free_tensor(x)
  ret failed
