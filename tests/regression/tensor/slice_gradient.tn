import "tensor"

fn main() -> int:
  tensor.tape_init()
  x:Tensor = tensor.tensor_ones_1d(4)
  x = tensor.tensor_require_grad(x)
  view:Tensor = tensor.tensor_slice(x, 0, 1, 3, 1)
  scaled:Tensor = tensor.tensor_scale(view, 2.0)
  loss:Tensor = tensor.tensor_sum_all_t(scaled)
  tensor.tensor_backward(loss)
  failed:int = 0
  if tensor.tensor_grad_item(x, 0) != 0.0 || tensor.tensor_grad_item(x, 1) != 2.0 || tensor.tensor_grad_item(x, 2) != 2.0 || tensor.tensor_grad_item(x, 3) != 0.0:
    failed = 1
    say "FAIL: slice gradients must scatter into the selected source elements"
  tensor.tape_reset()
  tensor.tensor_free_tensor(loss)
  tensor.tensor_free_tensor(scaled)
  tensor.tensor_free_tensor(view)
  tensor.tensor_free_tensor(x)
  ret failed
