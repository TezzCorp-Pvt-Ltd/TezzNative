import "tensor"

fn main() -> int:
  tensor.tape_init()
  x:Tensor = tensor.tensor_ones_2d(2, 3)
  x = tensor.tensor_require_grad(x)
  transposed:Tensor = tensor.tensor_t(x)
  reshaped:Tensor = tensor.tensor_reshape_1d(transposed, 6)
  weights:Tensor = tensor.tensor_1d(6)
  i:int = 0
  while i < 6:
    tensor.tensor_set1(weights, i, (i + 1) as float)
    i = i + 1
  weighted:Tensor = tensor.tensor_mul(reshaped, weights)
  loss:Tensor = tensor.tensor_sum_all_t(weighted)
  tensor.tensor_backward(loss)
  failed:int = 0
  if tensor.tensor_grad_item(x, 0) != 1.0 || tensor.tensor_grad_item(x, 1) != 3.0 || tensor.tensor_grad_item(x, 2) != 5.0 || tensor.tensor_grad_item(x, 3) != 2.0 || tensor.tensor_grad_item(x, 4) != 4.0 || tensor.tensor_grad_item(x, 5) != 6.0:
    failed = 1
  tensor.tensor_set1(reshaped, 0, 9.0)
  if tensor.tensor_get2(x, 0, 0) != 1.0 || reshaped.is_view != 0:
    failed = 1
  tensor.tape_reset()
  tensor.tensor_free_tensor(loss)
  tensor.tensor_free_tensor(weighted)
  tensor.tensor_free_tensor(weights)
  tensor.tensor_free_tensor(reshaped)
  tensor.tensor_free_tensor(transposed)
  tensor.tensor_free_tensor(x)
  if failed != 0:
    say "FAIL: non-contiguous reshape must own its copy and preserve gradients"
  ret failed
