import "tensor"

fn main() -> int:
  a:Tensor = tensor.tensor_ones_2d(2, 3)
  b:Tensor = tensor.tensor_ones_2d(2, 2)
  bad_matmul:Tensor = tensor.tensor_matmul(a, b)
  bad_add:Tensor = tensor.tensor_add(a, b)
  bad_axis:Tensor = tensor.tensor_sum(a, 3, 0)
  failed:int = 0
  if bad_matmul.size != 0 || bad_add.size != 0 || bad_axis.size != 0:
    failed = 1
  tensor.tensor_free_tensor(bad_axis)
  tensor.tensor_free_tensor(bad_add)
  tensor.tensor_free_tensor(bad_matmul)
  tensor.tensor_free_tensor(b)
  tensor.tensor_free_tensor(a)
  if failed != 0:
    say "FAIL: invalid matrix, broadcast, and reduction shapes must return empty tensors"
  ret failed
