import "tensor"
import "math"

fn main() -> int:
  tensor.tape_init()
  x:Tensor = tensor.tensor_zeros_2d(1, 2)
  x = tensor.tensor_require_grad(x)
  y:Tensor = tensor.tensor_softmax(x, 1)
  weights:Tensor = tensor.tensor_zeros_2d(1, 2)
  tensor.tensor_set2(weights, 0, 0, 1.0)
  weighted:Tensor = tensor.tensor_mul(y, weights)
  loss:Tensor = tensor.tensor_sum_all_t(weighted)
  tensor.tensor_backward(loss)
  g0:float = tensor.tensor_grad_item(x, 0)
  g1:float = tensor.tensor_grad_item(x, 1)
  tensor.tape_reset()
  tensor.tensor_free_tensor(loss)
  tensor.tensor_free_tensor(weighted)
  tensor.tensor_free_tensor(weights)
  tensor.tensor_free_tensor(y)
  tensor.tensor_free_tensor(x)
  if math.absf(g0 - 0.25) > 0.000001 || math.absf(g1 + 0.25) > 0.000001:
    say "FAIL: softmax gradient; got ", g0, ", ", g1
    ret 1
  ret 0
