import "tensor"

fn main() -> int:
  source:Tensor = tensor.tensor_ones_1d(2)
  copied:Tensor = tensor.tensor_contiguous(source)
  tensor.tensor_set1(copied, 0, 9.0)
  failed:int = 0
  if tensor.tensor_get1(source, 0) != 1.0:
    failed = 1
  tensor.tensor_free_tensor(copied)
  tensor.tensor_free_tensor(source)
  if failed != 0:
    say "FAIL: contiguous copies must have independent ownership"
  ret failed
