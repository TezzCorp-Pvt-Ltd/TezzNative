import "tensor"

fn main() -> int:
  tensor.tape_init()
  x:Tensor = tensor.tensor_ones_2d(2, 3)
  x = tensor.tensor_require_grad(x)
  transposed:Tensor = tensor.tensor_t(x)
  sliced:Tensor = tensor.tensor_slice(transposed, 0, 1, 3, 1)
  scaled:Tensor = tensor.tensor_scale(sliced, 2.0)
  loss:Tensor = tensor.tensor_sum_all_t(scaled)
  tensor.tensor_backward(loss)
  failed:int = 0
  i:int = 0
  while i < 6:
    expected:float = 2.0
    if i % 3 == 0:
      expected = 0.0
    if tensor.tensor_grad_item(x, i) != expected:
      failed = 1
    i = i + 1
  tensor.tape_reset()
  tensor.tensor_free_tensor(loss)
  tensor.tensor_free_tensor(scaled)
  tensor.tensor_free_tensor(sliced)
  tensor.tensor_free_tensor(transposed)
  tensor.tensor_free_tensor(x)
  if failed != 0:
    say "FAIL: composed transpose and slice gradient mapping"
  ret failed
