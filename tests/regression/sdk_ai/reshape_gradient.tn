import "tztensor"
import "./support/lib/values.tn"

fn main() -> int:
  x:int = tztensor.tensor_new_2d(1, 2, 1)
  out:int = tztensor.tensor_reshape(x, 2, 1, 1, 1)
  status:int = tztensor.tensor_backward(out)
  failed:int = 0
  if status != 0 || values.gradient(x, 0) != 1.0 || values.gradient(x, 1) != 1.0:
    failed = 1
  tztensor.tensor_free(out)
  tztensor.tensor_free(x)
  if failed != 0: say "FAIL: SDK reshape must preserve gradient connectivity"
  ret failed
