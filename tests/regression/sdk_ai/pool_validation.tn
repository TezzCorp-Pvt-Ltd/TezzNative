import "tztensor"
import "./support/lib/values.tn"

fn main() -> int:
  x:int = tztensor.tensor_new_4d(1, 1, 2, 2, 1)
  out:int = tztensor.tensor_new_4d(1, 1, 1, 1, 0)
  mask:int = tztensor.tensor_new_4d(1, 1, 1, 1, 0)
  values.write(x, 0, 2.0)
  values.write(x, 1, 7.0)
  values.write(x, 2, 3.0)
  values.write(x, 3, 4.0)
  values.write(out, 0, 17.0)
  if tztensor.tensor_maxpool2d(x, out, mask, 2, 2, 0) >= 0: ret 1
  if tztensor.tensor_maxpool2d(x, out, mask, 3, 2, 2) >= 0: ret 2
  if tztensor.tensor_maxpool2d(x, out, mask, -1, 2, 1) >= 0: ret 3
  if tztensor.tensor_maxpool2d(x, out, mask, 1, 1, 1) >= 0: ret 4
  if tztensor.tensor_maxpool2d(x, out, out, 2, 2, 1) >= 0: ret 5
  if values.read(out, 0) != 17.0: ret 6
  if tztensor.tensor_maxpool2d(x, out, mask, 2, 2, 1) != 0: ret 7
  if values.read(out, 0) != 7.0: ret 8
  if tztensor.tensor_backward(out) != 0: ret 9
  if values.gradient(x, 0) != 0.0 || values.gradient(x, 1) != 1.0: ret 10
  if values.gradient(x, 2) != 0.0 || values.gradient(x, 3) != 0.0: ret 11
  tztensor.tensor_free(out)
  tztensor.tensor_free(mask)
  tztensor.tensor_free(x)
  ret 0
