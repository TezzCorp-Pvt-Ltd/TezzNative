import "tztensor"
import "tzautodiff"
import "./support/lib/values.tn"

fn main() -> int:
  x:int = tztensor.tensor_new_1d(2, 0)
  out:int = tztensor.tensor_new_1d(3, 0)
  values.write(x, 0, -2.0)
  values.write(x, 1, 3.0)
  values.write(out, 0, 17.0)
  values.write(out, 1, 19.0)
  values.write(out, 2, 23.0)
  code:int = tztensor.tensor_relu(x, out)
  if code >= 0 || values.read(out, 0) != 17.0 || values.read(out, 1) != 19.0 || values.read(out, 2) != 23.0:
    say "FAIL: mismatched output shape was accepted or written"
    ret 1
  if tztensor.tensor_gelu(x, out) >= 0:
    say "FAIL: GELU mismatched output shape was accepted"
    ret 2
  if tztensor.tensor_relu(0, out) >= 0 || tztensor.tensor_fill(0, 1.0 as f32) >= 0:
    say "FAIL: null tensor operation reported success"
    ret 3
  tztensor.tensor_free(x)
  tztensor.tensor_free(out)
  tzautodiff.autodiff_reset()
  ret 0
