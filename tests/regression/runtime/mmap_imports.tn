extern fn io_mmap_open(path:str, size:*int, handle:*int) -> *char
extern fn io_mmap_close(data:*char, size:int, handle:int) -> int

fn main() -> int:
  file:*char = fopen("native-map.bin", "wb")
  if file == 0: ret 1
  text:str = "map"
  unsafe:
    if fwrite(text as *char, 1, 3, file) != 3: ret 1
  if fclose(file) != 0: ret 1
  size:int = 0
  handle:int = 0
  unsafe:
    data:*char = io_mmap_open("native-map.bin", &size, &handle)
    if data == 0: ret 2
    if size != 3: ret 3
    if data[0] != 'm': ret 4
    if data[2] != 'p': ret 5
    io_mmap_close(data, size, handle)
  if remove("native-map.bin") != 0: ret 6
  ret 0
