fn main() -> int:
  unsafe:
    if strcmp("abc", "abc") != 0: ret 1
    if strcmp("", "a") >= 0: ret 2
    if strcmp("a", "") <= 0: ret 3
    if strcmp("ab", "abc") >= 0: ret 4
    if strcmp("abc", "ab") <= 0: ret 5
    if strcmp("abc", "abd") >= 0: ret 6
    if strcmp("abd", "abc") <= 0: ret 7
  ret 0
