extern fn io_pipe_create(read_fd:*int, write_fd:*int) -> int
extern fn io_fd_read(fd:int, buffer:*char, size:int) -> int
extern fn io_fd_write(fd:int, buffer:*char, size:int) -> int
extern fn io_fd_close(fd:int) -> int

fn main() -> int:
  reader:int = -1
  writer:int = -1
  unsafe:
    if io_pipe_create(&reader, &writer) != 0: ret 1
  text:str = "pipe"
  buffer:[char;4]
  unsafe:
    if io_fd_write(writer, text as *char, 4) != 4: ret 2
  if io_fd_close(writer) != 0: ret 3
  unsafe:
    if io_fd_read(reader, &buffer[0], 4) != 4: ret 4
  if io_fd_close(reader) != 0: ret 5
  if buffer[0] != 'p': ret 6
  if buffer[3] != 'e': ret 7
  ret 0
