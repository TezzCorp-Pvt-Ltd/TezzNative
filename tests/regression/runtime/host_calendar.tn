fn main() -> int:
  unsafe:
    local:str = date_now()
    utc:str = date_now_utc()
    if len(local) != 19: ret 1
    if len(utc) != 19: ret 2
    if utc[4] != '-' || utc[7] != '-': ret 3
    if utc[10] != ' ' || utc[13] != ':' || utc[16] != ':': ret 4
    free(local as *char)
    free(utc as *char)
  ret 0
