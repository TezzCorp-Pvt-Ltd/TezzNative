import "os"

fn exercise() -> int:
  unsafe:
    memory:*char = malloc(8192)
    if os.heap_init(memory, 8192) != 0: ret 1
    first:*char = os.heap_alloc(17)
    second:*char = os.heap_alloc(64)
    if first == 0 || second == 0: ret 2
    if os.heap_validate() != 1: ret 3
    if os.heap_free(first) != 0: ret 4
    if os.heap_free(second) != 0: ret 5
    if os.heap_validate() != 1: ret 6
    if os.heap_block_count() != 1: ret 7
    free(memory)
    if os.sched_init() != 0: ret 8
    if os.sched_enqueue(3) != 0: ret 9
    if os.sched_ready_count() != 1: ret 10
    index:int = -1
    if os.sched_dequeue(&index) != 1: ret 11
    if index != 3: ret 12
    if os.sched_ready_count() != 0: ret 13
  ret 0
