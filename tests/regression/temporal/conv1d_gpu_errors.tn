import "tzgpu"

fn main() -> int:
  // Invalid pointers must fail both with an unavailable provider and real CUDA.
  if tzgpu.tz_gpu_conv1d_f32(0, 0, 0, 0, 1, 5, 1, 1, 3, 2, 2) != -1: ret 1
  if tzgpu.tz_gpu_conv1d_bwd_f32(0, 0, 0, 0, 0, 0, 1, 5, 1, 1, 3, 2, 2) != -1: ret 2
  say "TEMPORAL_GPU_ERRORS_PASS"
  ret 0
