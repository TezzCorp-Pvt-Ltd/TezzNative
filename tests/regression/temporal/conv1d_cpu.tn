import "tzcpu"

fn main() -> int:
  x:int = tzcpu.tz_cpu_zeros(5)
  w:int = tzcpu.tz_cpu_zeros(3)
  bias:int = tzcpu.tz_cpu_zeros(1)
  out:int = tzcpu.tz_cpu_zeros(3)
  dy:int = tzcpu.tz_cpu_zeros(3)
  dx:int = tzcpu.tz_cpu_zeros(5)
  dw:int = tzcpu.tz_cpu_zeros(3)
  db:int = tzcpu.tz_cpu_zeros(1)
  if x == 0 || w == 0 || bias == 0 || out == 0 || dy == 0 || dx == 0 || dw == 0 || db == 0: ret 1
  unsafe:
    xp:*f32 = x as *f32
    wp:*f32 = w as *f32
    bp:*f32 = bias as *f32
    gp:*f32 = dy as *f32
    xp[0] = 1.0 as f32
    xp[1] = 2.0 as f32
    xp[2] = 3.0 as f32
    xp[3] = 4.0 as f32
    xp[4] = 5.0 as f32
    wp[0] = 2.0 as f32
    wp[1] = 3.0 as f32
    wp[2] = 5.0 as f32
    bp[0] = 1.0 as f32
    gp[0] = 1.0 as f32
    gp[1] = 2.0 as f32
    gp[2] = 3.0 as f32
  // Eleven and thirteen integer arguments exercise stack arguments in each ABI.
  if tzcpu.tz_cpu_conv1d_f32(x, w, bias, out, 1, 5, 1, 1, 3, 2, 2) != 0: ret 2
  if tzcpu.tz_cpu_conv1d_bwd_f32(dy, x, w, dx, dw, db, 1, 5, 1, 1, 3, 2, 2) != 0: ret 3
  unsafe:
    yp:*f32 = out as *f32
    dpx:*f32 = dx as *f32
    dpw:*f32 = dw as *f32
    dpb:*f32 = db as *f32
    if yp[0] != 19.0 as f32 || yp[1] != 37.0 as f32 || yp[2] != 22.0 as f32: ret 4
    if dpx[0] != 7.0 as f32 || dpx[1] != 0.0 as f32 || dpx[2] != 17.0 as f32 || dpx[3] != 0.0 as f32 || dpx[4] != 19.0 as f32: ret 5
    if dpw[0] != 11.0 as f32 || dpw[1] != 22.0 as f32 || dpw[2] != 13.0 as f32 || dpb[0] != 6.0 as f32: ret 6
  if tzcpu.tz_cpu_conv1d_f32(x, w, bias, x, 1, 5, 1, 1, 3, 2, 2) != -1: ret 7
  if tzcpu.tz_cpu_conv1d_bwd_f32(dy, x, w, dx, dw, db, 1, 5, 1, 1, 3, 0, 2) != -1: ret 8
  tzcpu.tz_cpu_free(x)
  tzcpu.tz_cpu_free(w)
  tzcpu.tz_cpu_free(bias)
  tzcpu.tz_cpu_free(out)
  tzcpu.tz_cpu_free(dy)
  tzcpu.tz_cpu_free(dx)
  tzcpu.tz_cpu_free(dw)
  tzcpu.tz_cpu_free(db)
  say "TEMPORAL_CPU_ABI_PASS"
  ret 0
