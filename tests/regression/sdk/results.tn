import "result"

fn double_value(value:int) -> int:
  ret value * 2

fn main() -> int:
  good:ResultInt = result.ok(21)
  mapped:ResultInt = result.result_map(good, double_value)
  if result.result_ok(mapped) != 1 || result.result_val(mapped) != 42: ret 1
  bad:ResultInt = result.err("failure")
  unsafe:
    mapped = result.result_map(bad, 0 as fn(int)->int)
  if result.result_ok(mapped) != 0: ret 2
  if strcmp(result.result_err(mapped), "failure") != 0: ret 3
  unsafe:
    mapped = result.result_map(good, 0 as fn(int)->int)
  if mapped.ok != 0: ret 4
  decimal:ResultF64 = result.ok_f64(1.25)
  if result.result_ok_f64(decimal) != 1: ret 5
  if result.result_val_f64(decimal) != 1.25: ret 6
  decimal = result.err_f64("decimal error")
  if result.result_ok_f64(decimal) != 0: ret 7
  if strcmp(result.result_err_f64(decimal), "decimal error") != 0: ret 8
  if result.result_expect(good, "unexpected failure") != 21: ret 9
  ret 0
