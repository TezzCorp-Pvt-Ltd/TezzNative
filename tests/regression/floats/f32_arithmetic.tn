fn main() -> int:
  a:f32 = 1.5 as f32
  b:f32 = 2.0 as f32
  if ((a + b) as f64) != 3.5: ret 1
  if ((b - a) as f64) != 0.5: ret 2
  if ((a * b) as f64) != 3.0: ret 3
  if ((b / a) as f64) != 1.3333333730697632: ret 4
  if ((-a) as f64) != -1.5: ret 5
  if a >= b || a > b || a == b || a != a: ret 6
  if a <= b && a < b && a == a:
    precise:f32 = 16777216.0 as f32
    one:f32 = 1.0 as f32
    if ((precise + one) as f64) != 16777216.0: ret 7
  else:
    ret 8
  zero:f32 = 0.0 as f32
  nan:f32 = zero / zero
  if nan == nan || nan < a || nan <= a || nan > a || nan >= a: ret 9
  if nan != nan:
    high:f32 = 3.4e38 as f32
    infinity:f32 = high * b
    if (infinity as f64) != (1.0 / 0.0): ret 10
  else:
    ret 11
  smallest:f32 = 1.401298464324817e-45 as f32
  if ((smallest / b) as f64) != 0.0: ret 12
  ret 0
