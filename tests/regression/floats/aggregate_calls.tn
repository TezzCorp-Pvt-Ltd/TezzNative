struct Parcel:
  x:f64
  y:f32

fn parcel(x:f64, y:f32) -> Parcel:
  ret Parcel{x:x, y:y}

fn echo(value:Parcel) -> Parcel:
  ret value

fn many(a:f64, b:f64, c:f64, d:f64, e:f64, f:f64) -> Parcel:
  ret parcel(a + b + c, d + e + f)

fn combine(a:Parcel, b:Parcel) -> f64:
  ret a.x + a.y * 2.0 + b.x * 3.0 + b.y * 4.0

fn main() -> int:
  if combine(parcel(1, 2), parcel(3, 4)) != 30.0: ret 1
  if combine(echo(parcel(1, 2)), echo(parcel(3, 4))) != 30.0: ret 2
  callback:fn(f64, f32) -> Parcel = parcel
  from_callback:Parcel = callback(3, 4)
  if from_callback.x != 3.0: ret 3
  if from_callback.y != 4.0: ret 4
  stack_args:Parcel = many(1, 2, 3, 4, 5, 6)
  if stack_args.x != 6.0: ret 5
  if stack_args.y != 15.0: ret 6
  ret 0
