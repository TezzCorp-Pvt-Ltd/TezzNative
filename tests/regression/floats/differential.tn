fn write_bits(path:str, data:*char, size:int) -> int:
  file:*char = fopen(path, "wb")
  if file == 0: ret 1
  written:int = fwrite(data, 1, size, file)
  fclose(file)
  if written != size: ret 2
  ret 0

fn main() -> int:
  unsafe:
    decoded:*f32 = (*f32)malloc(65536 * 4)
    encoded:*u16 = (*u16)malloc(65536 * 2)
    e4:*u8 = (*u8)malloc(65536)
    e5:*u8 = (*u8)malloc(65536)
    i:int = 0
    while i < 65536:
      half_bits:u16 = i as u16
      half:f16 = *((&half_bits) as *f16)
      decoded[i] = half as f32
      source_bits:u32 = (i * 65537) as u32
      source:f32 = *((&source_bits) as *f32)
      out_half:f16 = source as f16
      out_e4:f8 = source as f8
      out_e5:f8_e5m2 = source as f8_e5m2
      encoded[i] = *((&out_half) as *u16)
      e4[i] = *((&out_e4) as *u8)
      e5[i] = *((&out_e5) as *u8)
      i = i + 1
    if write_bits("half_decode.bin", decoded as *char, 65536 * 4) != 0: ret 1
    if write_bits("half_encode.bin", encoded as *char, 65536 * 2) != 0: ret 2
    if write_bits("e4_encode.bin", e4 as *char, 65536) != 0: ret 3
    if write_bits("e5_encode.bin", e5 as *char, 65536) != 0: ret 4
    i = 0
    while i < 256:
      raw:u8 = i as u8
      small:f8 = *((&raw) as *f8)
      small_e5:f8_e5m2 = *((&raw) as *f8_e5m2)
      decoded[i] = small as f32
      decoded[i + 256] = small_e5 as f32
      i = i + 1
    if write_bits("fp8_decode.bin", decoded as *char, 512 * 4) != 0: ret 5
    free(decoded)
    free(encoded)
    free(e4)
    free(e5)
  ret 0
