fn main() -> int:
  a:f64 = 3.25
  b:f32 = 1.25
  c:f16 = 10.5
  d:bf16 = 25.25
  e:f8 = 2.0
  f:f8_e5m2 = 4.0
  failures:int = 0
  if a != 3.25:
    failures += 1
  if b != 1.25:
    failures += 1
  if c != 10.5:
    failures += 1
  if d != 25.25:
    failures += 1
  if e != 2.0:
    failures += 1
  if f != 4.0:
    failures += 1
  if failures != 0:
    say "FAIL floating locals", failures
  ret failures
