import "std"

fn add(a:int, b:int) -> int:
  ret a + b

fn multiply(a:int, b:int) -> int:
  ret a * b

fn shift_left(a:int, b:int) -> int:
  ret a << b

fn shift_right(a:int, b:int) -> int:
  ret a >> b

fn main() -> int:
  low:int = 0 - 9223372036854775808
  // Parsing text exercises the VM's runtime integer operations as well.
  unsafe:
    text:str = "9223372036854775807"
    parsed:int = std._parse_int(text)
    if parsed + 1 != low || parsed * 2 != 0 - 2:
      ret 8
  if add(9223372036854775807, 1) != low:
    ret 1
  if multiply(9223372036854775807, 2) != 0 - 2:
    ret 2
  if shift_left(0 - 1, 63) != low:
    ret 3
  if shift_right(low, 63) != 0 - 1:
    ret 4
  if shift_left(3, 64) != 3 || shift_left(3, 65) != 6:
    ret 5
  if shift_right(low, 64) != low:
    ret 6
  if 9223372036854775807 + 1 != low || 3 << 65 != 6:
    ret 7
  ret 0
