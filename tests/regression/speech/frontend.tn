import "tts"
import "stt"

fn normalized(text:str, expected:str) -> int:
  let actual:str = tts._tts_normalize(text)
  if actual == 0: ret 1
  let mismatch:int = strcmp(actual, expected)
  unsafe:
    free(actual)
  if mismatch != 0: ret 1
  ret 0

fn main() -> int:
  let failures:int = 0
  failures = failures + normalized("777 777", "seven hundred seventy seven seven hundred seventy seven")
  failures = failures + normalized(" Mr.\tFox,777!\n", "Mister Fox, seven hundred seventy seven.")
  failures = failures + normalized("1000000", "one million")
  failures = failures + normalized(" \t\r\n", "")
  let digits:[char;31]
  let i:int = 0
  while i < 30:
    digits[i] = 57 as char
    i = i + 1
  digits[30] = 0 as char
  let expanded:str = tts._tts_normalize(digits)
  if expanded == 0:
    failures = failures + 1
  else:
    if len(expanded) != 149: failures = failures + 1
    unsafe:
      free(expanded)
  let oversized:[char;8194]
  i = 0
  while i < 8193:
    oversized[i] = 97 as char
    i = i + 1
  oversized[8193] = 0 as char
  let rejected:str = tts._tts_normalize(oversized)
  if rejected != 0:
    failures = failures + 1
    unsafe:
      free(rejected)
  let eng:*TtsEngine = tts.tts_new()
  if eng == 0: ret 99
  let pause:Formants = tts._tts_phoneme_formants(" ")
  if pause.f1 != 0 || pause.f2 != 0 || pause.f3 != 0: failures = failures + 1
  if tts._tts_gen_samples(eng, pause.f1, pause.f2, pause.f3, 10, 1.0) != 0: failures = failures + 1
  let pcm:*int = tts.tts_last_pcm(eng)
  i = 0
  while i < tts.tts_last_pcm_len(eng):
    unsafe:
      if pcm[i] != 0: failures = failures + 1
    i = i + 1
  if tts.tts_load_model(eng, "build/speech-regression/fixtures/invalid_model.tnw") == 0: failures = failures + 1
  if tts.tts_speak(eng, "test") == 0: failures = failures + 1
  if tts.tts_say("'; this text must never become a shell command") == 0: failures = failures + 1
  if tts.tts_last_pcm_len(eng) != 0: failures = failures + 1
  tts.tts_free(eng)
  let recognizer:*SttEngine = stt.stt_new()
  if recognizer == 0: ret 98
  if stt.stt_load_model(recognizer, "build/speech-regression/fixtures/invalid_model.tnw") == 0: failures = failures + 1
  if stt.stt_model_loaded(recognizer) != 0: failures = failures + 1
  if stt.stt_last_text(recognizer) != 0: failures = failures + 1
  if stt._stt_rule_decode(recognizer) != 0: failures = failures + 1
  // No model means this call fails before requesting microphone access.
  if stt.stt_from_mic(recognizer, 10) != 0: failures = failures + 1
  stt.stt_free(recognizer)
  say "ASSERTION_FAILURES", failures
  ret failures
