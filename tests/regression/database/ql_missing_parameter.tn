import "tezzdb"
import "tezzdbql"

fn main() -> int:
  unsafe:
    remove("ql_params.tdb")
    remove("ql_params.tdb.wal")
    db:*TezzDb = tezzdb.open("ql_params.tdb")
    if db == 0: ret 1
    tezzdb.table_create(db, "items")
    tezzdb.insert(db, "items", "{\"name\":\"secret\"}")
    result:*TzQueryResult = tezzdbql.db_query0(db as *char, "SELECT * FROM items WHERE name = ?")
    if result == 0: ret 2
    if tezzdbql.db_result_error(result) == 0: ret 3
    if tezzdbql.db_result_row_count(result) != 0: ret 4
    tezzdbql.db_result_free(result)
    tezzdb.close(db)
  ret 0
