import "tezzdb"
import "tezzdbql"

fn main() -> int:
  unsafe:
    remove("ql_bad.tdb")
    remove("ql_bad.tdb.wal")
    db:*TezzDb = tezzdb.open("ql_bad.tdb")
    if db == 0: ret 1
    tezzdb.table_create(db, "items")
    if tezzdbql.db_exec0(db as *char, "INSERT INTO items (@) VALUES ('x')") >= 0: ret 2
    if tezzdb.table_row_count(db, "items") != 0: ret 3
    tezzdb.close(db)
  ret 0
