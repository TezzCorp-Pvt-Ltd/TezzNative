import "tezzdb"
import "tezzdbql"

fn main() -> int:
  unsafe:
    remove("ql_cursor.tdb")
    remove("ql_cursor.tdb.wal")
    db:*TezzDb = tezzdb.open("ql_cursor.tdb")
    if db == 0: ret 1
    tezzdb.table_create(db, "items")
    tezzdb.insert(db, "items", "{\"name\":\"kept\"}")
    page:*DbPage = tezzdb._page_load(db, db[0].tables[0].root_page)
    original:int = tezzdb._db_r32_le(page[0].data, 8)
    tezzdb._db_w32_le(page[0].data, 8, db[0].page_count + 100)
    result:*TzQueryResult = tezzdbql.db_query0(db as *char, "SELECT * FROM items")
    if tezzdbql.db_result_error(result) == 0: ret 2
    tezzdbql.db_result_free(result)
    result = tezzdbql.db_query0(db as *char, "UPDATE items SET name = 'bad'")
    if tezzdbql.db_result_error(result) == 0: ret 3
    tezzdbql.db_result_free(result)
    tezzdb._db_w32_le(page[0].data, 8, original)
    tezzdb.close(db)
  ret 0
