import "tezzdb"

fn main() -> int:
  unsafe:
    remove("crud_reopen.tdb")
    remove("crud_reopen.tdb.wal")
    db:*TezzDb = tezzdb.open("crud_reopen.tdb")
    if db == 0: ret 1
    failed:int = 0
    if tezzdb.table_create(db, "items") != 0: ret 2
    if tezzdb.insert(db, "items", "first") != 1: failed = 1
    if tezzdb.insert_pk(db, "items", 7, "seventh") != 7: failed = 1
    if tezzdb.insert_pk(db, "items", 7, "duplicate") != 0 - 3: failed = 1
    if tezzdb.update(db, "items", 1, "updated") < 0: failed = 1
    if tezzdb.delete(db, "items", 7) != 0: failed = 1
    if tezzdb.table_row_count(db, "items") != 1: failed = 1
    if tezzdb.close(db) != 0: failed = 1
    db = tezzdb.open("crud_reopen.tdb")
    if db == 0: ret 3
    value:str = tezzdb.get(db, "items", 1)
    if value == 0 || strcmp(value, "updated") != 0: failed = 1
    free(value)
    if tezzdb.get(db, "items", 7) != 0 as str: failed = 1
    if tezzdb.table_row_count(db, "items") != 1: failed = 1
    if tezzdb.insert(db, "items", "eighth") != 8: failed = 1
    tezzdb.close(db)
    if failed != 0: say "FAIL: database CRUD, duplicate keys, or reopen persistence"
    ret failed
