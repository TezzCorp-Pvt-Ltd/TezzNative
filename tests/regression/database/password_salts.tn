import "tezzdb"

fn main() -> int:
  first:str = tezzdb._db_hash_password("alice", "correct horse battery staple")
  second:str = tezzdb._db_hash_password("alice", "correct horse battery staple")
  if first == 0 || second == 0:
    ret 1
  if strcmp(first, second) == 0:
    ret 2
  unsafe:
    free(first)
    free(second)
  ret 0
