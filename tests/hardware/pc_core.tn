// QEMU PC/Multiboot2: the C-IR ABI carries every service argument as int64.
extern fn tn_hw_init() -> int
extern fn tn_hw_target_id() -> int
extern fn tn_hw_uart_write(pointer:int, length:int) -> int
extern fn tn_hw_uart_read(pointer:int, capacity:int) -> int
extern fn tn_hw_micros() -> int
extern fn tn_hw_delay_us(microseconds:int) -> int
extern fn tn_hw_irq_enable() -> int
extern fn tn_hw_irq_disable() -> int
extern fn tn_hw_irq_state() -> int

static let zero_initialized:int

fn fib(n:int) -> int:
  if n < 2: ret n
  ret fib(n - 1) + fib(n - 2)

fn main() -> int:
  if tn_hw_init() != 0 || tn_hw_target_id() != 3: ret 1
  if zero_initialized != 0 || fib(10) != 55: ret 2
  x:float = (tn_hw_target_id() as float) / 2.0
  if x * x != 2.25: ret 3
  if tn_hw_irq_state() != 1: ret 4
  if tn_hw_irq_disable() != 1 || tn_hw_irq_state() != 0: ret 5
  if tn_hw_irq_disable() != 0: ret 15
  if tn_hw_delay_us(1) != 0 - 1 || tn_hw_delay_us(0) != 0: ret 6
  if tn_hw_irq_enable() != 0 || tn_hw_irq_state() != 1: ret 7
  if tn_hw_irq_enable() != 1: ret 16
  if tn_hw_uart_read(0, 0) != 0 || tn_hw_uart_read(0, 1) != 0 - 1: ret 8
  if tn_hw_uart_write(0, 1) != 0 - 1 || tn_hw_uart_write(0, 0) != 0: ret 9
  if tn_hw_delay_us(0 - 1) != 0 - 1: ret 10
  before:int = tn_hw_micros()
  if before < 0 || tn_hw_delay_us(20000) != 0: ret 11
  elapsed:int = tn_hw_micros() - before
  if elapsed < 20000 || elapsed > 2000000: ret 12
  previous:int = tn_hw_micros()
  i:int = 0
  while i < 1000:
    current:int = tn_hw_micros()
    if current < previous: ret 13
    previous = current
    i = i + 1
  unsafe:
    received:[char;1] = [88 as char]
    if tn_hw_uart_read((&received[0]) as int, 1) != 0: ret 17
    if received[0] != 88 as char: ret 18
    message:str = "TEZZ_PC_CORE_OK\n"
    if tn_hw_uart_write(message as int, 16) != 16: ret 14
  ret 0
