import "arduino.uno"

fn weighted(a:int, b:int, c:int) -> int:
  ret a + b * 10 + c * 100

fn main() -> int:
  if weighted(4294967297, 2, 3) != 4294967617: ret 1
  if sizeof(int) != 8 || sizeof(str) != 8: ret 2
  if arduino.uno.interrupts_enabled() != 1: ret 3
  if arduino.uno.interrupts_disable() != 1: ret 4
  if arduino.uno.interrupts_enabled() != 0: ret 5
  if arduino.uno.interrupts_disable() != 0: ret 6
  if arduino.uno.delay_us(20) != 0: ret 7
  if arduino.uno.interrupts_enable() != 0: ret 8
  if arduino.uno.interrupts_enabled() != 1: ret 9
  if arduino.uno.interrupts_enable() != 1: ret 10
  start:int = arduino.uno.micros()
  if arduino.uno.delay_us(2000) != 0: ret 11
  elapsed:int = arduino.uno.micros() - start
  if elapsed < 2000 || elapsed > 7000: ret 12
  start = arduino.uno.millis()
  if arduino.uno.delay(5) != 0: ret 13
  elapsed = arduino.uno.millis() - start
  if elapsed < 5 || elapsed > 15: ret 14
  if arduino.uno.delay_us(-1) != -1 || arduino.uno.delay(-1) != -1: ret 15
  ret 0
