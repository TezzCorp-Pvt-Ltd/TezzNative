// Test Suite for Phase 5: Optimizers, Schedulers & Training Loop
import "tensor"
import "math"

fn test_lr_schedulers() -> int:
  say "=== Test Block 1: Learning Rate Schedulers ==="
  // 1. Linear Schedule
  lr0:float = tensor.lr_linear_schedule(1.0, 0.0, 0, 100)
  lr50:float = tensor.lr_linear_schedule(1.0, 0.0, 50, 100)
  lr100:float = tensor.lr_linear_schedule(1.0, 0.0, 100, 100)
  say "  Linear LR [0, 50, 100]: [", lr0, ", ", lr50, ", ", lr100, "]"
  if lr0 != 1.0 || lr50 != 0.5 || lr100 != 0.0:
    say "FAIL: Linear LR schedule values incorrect"

  // 2. Cosine Schedule with Warmup
  // Warmup=10 steps, Total=100 steps
  c_lr0:float = tensor.lr_cosine_schedule(1.0, 0.0, 0, 10, 100)
  c_lr10:float = tensor.lr_cosine_schedule(1.0, 0.0, 10, 10, 100)
  c_lr55:float = tensor.lr_cosine_schedule(1.0, 0.0, 55, 10, 100) // midpoint of decay
  c_lr100:float = tensor.lr_cosine_schedule(1.0, 0.0, 100, 10, 100)
  say "  Cosine LR [0, 10, 55, 100]: [", c_lr0, ", ", c_lr10, ", ", c_lr55, ", ", c_lr100, "]"
  if c_lr0 != 0.0: say "FAIL: Cosine warmup start"
  diff_peak:float = c_lr10 - 1.0
  if diff_peak < 0.0: diff_peak = 0.0 - diff_peak
  if diff_peak > 0.001: say "FAIL: Cosine warmup peak"
  diff_mid:float = c_lr55 - 0.5
  if diff_mid < 0.0: diff_mid = 0.0 - diff_mid
  if diff_mid > 0.01: say "FAIL: Cosine midpoint"
  if c_lr100 != 0.0: say "FAIL: Cosine end"

  say "PASS: Test Block 1 (LR Schedulers)"
  ret 0

fn test_gradient_clipping() -> int:
  say "=== Test Block 2: Gradient Clipping (clip_grad_norm) ==="
  tensor.tape_init()
  p:Tensor = tensor.tensor_1d(2)
  tensor.tensor_set1(p, 0, 1.0)
  tensor.tensor_set1(p, 1, 1.0)
  p = tensor.tensor_require_grad(p)

  // Seed gradient with [6.0, 8.0] -> norm = sqrt(36 + 64) = 10.0
  unsafe:
    p.grad.data[0] = 6.0
    p.grad.data[1] = 8.0

  opt:AdamW = tensor.adamw_create(0.01, 0.9, 0.999, 1.0e-08, 0.0)
  unsafe:
    tensor.adamw_add_param(&opt, &p)
    norm:float = tensor.adamw_clip_grad_norm(&opt, 5.0)
    say "  Norm before clipping: ", norm, " (expected 10.0)"
    g0:float = p.grad.data[0]
    g1:float = p.grad.data[1]
    say "  Gradients after clipping (max_norm=5.0): [", g0, ", ", g1, "] (expected [3.0, 4.0])"
    if g0 < 2.999 || g0 > 3.001 || g1 < 3.999 || g1 > 4.001:
      say "FAIL: Gradient clipping scaling incorrect"
    tensor.adamw_free(&opt)

  tensor.tensor_free_tensor(p)
  tensor.tape_reset()
  say "PASS: Test Block 2 (Gradient Clipping)"
  ret 0

fn test_sgd_optimizer() -> int:
  say "=== Test Block 3: SGD Optimizer (Momentum & Weight Decay) ==="
  tensor.tape_init()

  // Minimize (w - 7)^2 starting at w = 0
  w:Tensor = tensor.tensor_1d(1)
  tensor.tensor_set1(w, 0, 0.0)
  w = tensor.tensor_require_grad(w)

  target:Tensor = tensor.tensor_1d(1)
  tensor.tensor_set1(target, 0, 7.0)

  opt:SGD = tensor.sgd_create(0.1, 0.8, 0.0, 0)
  unsafe:
    tensor.sgd_add_param(&opt, &w)

  iter:int = 0
  while iter < 40:
    tensor.tape_reset()
    unsafe:
      tensor.sgd_zero_grad(&opt)
    loss:Tensor = tensor.tensor_mse_loss(w, target)
    tensor.tensor_backward(loss)
    unsafe:
      tensor.sgd_step(&opt)
    iter = iter + 1

  final_w:float = tensor.tensor_get1(w, 0)
  say "  Final w after 40 steps of Momentum SGD: ", final_w, " (expected approx 7.0)"
  diff:float = final_w - 7.0
  if diff < 0.0: diff = 0.0 - diff
  if diff > 0.1:
    say "FAIL: SGD did not reach target 7.0: ", final_w

  unsafe:
    tensor.sgd_free(&opt)
  tensor.tensor_free_tensor(w)
  tensor.tensor_free_tensor(target)
  tensor.tape_reset()
  say "PASS: Test Block 3 (SGD Optimizer)"
  ret 0

fn test_adamw_optimizer() -> int:
  say "=== Test Block 4: AdamW Optimizer ==="
  tensor.tape_init()

  // Minimize (w - 10)^2 starting at w = 0
  w:Tensor = tensor.tensor_1d(1)
  tensor.tensor_set1(w, 0, 0.0)
  w = tensor.tensor_require_grad(w)

  target:Tensor = tensor.tensor_1d(1)
  tensor.tensor_set1(target, 0, 10.0)

  opt:AdamW = tensor.adamw_create(0.5, 0.9, 0.999, 1.0e-08, 0.01)
  unsafe:
    tensor.adamw_add_param(&opt, &w)

  iter:int = 0
  total_iters:int = 60
  while iter < total_iters:
    tensor.tape_reset()
    unsafe:
      tensor.adamw_zero_grad(&opt)
    opt.lr = tensor.lr_linear_schedule(0.5, 0.01, iter, total_iters)
    loss:Tensor = tensor.tensor_mse_loss(w, target)
    tensor.tensor_backward(loss)
    unsafe:
      tensor.adamw_step(&opt)
    iter = iter + 1

  final_w:float = tensor.tensor_get1(w, 0)
  say "  Final w after AdamW + LR Schedule: ", final_w, " (expected approx 10.0)"
  diff:float = final_w - 10.0
  if diff < 0.0: diff = 0.0 - diff
  if diff > 0.2:
    say "FAIL: AdamW did not reach target 10.0: ", final_w

  unsafe:
    tensor.adamw_free(&opt)
  tensor.tensor_free_tensor(w)
  tensor.tensor_free_tensor(target)
  tensor.tape_reset()
  say "PASS: Test Block 4 (AdamW Optimizer)"
  ret 0

fn test_end_to_end_mlp() -> int:
  say "=== Test Block 5: End-to-End Multi-Layer Perceptron (MLP) Training ==="
  tensor.tape_init()

  // Training data: 4 samples, 2 inputs -> 1 output
  x:Tensor = tensor.tensor_2d(4, 2)
  tensor.tensor_set2(x, 0, 0, 1.0)
  tensor.tensor_set2(x, 0, 1, 0.0)
  tensor.tensor_set2(x, 1, 0, 0.0)
  tensor.tensor_set2(x, 1, 1, 1.0)
  tensor.tensor_set2(x, 2, 0, 1.0)
  tensor.tensor_set2(x, 2, 1, 1.0)
  tensor.tensor_set2(x, 3, 0, 2.0)
  tensor.tensor_set2(x, 3, 1, 1.0)

  y_true:Tensor = tensor.tensor_2d(4, 1)
  tensor.tensor_set2(y_true, 0, 0, 2.0)
  tensor.tensor_set2(y_true, 1, 0, 3.0)
  tensor.tensor_set2(y_true, 2, 0, 5.0)
  tensor.tensor_set2(y_true, 3, 0, 7.0)

  // Parameters:
  // Layer 1: W1[2, 4], B1[1, 4]
  w1:Tensor = tensor.tensor_2d(2, 4)
  tensor.tensor_fill(w1, 0.1)
  w1 = tensor.tensor_require_grad(w1)

  b1:Tensor = tensor.tensor_2d(1, 4)
  tensor.tensor_fill(b1, 0.0)
  b1 = tensor.tensor_require_grad(b1)

  // Layer 2: W2[4, 1], B2[1, 1]
  w2:Tensor = tensor.tensor_2d(4, 1)
  tensor.tensor_fill(w2, 0.1)
  w2 = tensor.tensor_require_grad(w2)

  b2:Tensor = tensor.tensor_2d(1, 1)
  tensor.tensor_fill(b2, 0.0)
  b2 = tensor.tensor_require_grad(b2)

  opt:SGD = tensor.sgd_create(0.05, 0.9, 0.0, 0)
  unsafe:
    tensor.sgd_add_param(&opt, &w1)
    tensor.sgd_add_param(&opt, &b1)
    tensor.sgd_add_param(&opt, &w2)
    tensor.sgd_add_param(&opt, &b2)

  initial_loss:float = 0.0
  final_loss:float = 0.0

  epoch:int = 0
  while epoch <= 80:
    tensor.tape_reset()
    unsafe:
      tensor.sgd_zero_grad(&opt)

    // Forward:
    xw1:Tensor = tensor.tensor_matmul(x, w1)
    h_pre:Tensor = tensor.tensor_add(xw1, b1)
    h:Tensor = tensor.tensor_relu(h_pre)

    hw2:Tensor = tensor.tensor_matmul(h, w2)
    pred:Tensor = tensor.tensor_add(hw2, b2)

    loss:Tensor = tensor.tensor_mse_loss(pred, y_true)
    cur_loss:float = tensor.tensor_get1(loss, 0)

    if epoch == 0:
      initial_loss = cur_loss
    final_loss = cur_loss

    if epoch % 20 == 0:
      say "  Epoch ", epoch, " Loss = ", cur_loss

    // Backward:
    tensor.tensor_backward(loss)

    // Clip & Step:
    unsafe:
      tensor.sgd_clip_grad_norm(&opt, 1.0)
      tensor.sgd_step(&opt)

    epoch = epoch + 1

  say "  Initial Loss: ", initial_loss, " -> Final Loss: ", final_loss
  if final_loss >= initial_loss:
    say "FAIL: Neural network loss did not decrease!"
  else:
    say "  Loss reduction: ", initial_loss - final_loss

  unsafe:
    tensor.sgd_free(&opt)
  tensor.tensor_free_tensor(x)
  tensor.tensor_free_tensor(y_true)
  tensor.tensor_free_tensor(w1)
  tensor.tensor_free_tensor(b1)
  tensor.tensor_free_tensor(w2)
  tensor.tensor_free_tensor(b2)
  tensor.tape_reset()
  say "PASS: Test Block 5 (End-to-End MLP Training)"
  ret 0

fn test_end_to_end_transformer_step() -> int:
  say "=== Test Block 6: LLM Transformer Attention Layer Training Step ==="
  tensor.tape_init()

  // Token Sequence: Batch=1, Seq=2, Dim=4
  x:Tensor = tensor.tensor_zeros_2d(2, 4)
  tensor.tensor_set2(x, 0, 0, 1.0)
  tensor.tensor_set2(x, 0, 1, 0.5)
  tensor.tensor_set2(x, 1, 0, 0.5)
  tensor.tensor_set2(x, 1, 1, 1.0)

  // Query & Key & Value Projections
  wq:Tensor = tensor.tensor_zeros_2d(4, 4)
  tensor.tensor_set2(wq, 0, 0, 1.0)
  tensor.tensor_set2(wq, 1, 1, 1.0)
  tensor.tensor_set2(wq, 2, 2, 1.0)
  tensor.tensor_set2(wq, 3, 3, 1.0)
  wq = tensor.tensor_require_grad(wq)

  wk:Tensor = tensor.tensor_zeros_2d(4, 4)
  tensor.tensor_set2(wk, 0, 0, 1.0)
  tensor.tensor_set2(wk, 1, 1, 1.0)
  tensor.tensor_set2(wk, 2, 2, 1.0)
  tensor.tensor_set2(wk, 3, 3, 1.0)
  wk = tensor.tensor_require_grad(wk)

  wv:Tensor = tensor.tensor_zeros_2d(4, 4)
  tensor.tensor_set2(wv, 0, 0, 1.0)
  tensor.tensor_set2(wv, 1, 1, 1.0)
  tensor.tensor_set2(wv, 2, 2, 1.0)
  tensor.tensor_set2(wv, 3, 3, 1.0)
  wv = tensor.tensor_require_grad(wv)

  // RMSNorm weight
  rms_w:Tensor = tensor.tensor_ones_1d(4)

  // Output Projection Head: [4, 2] predicting 2 vocabulary tokens
  w_out:Tensor = tensor.tensor_zeros_2d(4, 2)
  tensor.tensor_set2(w_out, 0, 0, 0.5)
  tensor.tensor_set2(w_out, 1, 1, 0.5)
  w_out = tensor.tensor_require_grad(w_out)

  // Target token distributions
  targets:Tensor = tensor.tensor_zeros_2d(2, 2)
  tensor.tensor_set2(targets, 0, 0, 1.0) // token 0 target for pos 0
  tensor.tensor_set2(targets, 1, 1, 1.0) // token 1 target for pos 1

  opt:AdamW = tensor.adamw_create(0.01, 0.9, 0.999, 1.0e-08, 0.01)
  unsafe:
    tensor.adamw_add_param(&opt, &wq)
    tensor.adamw_add_param(&opt, &wk)
    tensor.adamw_add_param(&opt, &wv)
    tensor.adamw_add_param(&opt, &w_out)

  step:int = 0
  init_loss:float = 0.0
  final_loss:float = 0.0

  while step <= 10:
    tensor.tape_reset()
    unsafe:
      tensor.adamw_zero_grad(&opt)

    // 1. RMSNorm
    x_norm:Tensor = tensor.tensor_rmsnorm(x, rms_w, 1.0e-05)

    // 2. Q, K, V Projections
    q:Tensor = tensor.tensor_matmul(x_norm, wq)
    k:Tensor = tensor.tensor_matmul(x_norm, wk)
    v:Tensor = tensor.tensor_matmul(x_norm, wv)

    // 3. RoPE (Rotary Position Embeddings)
    tensor.tensor_rope_2d(q, k, 0, 10000.0)

    // 4. Scaled Dot-Product Attention (Causal Mask)
    attn_out:Tensor = tensor.tensor_sdpa(q, k, v, 1)

    // 5. Output Projection to Vocabulary Logits
    logits:Tensor = tensor.tensor_matmul(attn_out, w_out)

    // 6. Cross-Entropy Loss
    loss:Tensor = tensor.tensor_cross_entropy_loss(logits, targets)
    loss_val:float = tensor.tensor_get1(loss, 0)

    if step == 0:
      init_loss = loss_val
    final_loss = loss_val

    if step % 5 == 0:
      say "  Transformer Step ", step, " Cross-Entropy Loss = ", loss_val

    // 7. Backward Pass & Optimizer Update
    tensor.tensor_backward(loss)
    unsafe:
      tensor.adamw_clip_grad_norm(&opt, 1.0)
      tensor.adamw_step(&opt)

    step = step + 1

  say "  Initial Loss: ", init_loss, " -> Final Loss: ", final_loss
  if final_loss >= init_loss:
    say "FAIL: Transformer training step did not decrease loss!"
  else:
    say "  Loss reduction: ", init_loss - final_loss

  unsafe:
    tensor.adamw_free(&opt)
  tensor.tensor_free_tensor(x)
  tensor.tensor_free_tensor(wq)
  tensor.tensor_free_tensor(wk)
  tensor.tensor_free_tensor(wv)
  tensor.tensor_free_tensor(rms_w)
  tensor.tensor_free_tensor(w_out)
  tensor.tensor_free_tensor(targets)
  tensor.tape_reset()
  say "PASS: Test Block 6 (Transformer Training Step)"
  ret 0

fn main() -> int:
  say "================================================="
  say " Running TezzNative Tensor Engine - Phase 5 Tests"
  say "================================================="

  test_lr_schedulers()
  test_gradient_clipping()
  test_sgd_optimizer()
  test_adamw_optimizer()
  test_end_to_end_mlp()
  test_end_to_end_transformer_step()

  say "================================================="
  say " ALL PHASE 5 TESTS PASSED (6/6 Test Blocks OK)  "
  say "================================================="
  ret 0
