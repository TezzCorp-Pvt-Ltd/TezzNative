// test_gui_core_accel.tn — Comprehensive validation of core GUI smoothness, speed, and animation
import "gui_win"
import "tween"
import "tzgui"

fn main() -> int:
  say "Testing core GUI acceleration..."

  // 1. Monotonic high-precision clock
  t0:int = gui_win.fb_time_us()
  t0_ms:int = gui_win.fb_time_ms()
  gui_win.sleep_ms(10)
  t1:int = gui_win.fb_time_us()
  t1_ms:int = gui_win.fb_time_ms()

  if t1 <= t0:
    say "FAILED: fb_time_us did not advance monotonically"
    ret 1

  if t1_ms < t0_ms:
    say "FAILED: fb_time_ms did not advance monotonically"
    ret 2

  say "  [OK] High-precision timer working (elapsed: ", t1 - t0, " us)"

  // 2. Core frame sync pacer
  sync_dt:int = gui_win.fb_frame_sync(60)
  if sync_dt < 0:
    say "FAILED: fb_frame_sync returned invalid delta"
    ret 3

  say "  [OK] Frame sync pacer working (dt: ", sync_dt, " ms)"

  // 3. Spring physics solver
  spring:TzSpring
  step_count:int = 0
  unsafe:
    tween.spring_init(&spring, 0, 180, 25)
    tween.spring_set_target(&spring, 1000)
    if tween.spring_settled(&spring) != 0:
      say "FAILED: spring should not be settled after target change"
      ret 4

    while tween.spring_settled(&spring) == 0 && step_count < 100:
      val:int = tween.spring_tick(&spring, 16)
      step_count = step_count + 1

    if tween.spring_settled(&spring) == 0:
      say "FAILED: spring did not settle within 200 steps"
      ret 5

  final_val:int = spring.pos
  if final_val != 1000:
    say "FAILED: spring final value expected 1000, got: ", final_val
    ret 6

  say "  [OK] Core spring physics settled at target in ", step_count, " steps"

  // 4. Retained widget animation engine
  tree:TzWidgetTree
  unsafe:
    tzgui.tree_init(&tree, 800, 600)
    spec:TzWidgetSpec
    spec.parent = 0
    spec.kind = 1 // Panel
    spec.x = 10
    spec.y = 10
    spec.w = 100
    spec.h = 50
    spec.z = 0
    spec.visible = 1
    spec.bg = 0x112233
    spec.fg = 0xFFFFFF
    spec.text = 0 as str
    btn_id:int = tzgui.widget_add(&tree, &spec)

    tzgui.widget_animate_bounds(&tree, btn_id, 200, 300, 250, 120, 200, 2)
    active:int = tzgui.tree_animate_tick(&tree, 50)
    if active != 1:
      say "FAILED: expected 1 active animation, got: ", active
      ret 7

    // Advance to completion
    tzgui.tree_animate_tick(&tree, 160)
    still_active:int = tzgui.tree_animate_tick(&tree, 50)
    if still_active != 0:
      say "FAILED: animation should have finished"
      ret 8

    slot:int = tzgui._tree_widget_slot_by_id(&tree, btn_id)
    if tree.widgets[slot].x != 200 || tree.widgets[slot].y != 300:
      say "FAILED: animated widget bounds mismatch"
      ret 9

  say "  [OK] Retained widget tree animation engine verified"
  say "All core GUI acceleration and animation tests passed successfully!"
  ret 0
