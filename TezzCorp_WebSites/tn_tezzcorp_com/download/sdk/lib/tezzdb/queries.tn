// tezzdb implementation: queries.
import "io"
import "time"
import "tezzdb.state"
import "tezzdb.tables"
import "tezzdb.storage"
import "tezzdb.overflow"
import "tezzdb.auth"

fn cursor_open(db:*TezzDb, table:str) -> *DbCursor:
  if db == 0 || table == 0: ret 0 as *DbCursor
  index:int = tezzdb.tables._find_table(db, table)
  if index < 0: ret 0 as *DbCursor
  path:[int;32]
  length:int = 0
  minimum:int = (0 - 9223372036854775807) - 1
  leaf:*DbPage = tezzdb.tables._btree_find_leaf(db, (*db).tables[index].root_page, minimum, &path[0], &length)
  if leaf == 0: ret 0 as *DbCursor
  cur:*DbCursor = (*DbCursor)malloc(sizeof(DbCursor))
  if cur == 0: ret 0 as *DbCursor
  (*cur).db = db
  (*cur).table_idx = index
  (*cur).leaf_page = (*leaf).page_id
  (*cur).leaf_pos = 0
  (*cur).pk_min = 0 - 1
  (*cur).pk_max = 0 - 1
  (*cur).done = 0
  (*cur).error = 0
  (*cur).visited_pages = 1
  ret cur

fn cursor_range(db:*TezzDb, table:str, pk_min:int, pk_max:int) -> *DbCursor:
  cur:*DbCursor = cursor_open(db, table)
  if cur == 0: ret 0 as *DbCursor
  (*cur).pk_min = pk_min
  (*cur).pk_max = pk_max
  ret cur

fn cursor_next(cur:*DbCursor) -> *DbRow:
  if cur == 0 || (*cur).done != 0: ret 0 as *DbRow
  db:*TezzDb = (*cur).db
  while 1:
    page:*DbPage = tezzdb.storage._page_load(db, (*cur).leaf_page)
    if page == 0:
      (*cur).done = 1
      (*cur).error = 1
      ret 0 as *DbRow
    if tezzdb.storage._db_r32_le((*page).data, 0) != tezzdb.state._get_DB_PAGE_BTREE_LEAF():
      (*cur).done = 1
      (*cur).error = 1
      ret 0 as *DbRow
    count:int = tezzdb.storage._leaf_count(page)
    if (*cur).leaf_pos >= count:
      next_page:int = tezzdb.storage._db_r32_le((*page).data, 8)
      if next_page == 0:
        (*cur).done = 1
        ret 0 as *DbRow
      if (*cur).visited_pages >= (*db).page_count:
        (*cur).done = 1
        (*cur).error = 1
        ret 0 as *DbRow
      (*cur).visited_pages = (*cur).visited_pages + 1
      (*cur).leaf_page = next_page
      (*cur).leaf_pos = 0
      continue
    position:int = (*cur).leaf_pos
    offset:int = tezzdb.storage._leaf_entry_offset(page, position)
    if offset < 16:
      (*cur).done = 1
      (*cur).error = 1
      ret 0 as *DbRow
    pk:int = tezzdb.storage._db_r64_le((*page).data, offset)
    (*cur).leaf_pos = position + 1
    if (*cur).pk_min >= 0 && pk < (*cur).pk_min: continue
    if (*cur).pk_max >= 0 && pk > (*cur).pk_max:
      (*cur).done = 1
      ret 0 as *DbRow
    length:int = tezzdb.storage._db_r32_le((*page).data, offset + 8)
    data:str = tezzdb.overflow._leaf_value(db, page, position)
    if data == 0:
      (*cur).done = 1
      (*cur).error = 1
      ret 0 as *DbRow
    row:*DbRow = (*DbRow)malloc(sizeof(DbRow))
    if row == 0:
      free(data)
      (*cur).done = 1
      (*cur).error = 1
      ret 0 as *DbRow
    (*row).pk = pk
    (*row).data = data
    (*row).data_len = length
    ret row
  ret 0 as *DbRow

fn cursor_close(cur:*DbCursor) -> int:
  if cur == 0: ret tezzdb.state._get_TEZZDB_ERR()
  free(cur)
  ret tezzdb.state._get_TEZZDB_OK()

fn row_free(row:*DbRow) -> int:
  if row == 0: ret tezzdb.state._get_TEZZDB_ERR()
  if (*row).data != 0: free((*row).data)
  free(row)
  ret tezzdb.state._get_TEZZDB_OK()

// ─────────────────────────────────────────────────────────────
// JSON field extraction helpers (for row data)
// ─────────────────────────────────────────────────────────────

fn _db_json_hex(c:int) -> int:
  if c >= 48 && c <= 57: ret c - 48
  if c >= 65 && c <= 70: ret c - 55
  if c >= 97 && c <= 102: ret c - 87
  ret 0 - 1

fn _db_json_decode(json:str, start:int, end_out:*int) -> str:
  if json == 0 || start < 0: ret 0 as str
  n:int = len(json)
  if start >= n || json[start] != 34 as char: ret 0 as str
  out:*char = malloc(n - start + 1)
  if out == 0: ret 0 as str
  i:int = start + 1
  used:int = 0
  while i < n:
    c:int = (json[i] as int) & 255
    i = i + 1
    if c == 34:
      out[used] = 0 as char
      *end_out = i
      ret out as str
    if c < 32:
      free(out)
      ret 0 as str
    if c == 92:
      if i >= n: break
      c = (json[i] as int) & 255
      i = i + 1
      if c == 98: c = 8
      else if c == 102: c = 12
      else if c == 110: c = 10
      else if c == 114: c = 13
      else if c == 116: c = 9
      else if c == 117:
        if i + 4 > n: break
        code:int = 0
        j:int = 0
        valid:int = 1
        while j < 4:
          digit:int = _db_json_hex(json[i + j] as int)
          if digit < 0: valid = 0
          code = code * 16 + digit
          j = j + 1
        if valid == 0: break
        i = i + 4
        if code >= 55296 && code <= 56319:
          if i + 6 > n || json[i] != 92 as char || json[i + 1] != 117 as char: break
          low:int = 0
          j = 0
          while j < 4:
            digit:int = _db_json_hex(json[i + 2 + j] as int)
            if digit < 0: valid = 0
            low = low * 16 + digit
            j = j + 1
          if valid == 0 || low < 56320 || low > 57343: break
          code = 65536 + (code - 55296) * 1024 + low - 56320
          i = i + 6
        else if code >= 56320 && code <= 57343:
          break
        // Native str is NUL terminated; reject embedded NUL instead of truncating.
        if code == 0: break
        if code < 128:
          out[used] = code as char
          used = used + 1
        else if code < 2048:
          out[used] = (192 | (code >> 6)) as char
          out[used + 1] = (128 | (code & 63)) as char
          used = used + 2
        else if code < 65536:
          out[used] = (224 | (code >> 12)) as char
          out[used + 1] = (128 | ((code >> 6) & 63)) as char
          out[used + 2] = (128 | (code & 63)) as char
          used = used + 3
        else:
          out[used] = (240 | (code >> 18)) as char
          out[used + 1] = (128 | ((code >> 12) & 63)) as char
          out[used + 2] = (128 | ((code >> 6) & 63)) as char
          out[used + 3] = (128 | (code & 63)) as char
          used = used + 4
        continue
      else if c != 34 && c != 92 && c != 47:
        break
    out[used] = c as char
    used = used + 1
  free(out)
  ret 0 as str

fn _db_json_quote(value:str) -> str:
  n:int = len(value)
  if n > 1537228672809129300: ret 0 as str
  out:*char = malloc(n * 6 + 3)
  if out == 0: ret 0 as str
  hex:str = "0123456789abcdef"
  out[0] = 34 as char
  used:int = 1
  i:int = 0
  while i < n:
    c:int = (value[i] as int) & 255
    if c == 34 || c == 92:
      out[used] = 92 as char
      out[used + 1] = c as char
      used = used + 2
    else if c < 32:
      out[used] = 92 as char
      out[used + 1] = 117 as char
      out[used + 2] = 48 as char
      out[used + 3] = 48 as char
      out[used + 4] = hex[c >> 4]
      out[used + 5] = hex[c & 15]
      used = used + 6
    else:
      out[used] = c as char
      used = used + 1
    i = i + 1
  out[used] = 34 as char
  out[used + 1] = 0 as char
  ret out as str

fn _db_json_append_owned(buffer:str, part:str) -> str:
  if buffer == 0 || part == 0:
    free(buffer)
    ret 0 as str
  out:str = tezzdb.storage._db_join2(buffer, part)
  free(buffer)
  ret out

fn _db_json_pair(key:str, value:str) -> str:
  k:str = _db_json_quote(key)
  v:str = _db_json_quote(value)
  out:str = _db_json_append_owned(k, ":")
  out = _db_json_append_owned(out, v)
  free(v)
  ret out

fn _json_find_key(json:str, key:str) -> int:
  if json == 0 || key == 0: ret 0 - 1
  n:int = len(json)
  i:int = 0
  while i < n:
    if json[i] == 34 as char:
      end:int = 0
      candidate:str = _db_json_decode(json, i, &end)
      if candidate == 0: ret 0 - 1
      position:int = end
      while position < n && (json[position] == 32 as char || json[position] == 9 as char || json[position] == 10 as char || json[position] == 13 as char):
        position = position + 1
      match:int = strcmp(candidate, key) == 0
      free(candidate)
      if position < n && json[position] == 58 as char && match != 0:
        position = position + 1
        while position < n && (json[position] == 32 as char || json[position] == 9 as char || json[position] == 10 as char || json[position] == 13 as char):
          position = position + 1
        if position < n: ret position
        ret 0 - 1
      i = end
    else:
      i = i + 1
  ret 0 - 1

fn row_get_str(json:str, key:str) -> str:
  off:int = _json_find_key(json, key)
  if off < 0: ret 0 as str
  end:int = 0
  ret _db_json_decode(json, off, &end)

fn row_get_int(json:str, key:str) -> int:
  off:int = _json_find_key(json, key)
  if off < 0: ret 0
  jlen:int = len(json)
  sign:int = 1
  n:int = 0
  i:int = off
  if (json as *char)[i] == 45 as char:
    sign = 0 - 1
    i = i + 1
  while i < jlen:
    c:int = (json as *char)[i] as int
    if c < 48 || c > 57: break
    n = n * 10 + (c - 48)
    i = i + 1
  ret n * sign

// Build a simple JSON object from key-value pairs

fn row_json2(k1:str, v1:str, k2:str, v2:str) -> str:
  a:str = _db_json_pair(k1, v1)
  b:str = _db_json_pair(k2, v2)
  out:str = tezzdb.storage._db_strdup("{")
  out = _db_json_append_owned(out, a)
  out = _db_json_append_owned(out, ",")
  out = _db_json_append_owned(out, b)
  out = _db_json_append_owned(out, "}")
  free(a)
  free(b)
  ret out

fn row_json3(k1:str, v1:str, k2:str, v2:str, k3:str, v3:str) -> str:
  base:str = row_json2(k1, v1, k2, v2)
  if base == 0: ret 0 as str
  (base as *char)[len(base) - 1] = 0 as char
  pair:str = _db_json_pair(k3, v3)
  out:str = _db_json_append_owned(base, ",")
  out = _db_json_append_owned(out, pair)
  out = _db_json_append_owned(out, "}")
  free(pair)
  ret out

// ─────────────────────────────────────────────────────────────
// Query API: simple filter scan
// ─────────────────────────────────────────────────────────────

// Query all rows in table where json_field = value.
// Returns JSON array string of matching rows. Caller frees.

fn query_where(db:*TezzDb, table:str, field:str, value:str) -> str:
  if db == 0 || table == 0 || (field != 0 && value == 0): ret 0 as str
  cur:*DbCursor = cursor_open(db, table)
  if cur == 0: ret 0 as str
  result:str = tezzdb.storage._db_strdup("[")
  count:int = 0
  while result != 0:
    row:*DbRow = cursor_next(cur)
    if row == 0: break
    matches:int = 0
    if field == 0:
      matches = 1
    else:
      actual:str = row_get_str((*row).data, field)
      if actual != 0 && strcmp(actual, value) == 0: matches = 1
      free(actual)
    if matches != 0:
      if count > 0: result = _db_json_append_owned(result, ",")
      result = _db_json_append_owned(result, (*row).data)
      count = count + 1
    row_free(row)
  error:int = (*cur).error
  cursor_close(cur)
  if error != 0:
    free(result)
    ret 0 as str
  ret _db_json_append_owned(result, "]")

// Query all rows — returns JSON array

fn query_all(db:*TezzDb, table:str) -> str:
  ret query_where(db, table, 0 as str, 0 as str)

// Query with pk range — returns JSON array

fn query_range(db:*TezzDb, table:str, pk_min:int, pk_max:int) -> str:
  if db == 0 || table == 0: ret 0 as str
  cur:*DbCursor = cursor_range(db, table, pk_min, pk_max)
  if cur == 0: ret 0 as str
  result:str = tezzdb.storage._db_strdup("[")
  count:int = 0
  while result != 0:
    row:*DbRow = cursor_next(cur)
    if row == 0: break
    if count > 0: result = _db_json_append_owned(result, ",")
    result = _db_json_append_owned(result, (*row).data)
    count = count + 1
    row_free(row)
  error:int = (*cur).error
  cursor_close(cur)
  if error != 0:
    free(result)
    ret 0 as str
  ret _db_json_append_owned(result, "]")

// ─────────────────────────────────────────────────────────────
// User / Auth helpers (maintained from v1.0)
// ─────────────────────────────────────────────────────────────

fn _db_hash_password(user:str, password:str) -> str:
  if user == 0 || user[0] == 0:
    ret 0 as str
  ret tezzdb.auth.password_hash(password)

fn register_user(db:*TezzDb, user:str, password:str) -> int:
  if db == 0 || user == 0 || password == 0 || len(user) == 0 || len(user) > 128:
    ret tezzdb.state._get_TEZZDB_ERR()
  if tezzdb.tables.table_exists(db, "users") == 0:
    if tezzdb.tables.table_create(db, "users") < 0:
      ret tezzdb.state._get_TEZZDB_ERR()
  existing:str = query_where(db, "users", "username", user)
  if existing == 0:
    ret tezzdb.state._get_TEZZDB_ERR()
  dup:int = len(existing) > 2
  free(existing)
  if dup != 0:
    ret tezzdb.state._get_TEZZDB_DUPLICATE()
  hash:str = _db_hash_password(user, password)
  if hash == 0:
    ret tezzdb.state._get_TEZZDB_ERR()
  row:str = row_json2("username", user, "password_hash", hash)
  free(hash)
  if row == 0:
    ret tezzdb.state._get_TEZZDB_ERR()
  result:int = tezzdb.tables.insert(db, "users", row)
  free(row)
  if result < 0:
    ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.state._get_TEZZDB_OK()

fn login_token(db:*TezzDb, user:str, password:str) -> str:
  if db == 0 || user == 0 || password == 0:
    ret 0 as str
  if tezzdb.tables.table_exists(db, "users") == 0:
    ret 0 as str
  rows:str = query_where(db, "users", "username", user)
  if rows == 0:
    ret 0 as str
  stored_hash:str = row_get_str(rows, "password_hash")
  free(rows)
  if stored_hash == 0:
    ret 0 as str
  ok:int = tezzdb.auth.password_verify(password, stored_hash)
  free(stored_hash)
  if ok != 1:
    ret 0 as str
  token:str = tezzdb.auth.random_token()
  if token == 0:
    ret 0 as str
  token_hash:str = tezzdb.auth.token_hash(token)
  if token_hash == 0:
    free(token)
    ret 0 as str
  if tezzdb.tables.table_exists(db, "sessions") == 0:
    if tezzdb.tables.table_create(db, "sessions") < 0:
      free(token_hash)
      free(token)
      ret 0 as str
  expires_at:str = tezzdb.storage._db_itoa(time.now() + 3600)
  row:str = row_json3("token_hash", token_hash, "username", user, "expires_at", expires_at)
  free(expires_at)
  free(token_hash)
  if row == 0:
    free(token)
    ret 0 as str
  result:int = tezzdb.tables.insert(db, "sessions", row)
  free(row)
  if result < 0:
    free(token)
    ret 0 as str
  ret token

fn user_from_token(db:*TezzDb, token:str) -> str:
  if db == 0 || token == 0:
    ret 0 as str
  if tezzdb.tables.table_exists(db, "sessions") == 0:
    ret 0 as str
  token_hash:str = tezzdb.auth.token_hash(token)
  if token_hash == 0:
    ret 0 as str
  rows:str = query_where(db, "sessions", "token_hash", token_hash)
  free(token_hash)
  if rows == 0:
    ret 0 as str
  expires:str = row_get_str(rows, "expires_at")
  if expires == 0 || len(expires) == 0 || len(expires) > 12:
    if expires != 0: free(expires)
    free(rows)
    ret 0 as str
  expires_at:int = 0
  i:int = 0
  while expires[i] != 0:
    digit:int = expires[i] as int
    if digit < 48 || digit > 57:
      free(expires)
      free(rows)
      ret 0 as str
    expires_at = expires_at * 10 + digit - 48
    i = i + 1
  free(expires)
  if expires_at <= time.now():
    free(rows)
    ret 0 as str
  user:str = row_get_str(rows, "username")
  free(rows)
  ret user

// ─────────────────────────────────────────────────────────────
// Database info / diagnostics
// ─────────────────────────────────────────────────────────────

fn db_page_count(db:*TezzDb) -> int:
  if db == 0: ret 0
  ret (*db).page_count

fn db_table_count(db:*TezzDb) -> int:
  if db == 0: ret 0
  ret (*db).table_count

fn db_size_bytes(db:*TezzDb) -> int:
  if db == 0: ret 0
  ret (*db).page_count * tezzdb.state._get_DB_PAGE_SIZE()

fn db_table_name(db:*TezzDb, idx:int) -> str:
  if db == 0 || idx < 0 || idx >= (*db).table_count: ret 0 as str
  ret (*db).tables[idx].name

fn db_path(db:*TezzDb) -> str:
  if db == 0: ret 0 as str
  ret (*db).path

fn db_print_info(db:*TezzDb) -> int:
  if db == 0: ret tezzdb.state._get_TEZZDB_ERR()
  say "TezzDB 2.0 Info:"
  say "  path: ", db_path(db)
  say "  pages: ", db_page_count(db), " (", db_size_bytes(db) / 1024, " KB)"
  say "  tables: ", db_table_count(db)
  i:int = 0
  while i < (*db).table_count:
    say "    [", i, "] ", (*db).tables[i].name, " rows=", (*db).tables[i].row_count
    i = i + 1
  ret tezzdb.state._get_TEZZDB_OK()

// ─────────────────────────────────────────────────────────────
// Integer-handle API — use plain int handles to avoid cross-module
// typed-pointer constraints in test and user code.
// ─────────────────────────────────────────────────────────────

fn db_open(path:str) -> *char:
  db:*TezzDb = tezzdb.tables.open(path)
  ret db as *char

fn db_close(h:*char) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.close(h as *TezzDb)

fn db_table_create(h:*char, name:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.table_create(h as *TezzDb, name)

fn db_table_drop(h:*char, name:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.table_drop(h as *TezzDb, name)

fn db_table_exists(h:*char, name:str) -> int:
  if h == 0 as *char: ret 0
  ret tezzdb.tables.table_exists(h as *TezzDb, name)

fn db_table_row_count(h:*char, name:str) -> int:
  if h == 0 as *char: ret 0
  ret tezzdb.tables.table_row_count(h as *TezzDb, name)

fn db_table_index_create(h:*char, table:str, col:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.table_index_create(h as *TezzDb, table, col)

fn db_begin(h:*char) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.begin(h as *TezzDb)

fn db_commit(h:*char) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.commit(h as *TezzDb)

fn db_rollback(h:*char) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.rollback(h as *TezzDb)

fn db_insert(h:*char, table:str, data:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.insert(h as *TezzDb, table, data)

fn db_insert_pk(h:*char, table:str, pk:int, data:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.insert_pk(h as *TezzDb, table, pk, data)

fn db_get(h:*char, table:str, pk:int) -> str:
  if h == 0 as *char: ret 0 as str
  ret tezzdb.tables.get(h as *TezzDb, table, pk)

fn db_update(h:*char, table:str, pk:int, new_data:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.update(h as *TezzDb, table, pk, new_data)

fn db_delete(h:*char, table:str, pk:int) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret tezzdb.tables.delete(h as *TezzDb, table, pk)

fn db_query_all(h:*char, table:str) -> str:
  if h == 0 as *char: ret 0 as str
  ret query_all(h as *TezzDb, table)

fn db_query_where(h:*char, table:str, field:str, value:str) -> str:
  if h == 0 as *char: ret 0 as str
  ret query_where(h as *TezzDb, table, field, value)

fn db_query_range(h:*char, table:str, pk_min:int, pk_max:int) -> str:
  if h == 0 as *char: ret 0 as str
  ret query_range(h as *TezzDb, table, pk_min, pk_max)

fn db_info(h:*char) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret db_print_info(h as *TezzDb)

fn db_register_user(h:*char, user:str, password:str) -> int:
  if h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret register_user(h as *TezzDb, user, password)

fn db_login_token(h:*char, user:str, password:str) -> str:
  if h == 0 as *char: ret 0 as str
  ret login_token(h as *TezzDb, user, password)

fn db_user_from_token(h:*char, token:str) -> str:
  if h == 0 as *char: ret 0 as str
  ret user_from_token(h as *TezzDb, token)

fn db_cursor_open(h:*char, table:str) -> *char:
  if h == 0 as *char: ret 0 as *char
  cur:*DbCursor = cursor_open(h as *TezzDb, table)
  ret cur as *char

fn db_cursor_range(h:*char, table:str, pk_min:int, pk_max:int) -> *char:
  if h == 0 as *char: ret 0 as *char
  cur:*DbCursor = cursor_range(h as *TezzDb, table, pk_min, pk_max)
  ret cur as *char

fn db_cursor_next(cur_h:*char) -> str:
  if cur_h == 0: ret 0 as str
  cur:*DbCursor = cur_h as *DbCursor
  row:*DbRow = cursor_next(cur)
  if row == 0: ret 0 as str
  number:str = tezzdb.storage._db_itoa((*row).pk)
  out:str = tezzdb.storage._db_join2("{\"_pk\":", number)
  free(number)
  data:str = (*row).data
  length:int = len(data)
  if length >= 2 && data[0] == 123 as char && data[length - 1] == 125 as char:
    if length > 2:
      inside:*char = malloc(length - 1)
      if inside == 0:
        free(out)
        out = 0 as str
      else:
        memcpy(inside, (data as *char) + 1, length - 2)
        inside[length - 2] = 0 as char
        out = _db_json_append_owned(out, ",")
        out = _db_json_append_owned(out, inside as str)
        free(inside)
  else:
    quoted:str = _db_json_quote(data)
    out = _db_json_append_owned(out, ",\"data\":")
    out = _db_json_append_owned(out, quoted)
    free(quoted)
  out = _db_json_append_owned(out, "}")
  row_free(row)
  if out == 0: (*cur).error = 1
  ret out

fn db_cursor_close(cur_h:*char) -> int:
  if cur_h == 0 as *char: ret tezzdb.state._get_TEZZDB_ERR()
  ret cursor_close(cur_h as *DbCursor)
