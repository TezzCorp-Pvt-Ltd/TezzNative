// lib/optim.tn - Modern Deep Learning Optimizers & LR Schedulers for TezzNative
// Implements AdamW, SGD with Momentum, Gradient Clipping, and Cosine Schedules.

import "tensor"
import "math"

// ============================================================
// 1. Learning Rate Schedulers
// ============================================================

// Cosine Annealing Schedule: lr = min_lr + 0.5 * (base_lr - min_lr) * (1 + cos(pi * step / total_steps))
fn lr_cosine_schedule(base_lr:float, min_lr:float, current_step:int, total_steps:int) -> float:
  if current_step < 0: current_step = 0
  if total_steps <= 0: ret min_lr
  if current_step >= total_steps:
    ret min_lr
  progress:float = (current_step as float) / (total_steps as float)
  cosine_val:float = math.cos(math.PI() * progress)
  factor:float = 0.5 * (1.0 + cosine_val)
  ret min_lr + (base_lr - min_lr) * factor

// Linear Schedule with Min LR
fn lr_linear_schedule(base_lr:float, min_lr:float, current_step:int, total_steps:int) -> float:
  if current_step >= total_steps:
    ret min_lr
  progress:float = (current_step as float) / (total_steps as float)
  ret base_lr - (base_lr - min_lr) * progress

// Warmup + Cosine Decay Schedule
fn lr_warmup_cosine(base_lr:float, min_lr:float, warmup_steps:int, current_step:int, total_steps:int) -> float:
  if current_step < warmup_steps:
    if warmup_steps <= 0:
      ret base_lr
    ret base_lr * ((current_step as float) / (warmup_steps as float))
  remain_step:int = current_step - warmup_steps
  remain_total:int = total_steps - warmup_steps
  ret lr_cosine_schedule(base_lr, min_lr, remain_step, remain_total)


// ============================================================
// 2. Gradient Norm Clipping
// ============================================================

// Clips gradient of a single tensor by max_norm
fn clip_grad_tensor(t:Tensor, max_norm:float) -> float:
  if t.grad == 0 as *Tensor: ret 0.0
  ret grad_clip_norm(t.grad.data, t.grad.size, max_norm)


// ============================================================
// 3. SGD (Stochastic Gradient Descent with Momentum & Weight Decay)
// ============================================================

// In-place SGD update for a parameter tensor with its velocity buffer:
// v = momentum * v + grad + weight_decay * param
// param = param - lr * v
fn sgd_step(param:Tensor, vel:Tensor, lr:float, momentum:float, weight_decay:float) -> int:
  if lr < 0.0 || momentum < 0.0 || momentum >= 1.0 || weight_decay < 0.0: ret 0 - 1
  if param.grad != 0 as *Tensor:
    if vel.size != param.size || vel.data == 0 as *float || param.data == 0 as *float || param.grad.size != param.size || param.grad.data == 0 as *float: ret 0 - 1
  unsafe:
    if param.grad == 0 as *Tensor:
      ret 0
    g:*Tensor = param.grad
    p_data:*float = param.data
    g_data:*float = (*g).data
    v_data:*float = vel.data

    i:int = 0
    while i < param.size:
      p_off:int = tensor._tensor_unravel_offset(param, i)
      g_off:int = tensor._tensor_unravel_offset(*g, i)
      v_off:int = tensor._tensor_unravel_offset(vel, i)

      pv:float = p_data[p_off]
      gv:float = g_data[g_off]
      vv:float = v_data[v_off]

      if weight_decay > 0.0:
        gv = gv + weight_decay * pv

      if momentum > 0.0:
        vv = momentum * vv + gv
        v_data[v_off] = vv
        p_data[p_off] = pv - lr * vv
      else:
        p_data[p_off] = pv - lr * gv

      i = i + 1
  ret 0


// ============================================================
// 4. AdamW (Decoupled Weight Decay Adaptive Moment Estimation)
// ============================================================

// In-place AdamW update for a parameter tensor:
// param = param * (1 - lr * weight_decay)
// m = beta1 * m + (1 - beta1) * grad
// v = beta2 * v + (1 - beta2) * (grad ^ 2)
// param = param - (lr * m_hat) / (sqrt(v_hat) + eps)
fn adamw_step(param:Tensor, m_buf:Tensor, v_buf:Tensor, step:int, lr:float, beta1:float, beta2:float, eps:float, weight_decay:float) -> int:
  if step <= 0 || lr < 0.0 || beta1 < 0.0 || beta1 >= 1.0 || beta2 < 0.0 || beta2 >= 1.0 || eps <= 0.0 || weight_decay < 0.0: ret 0 - 1
  if param.grad != 0 as *Tensor:
    if m_buf.size != param.size || v_buf.size != param.size || m_buf.data == 0 as *float || v_buf.data == 0 as *float || param.data == 0 as *float || param.grad.size != param.size || param.grad.data == 0 as *float: ret 0 - 1
  unsafe:
    if param.grad == 0 as *Tensor || step <= 0:
      ret 0
    g:*Tensor = param.grad
    p_data:*float = param.data
    g_data:*float = (*g).data
    m_data:*float = m_buf.data
    v_data:*float = v_buf.data

    bc1:float = 1.0 - math.pow(beta1, step as float)
    bc2:float = 1.0 - math.pow(beta2, step as float)
    if bc1 <= 0.0: bc1 = 1.0e-8
    if bc2 <= 0.0: bc2 = 1.0e-8
    inv_bc1:float = 1.0 / bc1
    inv_bc2:float = 1.0 / bc2

    one_minus_b1:float = 1.0 - beta1
    one_minus_b2:float = 1.0 - beta2
    decay_factor:float = 1.0 - lr * weight_decay

    i:int = 0
    while i < param.size:
      p_off:int = tensor._tensor_unravel_offset(param, i)
      g_off:int = tensor._tensor_unravel_offset(*g, i)
      m_off:int = tensor._tensor_unravel_offset(m_buf, i)
      v_off:int = tensor._tensor_unravel_offset(v_buf, i)

      pv:float = p_data[p_off]
      gv:float = g_data[g_off]
      mv:float = m_data[m_off]
      vv:float = v_data[v_off]

      // Decoupled weight decay
      if weight_decay > 0.0:
        pv = pv * decay_factor

      // Update 1st and 2nd moments
      mv = beta1 * mv + one_minus_b1 * gv
      vv = beta2 * vv + one_minus_b2 * (gv * gv)
      m_data[m_off] = mv
      v_data[v_off] = vv

      // Bias correction
      m_hat:float = mv * inv_bc1
      v_hat:float = vv * inv_bc2

      // Parameter update
      pv = pv - (lr * m_hat) / (math.sqrt(v_hat) + eps)
      p_data[p_off] = pv

      i = i + 1
  ret 0

// Flat f64 optimizer states used by ai/grad. Tensor overloads above retain their
// original signatures; these helpers use explicit raw parameter/gradient slabs.
fn alloc_state(n:int) -> *float:
  if n <= 0 || n > 1152921504606846975: ret 0 as *float
  values:*float = (*float)malloc(n * 8)
  if values == 0 as *float: ret values
  zero_state(values, n)
  ret values

fn free_state(state:*float) -> int:
  free(state as *char)
  ret 0

fn zero_state(state:*float, n:int) -> int:
  if state == 0 as *float || n < 0: ret 0 - 1
  i:int = 0
  while i < n:
    state[i] = 0.0
    i = i + 1
  ret 0

fn _optim_finite(value:float) -> int:
  ret value == value && (value - value) == 0.0

fn grad_norm(values:*float, n:int) -> float:
  if values == 0 as *float || n <= 0: ret 0.0
  largest:float = 0.0
  i:int = 0
  while i < n:
    value:float = math.absf(values[i])
    if _optim_finite(value) == 0: ret value
    if value > largest: largest = value
    i = i + 1
  if largest == 0.0: ret 0.0
  sum:float = 0.0
  i = 0
  while i < n:
    ratio:float = values[i] / largest
    sum = sum + ratio * ratio
    i = i + 1
  ret largest * math.sqrt(sum)

fn grad_clip_norm(values:*float, n:int, max_norm:float) -> float:
  norm:float = grad_norm(values, n)
  if values == 0 as *float || n <= 0 || max_norm < 0.0 || _optim_finite(max_norm) == 0: ret norm
  if norm > max_norm && _optim_finite(norm) != 0:
    factor:float = max_norm / norm
    i:int = 0
    while i < n:
      values[i] = values[i] * factor
      i = i + 1
  ret norm

fn grad_clip_value(values:*float, n:int, maximum:float) -> int:
  if values == 0 as *float || n < 0 || maximum < 0.0 || _optim_finite(maximum) == 0: ret 0 - 1
  i:int = 0
  while i < n:
    if values[i] > maximum: values[i] = maximum
    if values[i] < 0.0 - maximum: values[i] = 0.0 - maximum
    i = i + 1
  ret 0

fn sgd_simple(params:*float, grads:*float, n:int, lr:float) -> int:
  if params == 0 as *float || grads == 0 as *float || n <= 0 || lr < 0.0 || _optim_finite(lr) == 0: ret 0 - 1
  i:int = 0
  while i < n:
    if _optim_finite(grads[i]) == 0: ret 0 - 1
    i = i + 1
  i = 0
  while i < n:
    params[i] = params[i] - lr * grads[i]
    i = i + 1
  ret 0

fn _adam_raw(params:*float, grads:*float, m:*float, v:*float, n:int, lr:float, step:int, decay:float) -> int:
  if params == 0 as *float || grads == 0 as *float || m == 0 as *float || v == 0 as *float || n <= 0 || step <= 0 || lr < 0.0 || _optim_finite(lr) == 0: ret 0 - 1
  i:int = 0
  while i < n:
    if _optim_finite(grads[i]) == 0: ret 0 - 1
    i = i + 1
  bc1:float = 1.0 - math.pow(0.9, step as float)
  bc2:float = 1.0 - math.pow(0.999, step as float)
  i = 0
  while i < n:
    m[i] = 0.9 * m[i] + 0.1 * grads[i]
    v[i] = 0.999 * v[i] + 0.001 * grads[i] * grads[i]
    update:float = (m[i] / bc1) / (math.sqrt(v[i] / bc2) + 0.00000001)
    params[i] = params[i] * (1.0 - lr * decay) - lr * update
    i = i + 1
  ret 0

fn adam_default(params:*float, grads:*float, m1:*float, m2:*float, n:int, lr:float, step:int) -> int:
  ret _adam_raw(params, grads, m1, m2, n, lr, step, 0.0)

fn adamw_default(params:*float, grads:*float, m1:*float, m2:*float, n:int, lr:float, step:int) -> int:
  ret _adam_raw(params, grads, m1, m2, n, lr, step, 0.01)

struct AdamState:
  m:Tensor
  v:Tensor
  length:int
  step:int
  beta1:float
  beta2:float
  eps:float

fn adam_init(length:int, beta1:float, beta2:float, eps:float) -> AdamState:
  state:AdamState
  state.m = tensor.tensor_zeros_1d(length)
  state.v = tensor.tensor_zeros_1d(length)
  state.length = length
  state.step = 0
  state.beta1 = beta1
  state.beta2 = beta2
  state.eps = eps
  ret state

fn adam_free(state:AdamState) -> int:
  tensor.tensor_free_tensor(state.m)
  tensor.tensor_free_tensor(state.v)
  ret 0

fn adam_step(param:*Tensor, state:*AdamState, lr:float) -> int:
  if param == 0 as *Tensor || state == 0 as *AdamState: ret 0 - 1
  if param.size != state.length || state.m.size != param.size || state.v.size != param.size: ret 0 - 1
  if param.grad == 0 as *Tensor: ret 0
  next_step:int = state.step + 1
  status:int = adamw_step(*param, state.m, state.v, next_step, lr, state.beta1, state.beta2, state.eps, 0.0)
  if status == 0: state.step = next_step
  ret status

fn sgd_tensor_simple(param:*Tensor, lr:float) -> int:
  if param == 0 as *Tensor || lr < 0.0 || _optim_finite(lr) == 0: ret 0 - 1
  if param.grad == 0 as *Tensor: ret 0
  if param.grad.size != param.size || param.grad.data == 0 as *float || param.data == 0 as *float: ret 0 - 1
  i:int = 0
  while i < param.size:
    offset:int = tensor._tensor_unravel_offset(*param, i)
    param.data[offset] = param.data[offset] - lr * param.grad.data[i]
    i = i + 1
  ret 0

fn sgd_step_simd(param:*Tensor, lr:float) -> int:
  ret sgd_tensor_simple(param, lr)
