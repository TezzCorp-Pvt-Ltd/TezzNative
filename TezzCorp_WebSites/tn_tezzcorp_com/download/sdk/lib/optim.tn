// lib/optim.tn - Modern Deep Learning Optimizers & LR Schedulers for TezzNative
// Implements AdamW, SGD with Momentum, Gradient Clipping, and Cosine Schedules.

import "tensor"
import "math"
import "autograd"

// ============================================================
// 1. Learning Rate Schedulers
// ============================================================

// Cosine Annealing Schedule: lr = min_lr + 0.5 * (base_lr - min_lr) * (1 + cos(pi * step / total_steps))
fn lr_cosine_schedule(base_lr:float, min_lr:float, current_step:int, total_steps:int) -> float:
  if current_step >= total_steps:
    ret min_lr
  progress:float = (current_step as float) / (total_steps as float)
  cosine_val:float = math.cos(math.PI() * progress)
  factor:float = 0.5 * (1.0 + cosine_val)
  ret min_lr + (base_lr - min_lr) * factor

// Linear Schedule with Min LR
fn lr_linear_schedule(base_lr:float, min_lr:float, current_step:int, total_steps:int) -> float:
  if current_step >= total_steps:
    ret min_lr
  progress:float = (current_step as float) / (total_steps as float)
  ret base_lr - (base_lr - min_lr) * progress

// Warmup + Cosine Decay Schedule
fn lr_warmup_cosine(base_lr:float, min_lr:float, warmup_steps:int, current_step:int, total_steps:int) -> float:
  if current_step < warmup_steps:
    if warmup_steps <= 0:
      ret base_lr
    ret base_lr * ((current_step as float) / (warmup_steps as float))
  remain_step:int = current_step - warmup_steps
  remain_total:int = total_steps - warmup_steps
  ret lr_cosine_schedule(base_lr, min_lr, remain_step, remain_total)


// ============================================================
// 2. Gradient Norm Clipping
// ============================================================

// Clips gradient of a single tensor by max_norm
fn clip_grad_tensor(t:Tensor, max_norm:float) -> float:
  unsafe:
    if t.grad == 0 as *Tensor:
      ret 0.0
    g:*Tensor = t.grad
    sq_sum:float = 0.0
    i:int = 0
    while i < (*g).size:
      v:float = (*g).data[i]
      sq_sum = sq_sum + v * v
      i = i + 1
    total_norm:float = math.sqrt(sq_sum)
    if total_norm > max_norm && total_norm > 0.0:
      scale:float = max_norm / (total_norm + 1.0e-6)
      i = 0
      while i < (*g).size:
        (*g).data[i] = (*g).data[i] * scale
        i = i + 1
    ret total_norm


// ============================================================
// 3. SGD (Stochastic Gradient Descent with Momentum & Weight Decay)
// ============================================================

// In-place SGD update for a parameter tensor with its velocity buffer:
// v = momentum * v + grad + weight_decay * param
// param = param - lr * v
fn sgd_step(param:Tensor, vel:Tensor, lr:float, momentum:float, weight_decay:float) -> int:
  unsafe:
    if param.grad == 0 as *Tensor:
      ret 0
    g:*Tensor = param.grad
    p_data:*float = param.data
    g_data:*float = (*g).data
    v_data:*float = vel.data

    i:int = 0
    while i < param.size:
      p_off:int = tensor._tensor_unravel_offset(param, i)
      g_off:int = tensor._tensor_unravel_offset(*g, i)
      v_off:int = tensor._tensor_unravel_offset(vel, i)

      pv:float = p_data[p_off]
      gv:float = g_data[g_off]
      vv:float = v_data[v_off]

      if weight_decay > 0.0:
        gv = gv + weight_decay * pv

      if momentum > 0.0:
        vv = momentum * vv + gv
        v_data[v_off] = vv
        p_data[p_off] = pv - lr * vv
      else:
        p_data[p_off] = pv - lr * gv

      i = i + 1
  ret 0


// ============================================================
// 4. AdamW (Decoupled Weight Decay Adaptive Moment Estimation)
// ============================================================

// In-place AdamW update for a parameter tensor:
// param = param * (1 - lr * weight_decay)
// m = beta1 * m + (1 - beta1) * grad
// v = beta2 * v + (1 - beta2) * (grad ^ 2)
// param = param - (lr * m_hat) / (sqrt(v_hat) + eps)
fn adamw_step(param:Tensor, m_buf:Tensor, v_buf:Tensor, step:int, lr:float, beta1:float, beta2:float, eps:float, weight_decay:float) -> int:
  unsafe:
    if param.grad == 0 as *Tensor || step <= 0:
      ret 0
    g:*Tensor = param.grad
    p_data:*float = param.data
    g_data:*float = (*g).data
    m_data:*float = m_buf.data
    v_data:*float = v_buf.data

    bc1:float = 1.0 - math.pow(beta1, step as float)
    bc2:float = 1.0 - math.pow(beta2, step as float)
    if bc1 <= 0.0: bc1 = 1.0e-8
    if bc2 <= 0.0: bc2 = 1.0e-8
    inv_bc1:float = 1.0 / bc1
    inv_bc2:float = 1.0 / bc2

    one_minus_b1:float = 1.0 - beta1
    one_minus_b2:float = 1.0 - beta2
    decay_factor:float = 1.0 - lr * weight_decay

    i:int = 0
    while i < param.size:
      p_off:int = tensor._tensor_unravel_offset(param, i)
      g_off:int = tensor._tensor_unravel_offset(*g, i)
      m_off:int = tensor._tensor_unravel_offset(m_buf, i)
      v_off:int = tensor._tensor_unravel_offset(v_buf, i)

      pv:float = p_data[p_off]
      gv:float = g_data[g_off]
      mv:float = m_data[m_off]
      vv:float = v_data[v_off]

      // Decoupled weight decay
      if weight_decay > 0.0:
        pv = pv * decay_factor

      // Update 1st and 2nd moments
      mv = beta1 * mv + one_minus_b1 * gv
      vv = beta2 * vv + one_minus_b2 * (gv * gv)
      m_data[m_off] = mv
      v_data[v_off] = vv

      // Bias correction
      m_hat:float = mv * inv_bc1
      v_hat:float = vv * inv_bc2

      // Parameter update
      pv = pv - (lr * m_hat) / (math.sqrt(v_hat) + eps)
      p_data[p_off] = pv

      i = i + 1
  ret 0
