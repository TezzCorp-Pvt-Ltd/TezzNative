// Preserve stored fields and use actual cursor primary keys for mutations.
import "tezzdb"
import "tezzdb.queries"
import "tezzdbql.state"
import "tezzdbql.parser"

fn slice(text:str, start:int, end:int) -> str:
  if text == 0 || start < 0 || end < start || end > len(text): ret 0 as str
  out:*char = malloc(end - start + 1)
  if out == 0: ret 0 as str
  i:int = 0
  while i < end - start:
    out[i] = text[start + i]
    i = i + 1
  out[i] = 0 as char
  ret out as str

fn value_end(json:str, start:int) -> int:
  n:int = len(json)
  if start < 0 || start >= n: ret -1
  if json[start] == '"':
    ending:int = start
    decoded:str = tezzdb.queries._db_json_decode(json, start, &ending)
    if decoded == 0: ret -1
    free(decoded)
    ret ending
  stack:[char;128]
  depth:int = 0
  position:int = start
  while position < n:
    c:int = json[position] as int
    if c == 34:
      ending:int = position
      decoded:str = tezzdb.queries._db_json_decode(json, position, &ending)
      if decoded == 0: ret -1
      free(decoded)
      position = ending
    else if c == 123 || c == 91:
      if depth >= 128: ret -1
      stack[depth] = c as char
      depth = depth + 1
      position = position + 1
    else if c == 125 || c == 93:
      if depth == 0: break
      expected:int = 123
      if c == 93: expected = 91
      if (stack[depth - 1] as int) != expected: ret -1
      depth = depth - 1
      position = position + 1
      if depth == 0: break
    else:
      if depth == 0 && (c == 44 || tezzdbql.parser._ql_isspace(c) != 0): break
      position = position + 1
  if depth != 0 || position <= start: ret -1
  ret position

fn matches(statement:*TzQlStatement, row:*DbRow) -> int:
  if statement[0].has_where == 0: ret 1
  column:str = statement[0].where_column
  expected:str = statement[0].where_value
  if strcmp(column, "id") == 0 || strcmp(column, "pk") == 0 || strcmp(column, "_pk") == 0:
    pk:int = -1
    ending:int = 0
    if tezzdbql.parser._ql_read_number(expected, 0, &pk, &ending) == 0: ret 0
    ret ending == len(expected) && pk == row[0].pk
  actual:str = tezzdb.row_get_str(row[0].data, column)
  if actual != 0:
    result:int = strcmp(actual, expected) == 0
    free(actual)
    ret result
  offset:int = tezzdb._json_find_key(row[0].data, column)
  if offset < 0: ret 0
  ending:int = value_end(row[0].data, offset)
  if ending < 0: ret 0
  actual = slice(row[0].data, offset, ending)
  result:int = actual != 0 && strcmp(actual, expected) == 0
  free(actual)
  ret result

fn merge(json:str, statement:*TzQlStatement) -> str:
  if json == 0: ret 0 as str
  position:int = tezzdbql.parser._ql_skip_spaces(json, 0)
  if position >= len(json) || json[position] != '{': ret 0 as str
  position = tezzdbql.parser._ql_skip_spaces(json, position + 1)
  out:str = tezzdbql.parser._ql_strdup("{")
  if out == 0: ret 0 as str
  applied:[int;32]
  i:int = 0
  while i < 32:
    applied[i] = 0
    i = i + 1
  fields:int = 0
  if position < len(json) && json[position] == '}':
    position = position + 1
  else:
    while 1:
      key_start:int = position
      key_end:int = position
      key:str = tezzdb.queries._db_json_decode(json, position, &key_end)
      if key == 0:
        free(out)
        ret 0 as str
      position = tezzdbql.parser._ql_skip_spaces(json, key_end)
      if position >= len(json) || json[position] != ':':
        free(key)
        free(out)
        ret 0 as str
      position = tezzdbql.parser._ql_skip_spaces(json, position + 1)
      ending:int = value_end(json, position)
      if ending < 0:
        free(key)
        free(out)
        ret 0 as str
      if fields > 0: out = tezzdb.queries._db_json_append_owned(out, ",")
      prefix:str = slice(json, key_start, position)
      out = tezzdb.queries._db_json_append_owned(out, prefix)
      free(prefix)
      replacement:int = -1
      i = 0
      while i < statement[0].count:
        if strcmp(key, statement[0].columns[i]) == 0: replacement = i
        i = i + 1
      free(key)
      part:str = 0 as str
      if replacement >= 0:
        part = tezzdb.queries._db_json_quote(statement[0].values[replacement])
        applied[replacement] = 1
      else:
        part = slice(json, position, ending)
      out = tezzdb.queries._db_json_append_owned(out, part)
      free(part)
      if out == 0: ret 0 as str
      fields = fields + 1
      position = tezzdbql.parser._ql_skip_spaces(json, ending)
      if position < len(json) && json[position] == '}':
        position = position + 1
        break
      if position >= len(json) || json[position] != ',':
        free(out)
        ret 0 as str
      position = tezzdbql.parser._ql_skip_spaces(json, position + 1)
  if tezzdbql.parser._ql_skip_spaces(json, position) != len(json):
    free(out)
    ret 0 as str
  i = 0
  while i < statement[0].count:
    if applied[i] == 0:
      if fields > 0: out = tezzdb.queries._db_json_append_owned(out, ",")
      pair:str = tezzdb.queries._db_json_pair(statement[0].columns[i], statement[0].values[i])
      out = tezzdb.queries._db_json_append_owned(out, pair)
      free(pair)
      if out == 0: ret 0 as str
      fields = fields + 1
    i = i + 1
  ret tezzdb.queries._db_json_append_owned(out, "}")

fn collect_keys(db:*TezzDb, statement:*TzQlStatement, count:*int) -> *int:
  count[0] = -1
  cursor:*DbCursor = tezzdb.cursor_open(db, statement[0].table)
  if cursor == 0: ret 0 as *int
  capacity:int = 16
  keys:*int = (*int)malloc(capacity * 8)
  if keys == 0:
    tezzdb.cursor_close(cursor)
    ret 0 as *int
  used:int = 0
  while 1:
    row:*DbRow = tezzdb.cursor_next(cursor)
    if row == 0: break
    if matches(statement, row) != 0:
      if used == capacity:
        if capacity > 576460752303423487:
          tezzdb.row_free(row)
          tezzdb.cursor_close(cursor)
          free(keys)
          ret 0 as *int
        expanded:*int = (*int)malloc(capacity * 16)
        if expanded == 0:
          tezzdb.row_free(row)
          tezzdb.cursor_close(cursor)
          free(keys)
          ret 0 as *int
        memcpy(expanded as *char, keys as *char, used * 8)
        free(keys)
        keys = expanded
        capacity = capacity * 2
      keys[used] = row[0].pk
      used = used + 1
    tezzdb.row_free(row)
  failed:int = cursor[0].error
  tezzdb.cursor_close(cursor)
  if failed != 0:
    free(keys)
    ret 0 as *int
  count[0] = used
  ret keys

fn execute(db:*TezzDb, statement:*TzQlStatement) -> int:
  count:int = 0
  keys:*int = collect_keys(db, statement, &count)
  if keys == 0: ret -1
  owns_transaction:int = db[0].in_tx == 0
  if owns_transaction != 0 && tezzdb.begin(db) != 0:
    free(keys)
    ret -1
  i:int = 0
  status:int = 0
  while i < count:
    if statement[0].kind == 4:
      status = tezzdb.delete(db, statement[0].table, keys[i])
    else:
      previous:str = tezzdb.get(db, statement[0].table, keys[i])
      changed:str = merge(previous, statement)
      free(previous)
      if changed == 0:
        status = -1
      else:
        status = tezzdb.update(db, statement[0].table, keys[i], changed)
        free(changed)
        // TezzDB update returns the nonnegative primary key on success.
        if status >= 0: status = 0
    if status != 0: break
    i = i + 1
  free(keys)
  if owns_transaction != 0:
    if status == 0:
      status = tezzdb.commit(db)
    if status != 0 && db[0].in_tx != 0: tezzdb.rollback(db)
  if status != 0: ret status
  ret count
