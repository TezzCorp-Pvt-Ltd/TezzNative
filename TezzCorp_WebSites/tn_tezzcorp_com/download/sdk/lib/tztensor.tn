// lib/tztensor.tn -- TezzNative First-Class Tensor System v2.2
// High-performance, unified-device tensor operations wrapping native SIMD & CUDA kernels.

import "tzcpu"
import "tzgpu"
import "tzautodiff"

let DEVICE_CPU: int = 0
let DEVICE_GPU: int = 1

let GPU_H2D: int = 1
let GPU_D2H: int = 2

// ── Tensor Field Accessors ───────────────────────────────────────────────────
// Memory Layout (80 bytes allocated on heap):
// [0] = data_ptr
// [1] = grad_ptr
// [2] = ndim
// [3] = d0 (batch)
// [4] = d1 (channels / seq_len)
// [5] = d2 (height / hid_dim)
// [6] = d3 (width)
// [7] = numel
// [8] = device (DEVICE_CPU=0, DEVICE_GPU=1)
// [9] = requires_grad (1=true, 0=false)

fn tensor_data(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[0]
  ret val

fn tensor_grad(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[1]
  ret val

fn tensor_ndim(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[2]
  ret val

fn tensor_d0(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[3]
  ret val

fn tensor_d1(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[4]
  ret val

fn tensor_d2(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[5]
  ret val

fn tensor_d3(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[6]
  ret val

fn tensor_numel(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[7]
  ret val

fn tensor_device(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[8]
  ret val

fn tensor_requires_grad(t: int) -> int:
  if t == 0: ret 0
  val: int = 0
  unsafe:
    val = (t as *int)[9]
  ret val

fn tensor_set_requires_grad(t:int, req:int) -> int:
  if t == 0: ret 0 - 1
  unsafe:
    if req != 0 && (t as *int)[1] == 0:
      gradient:int = 0
      if tensor_device(t) == DEVICE_GPU:
        gradient = tzgpu.gpu_zeros_f32(tensor_numel(t))
      else:
        gradient = tzcpu.tz_cpu_zeros(tensor_numel(t))
      if gradient == 0: ret 0 - 1
      (t as *int)[1] = gradient
    (t as *int)[9] = req
  ret 0

// ── Constructors ─────────────────────────────────────────────────────────────

fn _tensor_new(ndim:int, d0:int, d1:int, d2:int, d3:int, requires_grad:int) -> int:
  if d0 <= 0 || d1 <= 0 || d2 <= 0 || d3 <= 0: ret 0
  numel:int = d0
  if numel > 2305843009213693951 / d1: ret 0
  numel = numel * d1
  if numel > 2305843009213693951 / d2: ret 0
  numel = numel * d2
  if numel > 2305843009213693951 / d3: ret 0
  numel = numel * d3
  t:int = tzcpu.tz_cpu_malloc(80)
  data:int = tzcpu.tz_cpu_zeros(numel)
  grad:int = 0
  req:int = 0
  if requires_grad != 0:
    req = 1
    grad = tzcpu.tz_cpu_zeros(numel)
  if t == 0 || data == 0 || (req != 0 && grad == 0):
    tzcpu.tz_cpu_free(t)
    tzcpu.tz_cpu_free(data)
    tzcpu.tz_cpu_free(grad)
    ret 0
  unsafe:
    fields:*int = t as *int
    fields[0] = data
    fields[1] = grad
    fields[2] = ndim
    fields[3] = d0
    fields[4] = d1
    fields[5] = d2
    fields[6] = d3
    fields[7] = numel
    fields[8] = DEVICE_CPU
    fields[9] = req
  ret t

fn tensor_new_1d(d0:int, requires_grad:int) -> int:
  ret _tensor_new(1, d0, 1, 1, 1, requires_grad)

fn tensor_new_2d(d0:int, d1:int, requires_grad:int) -> int:
  ret _tensor_new(2, d0, d1, 1, 1, requires_grad)

fn tensor_new_3d(d0:int, d1:int, d2:int, requires_grad:int) -> int:
  ret _tensor_new(3, d0, d1, d2, 1, requires_grad)

fn tensor_new_4d(d0:int, d1:int, d2:int, d3:int, requires_grad:int) -> int:
  ret _tensor_new(4, d0, d1, d2, d3, requires_grad)

fn tensor_zeros_1d(d0: int) -> int:
  ret tensor_new_1d(d0, 0)

fn tensor_zeros_2d(d0: int, d1: int) -> int:
  ret tensor_new_2d(d0, d1, 0)

fn tensor_zeros_3d(d0: int, d1: int, d2: int) -> int:
  ret tensor_new_3d(d0, d1, d2, 0)

fn tensor_zeros_4d(d0: int, d1: int, d2: int, d3: int) -> int:
  ret tensor_new_4d(d0, d1, d2, d3, 0)

fn tensor_xavier_2d(d0: int, d1: int, fan_in: int, seed: int) -> int:
  t: int = tensor_new_2d(d0, d1, 1)
  data_p: int = tensor_data(t)
  numel: int = tensor_numel(t)
  tzcpu.tz_cpu_xavier_init_f32(data_p, numel, fan_in, seed)
  ret t

fn tensor_zero_grad(t: int) -> int:
  grad_p: int = tensor_grad(t)
  if grad_p != 0:
    numel: int = tensor_numel(t)
    if tensor_device(t) == DEVICE_GPU:
      tzgpu.tz_gpu_fill_f32(grad_p, numel, 0.0)
    else:
      tzcpu.tz_cpu_fill_f32(grad_p, numel, 0.0)
  ret 0

fn tensor_fill(t: int, val: f32) -> int:
  if _tensor_valid(t) == 0: ret 0 - 1
  data_p: int = tensor_data(t)
  numel: int = tensor_numel(t)
  if tensor_device(t) == DEVICE_GPU:
    ret tzgpu.tz_gpu_fill_f32(data_p, numel, val)
  else:
    ret tzcpu.tz_cpu_fill_f32(data_p, numel, val)

// ── Unified Device Management ────────────────────────────────────────────────

fn tensor_to(t:int, target_device:int) -> int:
  if t == 0 || target_device < DEVICE_CPU || target_device > DEVICE_GPU: ret 0
  cur_dev:int = tensor_device(t)
  if cur_dev < DEVICE_CPU || cur_dev > DEVICE_GPU: ret 0
  if cur_dev == target_device: ret t
  numel:int = tensor_numel(t)
  if numel <= 0 || numel > 2305843009213693951: ret 0
  bytes:int = numel * 4
  data:int = tensor_data(t)
  grad:int = tensor_grad(t)
  next_data:int = 0
  next_grad:int = 0
  if target_device == DEVICE_GPU:
    if tzgpu.tz_cuda_device_count() <= 0: ret 0
    next_data = tzgpu.tz_cuda_malloc(bytes)
    if next_data == 0: ret 0
    if tzgpu.tz_cuda_memcpy(next_data, data, bytes, GPU_H2D) != 0:
      tzgpu.tz_cuda_free(next_data)
      ret 0
    if grad != 0:
      next_grad = tzgpu.tz_cuda_malloc(bytes)
      if next_grad == 0:
        tzgpu.tz_cuda_free(next_data)
        ret 0
      if tzgpu.tz_cuda_memcpy(next_grad, grad, bytes, GPU_H2D) != 0:
        tzgpu.tz_cuda_free(next_data)
        tzgpu.tz_cuda_free(next_grad)
        ret 0
    tzcpu.tz_cpu_free(data)
    tzcpu.tz_cpu_free(grad)
  else:
    next_data = tzcpu.tz_cpu_zeros(numel)
    if next_data == 0: ret 0
    if tzgpu.tz_cuda_memcpy(next_data, data, bytes, GPU_D2H) != 0:
      tzcpu.tz_cpu_free(next_data)
      ret 0
    if grad != 0:
      next_grad = tzcpu.tz_cpu_zeros(numel)
      if next_grad == 0:
        tzcpu.tz_cpu_free(next_data)
        ret 0
      if tzgpu.tz_cuda_memcpy(next_grad, grad, bytes, GPU_D2H) != 0:
        tzcpu.tz_cpu_free(next_data)
        tzcpu.tz_cpu_free(next_grad)
        ret 0
    tzgpu.tz_cuda_free(data)
    tzgpu.tz_cuda_free(grad)
  unsafe:
    (t as *int)[0] = next_data
    (t as *int)[1] = next_grad
    (t as *int)[8] = target_device
  ret t

fn tensor_cuda(t: int) -> int:
  ret tensor_to(t, DEVICE_GPU)

fn tensor_cpu(t: int) -> int:
  ret tensor_to(t, DEVICE_CPU)

// ── Tensor Forward Operations with Dynamic Autograd Recording ────────────────

fn _tensor_valid(t:int) -> int:
  if t == 0 || tensor_data(t) == 0: ret 0
  if tensor_device(t) != DEVICE_CPU && tensor_device(t) != DEVICE_GPU: ret 0
  rank:int = tensor_ndim(t)
  if rank < 1 || rank > 4: ret 0
  d0:int = tensor_d0(t)
  d1:int = tensor_d1(t)
  d2:int = tensor_d2(t)
  d3:int = tensor_d3(t)
  if d0 <= 0 || d1 <= 0 || d2 <= 0 || d3 <= 0: ret 0
  if rank < 4 && d3 != 1: ret 0
  if rank < 3 && d2 != 1: ret 0
  if rank < 2 && d1 != 1: ret 0
  count:int = d0
  if count > 2305843009213693951 / d1: ret 0
  count = count * d1
  if count > 2305843009213693951 / d2: ret 0
  count = count * d2
  if count > 2305843009213693951 / d3: ret 0
  ret count * d3 == tensor_numel(t)

fn _tensor_same_shape(a:int, b:int) -> int:
  if _tensor_valid(a) == 0 || _tensor_valid(b) == 0: ret 0
  if tensor_ndim(a) != tensor_ndim(b) || tensor_numel(a) != tensor_numel(b): ret 0
  if tensor_d0(a) != tensor_d0(b) || tensor_d1(a) != tensor_d1(b) || tensor_d2(a) != tensor_d2(b) || tensor_d3(a) != tensor_d3(b): ret 0
  ret 1

fn _tensor_output_ready(input:int, out:int) -> int:
  if _tensor_same_shape(input, out) == 0: ret 0
  if tensor_device(input) != tensor_device(out): ret 0
  if tensor_data(input) == 0 || tensor_data(out) == 0: ret 0
  if input == out && tensor_requires_grad(input) != 0 && tzautodiff.autodiff_is_grad_enabled() != 0: ret 0
  ret 1

fn _tensor_new_like(t:int, requires_grad:int) -> int:
  if t == 0: ret 0
  out:int = tensor_new_4d(tensor_d0(t), tensor_d1(t), tensor_d2(t), tensor_d3(t), requires_grad)
  if out == 0: ret 0
  unsafe:
    (out as *int)[2] = tensor_ndim(t)
  if tensor_device(t) == DEVICE_GPU:
    if tensor_cuda(out) == 0:
      tensor_free(out)
      ret 0
  ret out

fn tensor_linear(x: int, w: int, b: int, out: int) -> int:
  if _tensor_valid(x) == 0 || _tensor_valid(w) == 0 || _tensor_valid(out) == 0: ret 0 - 1
  if tensor_ndim(x) != 2 || tensor_ndim(w) != 2 || tensor_ndim(out) != 2: ret 0 - 1
  batch: int = tensor_d0(x)
  in_dim: int = tensor_d1(x)
  out_dim: int = tensor_d0(w)
  if tensor_d1(w) != in_dim || tensor_d0(out) != batch || tensor_d1(out) != out_dim: ret 0 - 1
  if tensor_device(x) != tensor_device(w) || tensor_device(x) != tensor_device(out): ret 0 - 1
  if out == x || out == w || out == b: ret 0 - 1
  if b != 0:
    if _tensor_valid(b) == 0 || tensor_numel(b) != out_dim || tensor_device(b) != tensor_device(x): ret 0 - 1

  status:int = 0
  if tensor_device(x) == DEVICE_GPU:
    status = tzgpu.tz_gpu_gemm_nt_f32(tensor_data(x), tensor_data(w), tensor_data(out), batch, in_dim, out_dim, 1.0, 0.0)
    if status != 0: ret status
    if b != 0:
      status = tzgpu.tz_gpu_add_bias_f32(tensor_data(out), tensor_data(b), batch, out_dim)
  else:
    status = tzcpu.tz_cpu_gemm_nt_f32(tensor_data(x), tensor_data(w), tensor_data(out), batch, in_dim, out_dim, 1.0, 0.0)
    if status != 0: ret status
    if b != 0:
      status = tzcpu.tz_cpu_add_bias_f32(tensor_data(out), tensor_data(b), batch, out_dim)

  if status != 0: ret status
  ret tzautodiff.autodiff_record(1, out, x, w, b, 0, 0, 0)

fn tensor_relu(x: int, out: int) -> int:
  if _tensor_output_ready(x, out) == 0: ret 0 - 1
  numel: int = tensor_numel(x)
  status:int = 0
  if tensor_device(x) == DEVICE_GPU:
    status = tzgpu.tz_gpu_relu_f32(tensor_data(x), tensor_data(out), numel)
  else:
    status = tzcpu.tz_cpu_relu_f32(tensor_data(x), tensor_data(out), numel)

  if status != 0: ret status
  ret tzautodiff.autodiff_record(2, out, x, 0, 0, 0, 0, 0)

fn tensor_gelu(x: int, out: int) -> int:
  if _tensor_output_ready(x, out) == 0: ret 0 - 1
  numel: int = tensor_numel(x)
  status:int = 0
  if tensor_device(x) == DEVICE_GPU:
    status = tzgpu.tz_gpu_gelu_f32(tensor_data(x), tensor_data(out), numel)
  else:
    status = tzcpu.tz_cpu_gelu_f32(tensor_data(x), tensor_data(out), numel)

  if status != 0: ret status
  ret tzautodiff.autodiff_record(3, out, x, 0, 0, 0, 0, 0)

fn tensor_softmax(x:int, out:int) -> int:
  if _tensor_output_ready(x, out) == 0: ret 0 - 1
  cols:int = tensor_d0(x)
  rank:int = tensor_ndim(x)
  if rank == 2: cols = tensor_d1(x)
  if rank == 3: cols = tensor_d2(x)
  if rank == 4: cols = tensor_d3(x)
  if cols <= 0: ret 0 - 1
  rows:int = tensor_numel(x) / cols
  if tensor_device(x) == DEVICE_GPU:
    tzgpu.tz_gpu_copy_f32(tensor_data(x), tensor_data(out), tensor_numel(x))
    tzgpu.tz_gpu_softmax_f32(tensor_data(out), rows, cols)
  else:
    tzcpu.tz_cpu_copy_f32(tensor_data(x), tensor_data(out), tensor_numel(x))
    tzcpu.tz_cpu_softmax_f32(tensor_data(out), rows, cols)
  ret tzautodiff.autodiff_record(13, out, x, 0, 0, 0, 0, 0)

fn tensor_cross_entropy(logits:int, labels:int, loss_buf:int) -> int:
  if logits == 0 || labels == 0 || loss_buf == 0: ret 0 - 1
  if tensor_ndim(logits) != 2: ret 0 - 1
  batch:int = tensor_d0(logits)
  classes:int = tensor_d1(logits)
  if batch <= 0 || classes <= 0 || tensor_numel(labels) != batch || tensor_numel(loss_buf) != batch: ret 0 - 1
  if tensor_device(labels) != tensor_device(logits) || tensor_device(loss_buf) != tensor_device(logits): ret 0 - 1
  cache:int = 0
  if tensor_device(logits) == DEVICE_GPU:
    tzgpu.tz_gpu_cross_entropy_f32(tensor_data(logits), tensor_data(labels), tensor_data(loss_buf), batch, classes)
  else:
    // The low-level CPU kernel intentionally writes probabilities in-place.
    // Keep that cache separate from the user's logits and own it on the tape.
    cache = tzcpu.tz_cpu_malloc(tensor_numel(logits) * 4)
    if cache == 0: ret 0 - 1
    tzcpu.tz_cpu_copy_f32(tensor_data(logits), cache, tensor_numel(logits))
    tzcpu.tz_cpu_cross_entropy_f32(cache, tensor_data(labels), tensor_data(loss_buf), batch, classes)
  tracked:int = 0
  if tensor_requires_grad(logits) != 0 && tzautodiff.autodiff_is_grad_enabled() != 0: tracked = 1
  status:int = tzautodiff.autodiff_record(4, loss_buf, logits, labels, 0, 0, cache, tracked)
  if tracked == 0 || status != 0:
    tzcpu.tz_cpu_free(cache)
  ret status

fn tensor_conv2d(x: int, w: int, b: int, out: int, pad: int, stride: int) -> int:
  if _tensor_valid(x) == 0 || _tensor_valid(w) == 0 || _tensor_valid(out) == 0: ret 0 - 1
  // Only CPU convolution kernels are implemented. Reject device pointers.
  if tensor_device(x) != DEVICE_CPU || tensor_device(w) != DEVICE_CPU || tensor_device(out) != DEVICE_CPU: ret 0 - 1
  if tensor_ndim(x) != 4 || tensor_ndim(w) != 4 || tensor_ndim(out) != 4: ret 0 - 1
  if out == x || out == w || out == b: ret 0 - 1
  if tensor_d1(x) != tensor_d1(w) || pad < 0 || stride <= 0: ret 0 - 1
  h:int = _tensor_window_extent(tensor_d2(x), tensor_d2(w), pad, stride)
  width:int = _tensor_window_extent(tensor_d3(x), tensor_d3(w), pad, stride)
  if h == 0 || width == 0: ret 0 - 1
  if tensor_d0(out) != tensor_d0(x) || tensor_d1(out) != tensor_d0(w) || tensor_d2(out) != h || tensor_d3(out) != width: ret 0 - 1
  b_ptr: int = 0
  if b != 0:
    if _tensor_valid(b) == 0 || tensor_device(b) != DEVICE_CPU || tensor_numel(b) != tensor_d0(w): ret 0 - 1
    b_ptr = tensor_data(b)
  status:int = tzcpu.tz_cpu_conv2d_f32(tensor_data(x), tensor_data(w), b_ptr, tensor_data(out), tensor_d0(x), tensor_d1(x), tensor_d2(x), tensor_d3(x), tensor_d0(w), tensor_d2(w), tensor_d3(w), pad, stride)
  if status != 0: ret status
  ret tzautodiff.autodiff_record(9, out, x, w, b, 0, pad, stride)

fn _tensor_window_extent(size:int, window:int, pad:int, stride:int) -> int:
  if size <= 0 || window <= 0 || pad < 0 || stride <= 0: ret 0
  if pad > (9223372036854775807 - size) / 2: ret 0
  padded:int = size + 2 * pad
  if window > padded: ret 0
  ret (padded - window) / stride + 1

fn tensor_maxpool2d(x: int, out: int, mask: int, kH: int, kW: int, stride: int) -> int:
  if _tensor_valid(x) == 0 || _tensor_same_shape(out, mask) == 0: ret 0 - 1
  if tensor_device(x) != DEVICE_CPU || tensor_device(out) != DEVICE_CPU || tensor_device(mask) != DEVICE_CPU: ret 0 - 1
  if tensor_ndim(x) != 4 || tensor_ndim(out) != 4: ret 0 - 1
  if x == out || x == mask || out == mask: ret 0 - 1
  if tensor_d2(x) > 2147483647 / tensor_d3(x): ret 0 - 1
  h:int = _tensor_window_extent(tensor_d2(x), kH, 0, stride)
  width:int = _tensor_window_extent(tensor_d3(x), kW, 0, stride)
  if h == 0 || width == 0: ret 0 - 1
  if tensor_d0(out) != tensor_d0(x) || tensor_d1(out) != tensor_d1(x) || tensor_d2(out) != h || tensor_d3(out) != width: ret 0 - 1
  status:int = tzcpu.tz_cpu_maxpool2d_f32(tensor_data(x), tensor_data(out), tensor_data(mask), tensor_d0(x), tensor_d1(x), tensor_d2(x), tensor_d3(x), kH, kW, stride)
  if status != 0: ret status
  ret tzautodiff.autodiff_record(10, out, x, 0, 0, 0, tensor_data(mask), 0)

// ── High-Level Backward API ──────────────────────────────────────────────────
fn tensor_backward(loss: int) -> int:
  ret tzautodiff.autodiff_backward(loss)

fn tensor_print(t: int, label: str) -> int:
  if t == 0:
    say "tensor(null)"
    ret 0
  if label != "":
    say label
  data_p: int = tensor_data(t)
  if tensor_device(t) == DEVICE_GPU:
    numel: int = tensor_numel(t)
    host_buf: int = tzcpu.tz_cpu_malloc(numel * 4)
    tzgpu.tz_cuda_memcpy(host_buf, data_p, numel * 4, GPU_D2H)
    tzcpu.tz_cpu_print_tensor_formatted(host_buf, tensor_d0(t), tensor_d1(t), tensor_d2(t), tensor_d3(t), tensor_ndim(t), 1, tensor_requires_grad(t))
    tzcpu.tz_cpu_free(host_buf)
  else:
    tzcpu.tz_cpu_print_tensor_formatted(data_p, tensor_d0(t), tensor_d1(t), tensor_d2(t), tensor_d3(t), tensor_ndim(t), 0, tensor_requires_grad(t))
  ret 0

fn tensor_check_finite(t:int, name:str) -> int:
  if t == 0 || tensor_data(t) == 0: ret 0
  if tensor_device(t) == DEVICE_CPU:
    ret tzcpu.tz_cpu_check_finite_f32(tensor_data(t), tensor_numel(t))
  temporary:int = tzcpu.tz_cpu_malloc(tensor_numel(t) * 4)
  if temporary == 0: ret 0
  if tzgpu.tz_cuda_memcpy(temporary, tensor_data(t), tensor_numel(t) * 4, GPU_D2H) != 0:
    tzcpu.tz_cpu_free(temporary)
    ret 0
  finite:int = tzcpu.tz_cpu_check_finite_f32(temporary, tensor_numel(t))
  tzcpu.tz_cpu_free(temporary)
  ret finite

fn tensor_free(t: int) -> int:
  if t != 0:
    data_p: int = tensor_data(t)
    grad_p: int = tensor_grad(t)
    if tensor_device(t) == DEVICE_GPU:
      if data_p != 0:
        tzgpu.tz_cuda_free(data_p)
      if grad_p != 0:
        tzgpu.tz_cuda_free(grad_p)
    else:
      if data_p != 0:
        tzcpu.tz_cpu_free(data_p)
      if grad_p != 0:
        tzcpu.tz_cpu_free(grad_p)
    tzcpu.tz_cpu_free(t)
  ret 0

// ── Multi-Dimensional Tensor Slicing ─────────────────────────────────────────

fn tensor_slice4d(t:int, s0:int, e0:int, s1:int, e1:int, s2:int, e2:int, s3:int, e3:int) -> int:
  if t == 0: ret 0
  if s0 < 0 || s1 < 0 || s2 < 0 || s3 < 0: ret 0
  if e0 <= s0 || e1 <= s1 || e2 <= s2 || e3 <= s3: ret 0
  if e0 > tensor_d0(t) || e1 > tensor_d1(t) || e2 > tensor_d2(t) || e3 > tensor_d3(t): ret 0
  out:int = tensor_new_4d(e0 - s0, e1 - s1, e2 - s2, e3 - s3, tensor_requires_grad(t))
  if out == 0: ret 0
  unsafe:
    (out as *int)[2] = tensor_ndim(t)
  if tensor_device(t) == DEVICE_GPU:
    source:int = tzcpu.tz_cpu_malloc(tensor_numel(t) * 4)
    if source == 0:
      tensor_free(out)
      ret 0
    status:int = tzgpu.tz_cuda_memcpy(source, tensor_data(t), tensor_numel(t) * 4, GPU_D2H)
    if status == 0:
      status = tzcpu.tz_cpu_slice4d_f32(source, tensor_data(out), tensor_d0(t), tensor_d1(t), tensor_d2(t), tensor_d3(t), s0, e0, s1, e1, s2, e2, s3, e3)
    tzcpu.tz_cpu_free(source)
    if status != 0:
      tensor_free(out)
      ret 0
    if tensor_cuda(out) == 0:
      tensor_free(out)
      ret 0
  else:
    tzcpu.tz_cpu_slice4d_f32(tensor_data(t), tensor_data(out), tensor_d0(t), tensor_d1(t), tensor_d2(t), tensor_d3(t), s0, e0, s1, e1, s2, e2, s3, e3)
  if tzautodiff.autodiff_record_slice(out, t, s0, e0, s1, e1, s2, e2, s3, e3) != 0:
    tensor_free(out)
    ret 0
  ret out

fn tensor_slice2d(t: int, s0: int, e0: int, s1: int, e1: int) -> int:
  ret tensor_slice4d(t, s0, e0, s1, e1, 0, 1, 0, 1)

fn tensor_slice_dim(t: int, dim: int, start: int, end: int) -> int:
  d0: int = tensor_d0(t)
  d1: int = tensor_d1(t)
  d2: int = tensor_d2(t)
  d3: int = tensor_d3(t)
  if dim == 0:
    ret tensor_slice4d(t, start, end, 0, d1, 0, d2, 0, d3)
  else if dim == 1:
    ret tensor_slice4d(t, 0, d0, start, end, 0, d2, 0, d3)
  else if dim == 2:
    ret tensor_slice4d(t, 0, d0, 0, d1, start, end, 0, d3)
  else:
    ret tensor_slice4d(t, 0, d0, 0, d1, 0, d2, start, end)

// ── Infix Operator Overloading Runtime Functions ─────────────────────────────

fn tensor_matmul(a:int, b:int, out:int) -> int:
  if a == 0 || b == 0 || out == 0: ret 0 - 1
  if tensor_ndim(a) != 2 || tensor_ndim(b) != 2 || tensor_ndim(out) != 2: ret 0 - 1
  m:int = tensor_d0(a)
  k:int = tensor_d1(a)
  n:int = tensor_d1(b)
  if k != tensor_d0(b) || tensor_d0(out) != m || tensor_d1(out) != n: ret 0 - 1
  if tensor_device(a) != tensor_device(b) || tensor_device(a) != tensor_device(out): ret 0 - 1
  if out == a || out == b: ret 0 - 1
  if tensor_device(a) == DEVICE_GPU:
    tzgpu.tz_gpu_gemm_f32(tensor_data(a), tensor_data(b), tensor_data(out), m, k, n, 1.0, 0.0)
  else:
    tzcpu.tz_cpu_gemm_f32(tensor_data(a), tensor_data(b), tensor_data(out), m, k, n, 1.0, 0.0)
  ret tzautodiff.autodiff_record(7, out, a, b, 0, 0, 0, 0)

fn tensor_add(a:int, b:int, out:int) -> int:
  if _tensor_same_shape(a, b) == 0 || _tensor_output_ready(a, out) == 0 || _tensor_output_ready(b, out) == 0: ret 0 - 1
  numel:int = tensor_numel(a)
  if tensor_device(a) == DEVICE_GPU:
    tzgpu.tz_gpu_add_f32(tensor_data(a), tensor_data(b), tensor_data(out), numel)
  else:
    tzcpu.tz_cpu_add_f32(tensor_data(a), tensor_data(b), tensor_data(out), numel)
  ret tzautodiff.autodiff_record(5, out, a, b, 0, 0, 0, 0)

fn tensor_sub(a:int, b:int, out:int) -> int:
  if _tensor_same_shape(a, b) == 0 || _tensor_output_ready(a, out) == 0 || _tensor_output_ready(b, out) == 0: ret 0 - 1
  numel:int = tensor_numel(a)
  if tensor_device(a) == DEVICE_GPU:
    tzgpu.tz_gpu_sub_f32(tensor_data(a), tensor_data(b), tensor_data(out), numel)
  else:
    tzcpu.tz_cpu_sub_f32(tensor_data(a), tensor_data(b), tensor_data(out), numel)
  ret tzautodiff.autodiff_record(12, out, a, b, 0, 0, 0, 0)

fn tensor_mul(a:int, b:int, out:int) -> int:
  if _tensor_same_shape(a, b) == 0 || _tensor_output_ready(a, out) == 0 || _tensor_output_ready(b, out) == 0: ret 0 - 1
  numel:int = tensor_numel(a)
  if tensor_device(a) == DEVICE_GPU:
    tzgpu.tz_gpu_mul_f32(tensor_data(a), tensor_data(b), tensor_data(out), numel)
  else:
    tzcpu.tz_cpu_mul_f32(tensor_data(a), tensor_data(b), tensor_data(out), numel)
  ret tzautodiff.autodiff_record(6, out, a, b, 0, 0, 0, 0)

fn tensor_matmul_infix(a:int, b:int) -> int:
  if a == 0 || b == 0: ret 0
  if tensor_ndim(a) != 2 || tensor_ndim(b) != 2 || tensor_d1(a) != tensor_d0(b): ret 0
  if tensor_device(a) != tensor_device(b): ret 0
  req:int = 0
  if tensor_requires_grad(a) != 0 || tensor_requires_grad(b) != 0: req = 1
  out:int = tensor_new_2d(tensor_d0(a), tensor_d1(b), req)
  if out == 0: ret 0
  if tensor_device(a) == DEVICE_GPU:
    if tensor_cuda(out) == 0:
      tensor_free(out)
      ret 0
  if tensor_matmul(a, b, out) != 0:
    tensor_free(out)
    ret 0
  ret out

fn tensor_add_infix(a:int, b:int) -> int:
  if _tensor_same_shape(a, b) == 0: ret 0
  req:int = 0
  if tensor_requires_grad(a) != 0 || tensor_requires_grad(b) != 0: req = 1
  out:int = _tensor_new_like(a, req)
  if out == 0: ret 0
  if tensor_add(a, b, out) != 0:
    tensor_free(out)
    ret 0
  ret out

fn tensor_sub_infix(a:int, b:int) -> int:
  if _tensor_same_shape(a, b) == 0: ret 0
  req:int = 0
  if tensor_requires_grad(a) != 0 || tensor_requires_grad(b) != 0: req = 1
  out:int = _tensor_new_like(a, req)
  if out == 0: ret 0
  if tensor_sub(a, b, out) != 0:
    tensor_free(out)
    ret 0
  ret out

fn tensor_mul_infix(a:int, b:int) -> int:
  if _tensor_same_shape(a, b) == 0: ret 0
  req:int = 0
  if tensor_requires_grad(a) != 0 || tensor_requires_grad(b) != 0: req = 1
  out:int = _tensor_new_like(a, req)
  if out == 0: ret 0
  if tensor_mul(a, b, out) != 0:
    tensor_free(out)
    ret 0
  ret out

// ── N-D Tensor Reshape & Permute ──────────────────────────────────────────────

fn tensor_reshape(t:int, n0:int, n1:int, n2:int, n3:int) -> int:
  if t == 0 || n0 <= 0 || n1 <= 0 || n2 <= 0 || n3 <= 0: ret 0
  count:int = n0
  if count > 9223372036854775807 / n1: ret 0
  count = count * n1
  if count > 9223372036854775807 / n2: ret 0
  count = count * n2
  if count > 9223372036854775807 / n3: ret 0
  count = count * n3
  if count != tensor_numel(t): ret 0
  out:int = tensor_new_4d(n0, n1, n2, n3, tensor_requires_grad(t))
  if out == 0: ret 0
  if tensor_device(t) == DEVICE_GPU:
    if tensor_cuda(out) == 0:
      tensor_free(out)
      ret 0
    tzgpu.tz_gpu_copy_f32(tensor_data(t), tensor_data(out), count)
  else:
    tzcpu.tz_cpu_copy_f32(tensor_data(t), tensor_data(out), count)
  if tzautodiff.autodiff_record(14, out, t, 0, 0, 0, 0, 0) != 0:
    tensor_free(out)
    ret 0
  ret out

struct TzTensorDesc:
  dtype:int
  rows:int
  cols:int
  stride0:int
  stride1:int
  device:int
  alignment:int
  elem_bytes:int
  size:int
  bytes:int

fn tensor_desc_valid_p(d:*TzTensorDesc) -> int:
  if d == 0: ret 0
  if (*d).rows <= 0 || (*d).cols <= 0: ret 0
  ret 1


