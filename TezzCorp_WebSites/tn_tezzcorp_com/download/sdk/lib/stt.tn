// Native speech audio frontend: validated PCM WAV input, FFT and log-mel features.
// Native trainable character CTC baseline; strict architecture/CRC checkpoints.
// An untrained state cannot decode. Quality depends on training and must be
// measured on held-out audio. No external model or placeholder transcript.

import "io"
import "math"
import "tokenizer"

extern fn stt_capture_mic(pcm:*int, n_samples:int, rate:int) -> int
extern fn speech_stt_create(hidden:int, context:int, seed:int) -> int
extern fn speech_stt_free(handle:int) -> int
extern fn speech_stt_train(handle:int, mel:*float, frames:int, labels:*int, count:int, rate_ppm:int, loss:*float) -> int
extern fn speech_stt_predict(handle:int, mel:*float, frames:int, text:*char, capacity:int) -> int
extern fn speech_stt_load(path:str) -> int
extern fn speech_stt_save(handle:int, path:str) -> int
extern fn speech_stt_steps(handle:int) -> int
extern fn speech_stt_text_reset(handle:int) -> int
extern fn speech_stt_text_train(handle:int, labels:*int, count:int) -> int
extern fn speech_stt_decoder(handle:int, width:int, lm_weight_ppm:int, insertion_ppm:int) -> int
extern fn speech_stt_align(handle:int, mel:*float, frames:int, labels:*int, count:int, alignment:*int, loss:*float) -> int

// ─────────────────────────────────────────────────────────────
// Constants
// ─────────────────────────────────────────────────────────────

let STT_OK:int  = 0
let STT_ERR:int = 0 - 1

let STT_SAMPLE_RATE:int = 16000   // frontend PCM rate
let STT_N_MELS:int      = 80
let STT_HOP_LEN:int     = 160     // 10ms hops at 16kHz
let STT_WIN_LEN:int     = 400     // 25ms window
let STT_N_FFT:int       = 512
let STT_MAX_AUDIO_MS:int = 30000  // 30 seconds max chunk
let STT_MAX_TOKENS:int  = 448     // future native decoder bound

// ─────────────────────────────────────────────────────────────
// Core structs
// ─────────────────────────────────────────────────────────────

struct SttEngine:
  model_loaded:int
  mel_filters:*float   // mel filterbank matrix [n_mels x (n_fft/2+1)]
  pcm_buf:*int         // PCM input buffer
  pcm_cap:int
  pcm_len:int
  mel_buf:*float       // mel spectrogram buffer
  mel_cap:int
  mel_frames:int
  tok:*Tokenizer  // tokenizer for output
  use_nn:int           // 1 if neural model available
  last_text:str        // last recognition result
  model_handle:int     // validated native CTC checkpoint or training state

// ─────────────────────────────────────────────────────────────
// Mel filterbank computation
// ─────────────────────────────────────────────────────────────

fn _stt_hz_to_mel(hz:float) -> float:
  ret 2595.0 * math.log10(1.0 + hz / 700.0)

fn _stt_mel_to_hz(mel:float) -> float:
  ret 700.0 * (math.pow(10.0, mel / 2595.0) - 1.0)

fn _stt_init_mel_filters(stt:*SttEngine) -> int:
  n_mels:int = STT_N_MELS
  n_fft_half:int = STT_N_FFT / 2 + 1
  mel_low:float = _stt_hz_to_mel(20.0)
  mel_high:float = _stt_hz_to_mel(8000.0)
  n_points:int = n_mels + 2
  mel_pts:*float = (*float)malloc(sizeof(float) * n_points)
  hz_pts:*float = (*float)malloc(sizeof(float) * n_points)
  filters:*float = (*float)malloc(sizeof(float) * n_mels * n_fft_half)
  if mel_pts == 0 || hz_pts == 0 || filters == 0:
    if mel_pts != 0: free(mel_pts as *char)
    if hz_pts != 0: free(hz_pts as *char)
    if filters != 0: free(filters as *char)
    ret STT_ERR
  // Compute mel center frequencies
  i:int = 0
  while i < n_points:
    mel_pts[i] = mel_low + (mel_high - mel_low) * (i as float) / ((n_points - 1) as float)
    hz_pts[i] = _stt_mel_to_hz(mel_pts[i])
    i = i + 1
  // Compute filter bank
  m:int = 0
  while m < n_mels:
    k:int = 0
    while k < n_fft_half:
      freq:float = (STT_SAMPLE_RATE as float / 2.0) * (k as float) / ((n_fft_half - 1) as float)
      lower:float = hz_pts[m]
      center:float = hz_pts[m + 1]
      upper:float = hz_pts[m + 2]
      w:float = 0.0
      if freq >= lower && freq <= center && center > lower:
        w = (freq - lower) / (center - lower)
      else if freq > center && freq <= upper && upper > center:
        w = (upper - freq) / (upper - center)
      filters[m * n_fft_half + k] = w
      k = k + 1
    m = m + 1
  (*stt).mel_filters = filters
  free(mel_pts as *char)
  free(hz_pts as *char)
  ret STT_OK

// ─────────────────────────────────────────────────────────────
// FFT implementation (radix-2 Cooley-Tukey)
// ─────────────────────────────────────────────────────────────

fn _stt_fft_bit_rev(n:int) -> *int:
  if n <= 0 || n > STT_N_FFT || (n & (n - 1)) != 0: ret 0 as *int
  bits:int = 0
  m:int = n
  while m > 1:
    bits = bits + 1
    m = m / 2
  out:*int = (*int)malloc(sizeof(int) * n)
  if out == 0: ret 0 as *int
  i:int = 0
  while i < n:
    rev:int = 0
    x:int = i
    b:int = 0
    while b < bits:
      rev = (rev << 1) | (x & 1)
      x = x >> 1
      b = b + 1
    out[i] = rev
    i = i + 1
  ret out

fn _stt_fft(re:*float, im:*float, n:int) -> int:
  if re == 0 || im == 0 || n <= 0 || n > STT_N_FFT || (n & (n - 1)) != 0: ret STT_ERR
  // In-place FFT
  br:*int = _stt_fft_bit_rev(n)
  if br == 0: ret STT_ERR
  // Bit-reverse permutation
  i:int = 0
  while i < n:
    j:int = br[i]
    if j > i:
      tmp_r:float = re[i]; re[i] = re[j]; re[j] = tmp_r
      tmp_i:float = im[i]; im[i] = im[j]; im[j] = tmp_i
    i = i + 1
  free(br as *char)
  // FFT butterfly
  pi:float = 3.14159265358979
  len_half:int = 1
  while len_half < n:
    ang:float = 0.0 - pi / (len_half as float)
    wr:float = math.cos(ang)
    wi:float = math.sin(ang)
    i2:int = 0
    while i2 < n:
      cur_r:float = 1.0
      cur_i:float = 0.0
      j2:int = 0
      while j2 < len_half:
        ur:float = re[i2 + j2]
        ui:float = im[i2 + j2]
        vr:float = re[i2 + j2 + len_half] * cur_r - im[i2 + j2 + len_half] * cur_i
        vi:float = re[i2 + j2 + len_half] * cur_i + im[i2 + j2 + len_half] * cur_r
        re[i2 + j2] = ur + vr
        im[i2 + j2] = ui + vi
        re[i2 + j2 + len_half] = ur - vr
        im[i2 + j2 + len_half] = ui - vi
        new_cur_r:float = cur_r * wr - cur_i * wi
        cur_i = cur_r * wi + cur_i * wr
        cur_r = new_cur_r
        j2 = j2 + 1
      i2 = i2 + len_half * 2
    len_half = len_half * 2
  ret STT_OK

// ─────────────────────────────────────────────────────────────
// Mel spectrogram extraction
// ─────────────────────────────────────────────────────────────

fn _stt_compute_mel(stt:*SttEngine) -> int:
  if stt == 0: ret STT_ERR
  (*stt).mel_frames = 0
  if (*stt).pcm_buf == 0 || (*stt).mel_filters == 0 || (*stt).pcm_len < STT_WIN_LEN: ret STT_ERR
  if (*stt).pcm_len > STT_SAMPLE_RATE * (STT_MAX_AUDIO_MS / 1000): ret STT_ERR
  n_fft:int = STT_N_FFT
  hop:int = STT_HOP_LEN
  win:int = STT_WIN_LEN
  n_mels:int = STT_N_MELS
  n_fft_half:int = n_fft / 2 + 1
  n_frames:int = ((*stt).pcm_len - win) / hop + 1
  if n_frames <= 0: ret STT_ERR
  mel_total:int = n_frames * n_mels
  if mel_total > (*stt).mel_cap:
    nb:*float = (*float)malloc(sizeof(float) * mel_total)
    if nb == 0: ret STT_ERR
    if (*stt).mel_buf != 0: free((*stt).mel_buf as *char)
    (*stt).mel_buf = nb
    (*stt).mel_cap = mel_total
  re_buf:*float = (*float)malloc(sizeof(float) * n_fft)
  im_buf:*float = (*float)malloc(sizeof(float) * n_fft)
  if re_buf == 0 || im_buf == 0:
    if re_buf != 0: free(re_buf as *char)
    if im_buf != 0: free(im_buf as *char)
    ret STT_ERR
  // Hann window
  hann:[float;512]
  pi:float = 3.14159265358979
  wi:int = 0
  while wi < win:
    hann[wi] = 0.5 * (1.0 - math.cos(2.0 * pi * (wi as float) / ((win - 1) as float)))
    wi = wi + 1
  // Frame by frame
  frame:int = 0
  while frame < n_frames:
    start:int = frame * hop
    // Fill FFT input
    k:int = 0
    while k < n_fft:
      if k < win && start + k < (*stt).pcm_len:
        re_buf[k] = ((*stt).pcm_buf[start + k] as float / 32768.0) * hann[k]
      else:
        re_buf[k] = 0.0
      im_buf[k] = 0.0
      k = k + 1
    if _stt_fft(re_buf, im_buf, n_fft) != STT_OK:
      free(re_buf as *char); free(im_buf as *char)
      ret STT_ERR
    // Compute power spectrum
    ps:[float;257]
    p:int = 0
    while p < n_fft_half:
      ps[p] = re_buf[p] * re_buf[p] + im_buf[p] * im_buf[p]
      p = p + 1
    // Apply mel filters
    m:int = 0
    while m < n_mels:
      mel_val:float = 0.0
      q:int = 0
      while q < n_fft_half:
        mel_val = mel_val + (*stt).mel_filters[m * n_fft_half + q] * ps[q]
        q = q + 1
      // Log mel
      if mel_val < 1.0e-10: mel_val = 1.0e-10
      (*stt).mel_buf[frame * n_mels + m] = math.log(mel_val)
      m = m + 1
    frame = frame + 1
  (*stt).mel_frames = n_frames
  free(re_buf as *char)
  free(im_buf as *char)
  ret STT_OK

// ─────────────────────────────────────────────────────────────
// Decoder boundary: unavailable until native trained-model integration
// ─────────────────────────────────────────────────────────────

fn _stt_rule_decode(stt:*SttEngine) -> str:
  // Legacy helper name: only the trained native CTC model produces text.
  if stt == 0 || (*stt).model_handle <= 0 || (*stt).model_loaded == 0: ret 0 as str
  if (*stt).mel_buf == 0 || (*stt).mel_frames <= 0: ret 0 as str
  capacity:int = (*stt).mel_frames + 1
  text:*char = malloc(capacity)
  if text == 0: ret 0 as str
  if speech_stt_predict((*stt).model_handle, (*stt).mel_buf, (*stt).mel_frames, text, capacity) < 0:
    free(text)
    ret 0 as str
  ret text as str



// ─────────────────────────────────────────────────────────────
// WAV file reader
// ─────────────────────────────────────────────────────────────

fn _stt_u16(bytes:*char, offset:int) -> int:
  ret (bytes[offset] as int & 255) | ((bytes[offset + 1] as int & 255) << 8)

fn _stt_u32(bytes:*char, offset:int) -> int:
  ret _stt_u16(bytes, offset) | (_stt_u16(bytes, offset + 2) << 16)

fn _stt_pcm_value(raw:*char, frame:int, channels:int, bits:int) -> int:
  total:int = 0
  ch:int = 0
  while ch < channels:
    offset:int = (frame * channels + ch) * (bits / 8)
    value:int = 0
    if bits == 16:
      value = _stt_u16(raw, offset)
      if value >= 32768: value = value - 65536
    else:
      value = ((raw[offset] as int & 255) - 128) * 256
    total = total + value
    ch = ch + 1
  ret total / channels

fn _stt_read_wav(stt:*SttEngine, path:str) -> int:
  if stt == 0 || path == 0: ret STT_ERR
  (*stt).pcm_len = 0
  (*stt).mel_frames = 0
  h:*char = fopen(path, "rb")
  if h == 0 as *char: ret STT_ERR
  if fseek(h, 0, 2) != 0:
    fclose(h)
    ret STT_ERR
  file_bytes:int = ftell(h)
  if file_bytes < 12 || file_bytes > 100000000 || fseek(h, 0, 0) != 0:
    fclose(h)
    ret STT_ERR
  header:[char;12]
  if fread(&header[0], 1, 12, h) != 12:
    fclose(h)
    ret STT_ERR
  if header[0] != 82 as char || header[1] != 73 as char || header[2] != 70 as char || header[3] != 70 as char:
    fclose(h)
    ret STT_ERR
  if header[8] != 87 as char || header[9] != 65 as char || header[10] != 86 as char || header[11] != 69 as char:
    fclose(h)
    ret STT_ERR
  riff_end:int = _stt_u32(&header[0], 4) + 8
  if riff_end < 12 || riff_end > file_bytes:
    fclose(h)
    ret STT_ERR
  channels:int = 0
  sample_rate:int = 0
  bits:int = 0
  block_align:int = 0
  found_fmt:int = 0
  found_data:int = 0
  data_offset:int = 0
  data_bytes:int = 0
  position:int = 12
  chunks:int = 0
  invalid:int = 0
  while position + 8 <= riff_end && chunks < 1024:
    chunk:[char;8]
    if fread(&chunk[0], 1, 8, h) != 8:
      invalid = 1
      break
    size:int = _stt_u32(&chunk[0], 4)
    next:int = position + 8 + size + (size & 1)
    if next > riff_end:
      invalid = 1
      break
    if chunk[0] == 102 as char && chunk[1] == 109 as char && chunk[2] == 116 as char && chunk[3] == 32 as char:
      if found_fmt != 0 || size < 16:
        invalid = 1
        break
      format:[char;16]
      if fread(&format[0], 1, 16, h) != 16:
        invalid = 1
        break
      channels = _stt_u16(&format[0], 2)
      sample_rate = _stt_u32(&format[0], 4)
      bits = _stt_u16(&format[0], 14)
      block_align = _stt_u16(&format[0], 12)
      if _stt_u16(&format[0], 0) != 1 || channels < 1 || channels > 2:
        invalid = 1
        break
      if sample_rate < 8000 || sample_rate > 192000 || (bits != 8 && bits != 16):
        invalid = 1
        break
      if block_align != channels * (bits / 8) || _stt_u32(&format[0], 8) != sample_rate * block_align:
        invalid = 1
        break
      found_fmt = 1
    else if chunk[0] == 100 as char && chunk[1] == 97 as char && chunk[2] == 116 as char && chunk[3] == 97 as char:
      if found_data != 0:
        invalid = 1
        break
      found_data = 1
      data_offset = position + 8
      data_bytes = size
    if fseek(h, next, 0) != 0:
      invalid = 1
      break
    position = next
    chunks = chunks + 1
  if invalid != 0 || position != riff_end || found_fmt == 0 || found_data == 0 || data_bytes <= 0:
    fclose(h)
    ret STT_ERR
  if data_bytes % block_align != 0:
    fclose(h)
    ret STT_ERR
  n_samples:int = data_bytes / block_align
  if n_samples > sample_rate * (STT_MAX_AUDIO_MS / 1000):
    fclose(h)
    ret STT_ERR
  out_samples:int = (n_samples * STT_SAMPLE_RATE) / sample_rate
  if out_samples <= 0 || out_samples > STT_SAMPLE_RATE * (STT_MAX_AUDIO_MS / 1000):
    fclose(h)
    ret STT_ERR
  raw:*char = malloc(data_bytes)
  if raw == 0:
    fclose(h)
    ret STT_ERR
  if fseek(h, data_offset, 0) != 0 || fread(raw, 1, data_bytes, h) != data_bytes:
    free(raw); fclose(h)
    ret STT_ERR
  if fclose(h) != 0:
    free(raw)
    ret STT_ERR
  output:*int = (*int)malloc(sizeof(int) * out_samples)
  if output == 0:
    free(raw)
    ret STT_ERR
  // Linear interpolation, stereo mean, and a clamped last source sample.
  i:int = 0
  while i < out_samples:
    numerator:int = i * sample_rate
    source:int = numerator / STT_SAMPLE_RATE
    fraction:int = numerator % STT_SAMPLE_RATE
    v0:int = _stt_pcm_value(raw, source, channels, bits)
    v1:int = v0
    if source + 1 < n_samples:
      v1 = _stt_pcm_value(raw, source + 1, channels, bits)
    output[i] = (v0 * (STT_SAMPLE_RATE - fraction) + v1 * fraction) / STT_SAMPLE_RATE
    i = i + 1
  free(raw)
  if (*stt).pcm_buf != 0: free((*stt).pcm_buf as *char)
  (*stt).pcm_buf = output
  (*stt).pcm_cap = out_samples
  (*stt).pcm_len = out_samples
  ret STT_OK

// ─────────────────────────────────────────────────────────────
// STT Engine public API
// ─────────────────────────────────────────────────────────────

fn stt_new() -> *SttEngine:
  stt:*SttEngine = (*SttEngine)malloc(sizeof(SttEngine))
  if stt == 0: ret 0 as *SttEngine
  (*stt).model_loaded = 0
  (*stt).mel_filters = 0 as *float
  (*stt).pcm_buf = (*int)malloc(sizeof(int) * 65536)
  (*stt).pcm_cap = 65536
  (*stt).pcm_len = 0
  (*stt).mel_buf = 0 as *float
  (*stt).mel_cap = 0
  (*stt).mel_frames = 0
  (*stt).tok = 0 as *Tokenizer
  (*stt).use_nn = 0
  (*stt).last_text = 0 as str
  (*stt).model_handle = 0
  if (*stt).pcm_buf == 0:
    free(stt)
    ret 0 as *SttEngine
  if _stt_init_mel_filters(stt) != STT_OK:
    free((*stt).pcm_buf as *char); free(stt)
    ret 0 as *SttEngine
  ret stt

fn stt_load_model(stt:*SttEngine, model_path:str) -> int:
  if stt == 0: ret STT_ERR
  (*stt).model_loaded = 0
  (*stt).use_nn = 0
  if (*stt).tok != 0: tokenizer.tokenizer_free((*stt).tok)
  (*stt).tok = 0 as *Tokenizer
  if (*stt).last_text != 0: free((*stt).last_text)
  (*stt).last_text = 0 as str
  if (*stt).model_handle > 0: speech_stt_free((*stt).model_handle)
  (*stt).model_handle = 0
  if model_path == 0: ret STT_ERR
  handle:int = speech_stt_load(model_path)
  if handle <= 0: ret STT_ERR
  (*stt).model_handle = handle
  (*stt).model_loaded = 1
  (*stt).use_nn = 1
  ret STT_OK

fn stt_create_trainable(stt:*SttEngine, hidden:int, context:int, seed:int) -> int:
  if stt == 0: ret STT_ERR
  if (*stt).last_text != 0: free((*stt).last_text)
  (*stt).last_text = 0 as str
  if (*stt).model_handle > 0: speech_stt_free((*stt).model_handle)
  (*stt).model_loaded = 0
  (*stt).use_nn = 0
  (*stt).model_handle = speech_stt_create(hidden, context, seed)
  if (*stt).model_handle <= 0: ret STT_ERR
  // Random initialization is a training state, not a loaded trained model.
  ret STT_OK

fn stt_train_file(stt:*SttEngine, path:str, labels:*int, count:int, rate_ppm:int, loss:*float) -> int:
  if stt == 0 || path == 0 || labels == 0 || loss == 0: ret STT_ERR
  if (*stt).model_handle <= 0 || count <= 0 || count > STT_MAX_TOKENS: ret STT_ERR
  if _stt_read_wav(stt, path) != STT_OK || _stt_compute_mel(stt) != STT_OK: ret STT_ERR
  if speech_stt_train((*stt).model_handle, (*stt).mel_buf, (*stt).mel_frames, labels, count, rate_ppm, loss) != 0: ret STT_ERR
  (*stt).model_loaded = 1
  (*stt).use_nn = 1
  ret STT_OK

fn stt_save_model(stt:*SttEngine, path:str) -> int:
  if stt == 0 || path == 0 || (*stt).model_handle <= 0: ret STT_ERR
  ret speech_stt_save((*stt).model_handle, path)

fn stt_align_file(stt:*SttEngine, path:str, labels:*int, count:int, alignment:*int, capacity:int, loss:*float) -> int:
  if stt == 0 || path == 0 || labels == 0 || alignment == 0 || loss == 0: ret STT_ERR
  if (*stt).model_loaded == 0 || (*stt).model_handle <= 0 || count <= 0 || count > STT_MAX_TOKENS: ret STT_ERR
  if _stt_read_wav(stt, path) != STT_OK || _stt_compute_mel(stt) != STT_OK: ret STT_ERR
  if capacity < (*stt).mel_frames: ret STT_ERR
  ret speech_stt_align((*stt).model_handle, (*stt).mel_buf, (*stt).mel_frames, labels, count, alignment, loss)

fn stt_training_steps(stt:*SttEngine) -> int:
  if stt == 0 || (*stt).model_handle <= 0: ret 0
  ret speech_stt_steps((*stt).model_handle)

// Train aggregate character counts from training transcripts only. No audio or
// transcript strings are retained in the model, and inference needs neither.
fn stt_reset_text_model(stt:*SttEngine) -> int:
  if stt == 0 || (*stt).model_handle <= 0: ret STT_ERR
  ret speech_stt_text_reset((*stt).model_handle)

fn stt_train_text(stt:*SttEngine, labels:*int, count:int) -> int:
  if stt == 0 || (*stt).model_handle <= 0 || labels == 0: ret STT_ERR
  ret speech_stt_text_train((*stt).model_handle, labels, count)

fn stt_set_decoder(stt:*SttEngine, width:int, lm_weight_ppm:int, insertion_ppm:int) -> int:
  if stt == 0 || (*stt).model_handle <= 0: ret STT_ERR
  ret speech_stt_decoder((*stt).model_handle, width, lm_weight_ppm, insertion_ppm)

fn stt_free(stt:*SttEngine) -> int:
  if stt == 0: ret STT_ERR
  if (*stt).model_handle > 0: speech_stt_free((*stt).model_handle)
  if (*stt).mel_filters != 0: free((*stt).mel_filters as *char)
  if (*stt).pcm_buf != 0: free((*stt).pcm_buf as *char)
  if (*stt).mel_buf != 0: free((*stt).mel_buf as *char)
  if (*stt).tok != 0: tokenizer.tokenizer_free((*stt).tok)
  if (*stt).last_text != 0: free((*stt).last_text)
  free(stt)
  ret STT_OK

fn stt_from_pcm(stt:*SttEngine, pcm:*int, n_samples:int) -> str:
  if stt == 0 || pcm == 0 || n_samples < STT_WIN_LEN: ret 0 as str
  if n_samples > STT_SAMPLE_RATE * (STT_MAX_AUDIO_MS / 1000): ret 0 as str
  if (*stt).model_loaded == 0 || (*stt).use_nn == 0: ret 0 as str
  // Copy PCM into buffer
  if n_samples > (*stt).pcm_cap:
    nb:*int = (*int)malloc(sizeof(int) * (n_samples + 1024))
    if nb == 0: ret 0 as str
    if (*stt).pcm_buf != 0: free((*stt).pcm_buf as *char)
    (*stt).pcm_buf = nb
    (*stt).pcm_cap = n_samples + 1024
  unsafe:
    memcpy((*stt).pcm_buf as *char, pcm as *char, sizeof(int) * n_samples)
  (*stt).pcm_len = n_samples
  if _stt_compute_mel(stt) != STT_OK: ret 0 as str
  if (*stt).last_text != 0: free((*stt).last_text)
  (*stt).last_text = _stt_rule_decode(stt)
  ret (*stt).last_text

fn stt_from_file(stt:*SttEngine, wav_path:str) -> str:
  if stt == 0 || wav_path == 0: ret 0 as str
  if (*stt).model_loaded == 0 || (*stt).use_nn == 0: ret 0 as str
  if _stt_read_wav(stt, wav_path) != STT_OK: ret 0 as str
  if _stt_compute_mel(stt) != STT_OK: ret 0 as str
  if (*stt).last_text != 0: free((*stt).last_text)
  (*stt).last_text = _stt_rule_decode(stt)
  ret (*stt).last_text

fn stt_from_mic(stt:*SttEngine, duration_ms:int) -> str:
  if stt == 0 || duration_ms <= 0 || duration_ms > STT_MAX_AUDIO_MS: ret 0 as str
  if (*stt).model_loaded == 0 || (*stt).use_nn == 0: ret 0 as str
  n_samples:int = (STT_SAMPLE_RATE * duration_ms) / 1000
  if n_samples > (*stt).pcm_cap:
    nb:*int = (*int)malloc(sizeof(int) * (n_samples + 1024))
    if nb == 0: ret 0 as str
    if (*stt).pcm_buf != 0: free((*stt).pcm_buf as *char)
    (*stt).pcm_buf = nb
    (*stt).pcm_cap = n_samples + 1024
  // Capture from microphone via runtime
  actual:int = stt_capture_mic((*stt).pcm_buf, n_samples, STT_SAMPLE_RATE)
  if actual <= 0 || actual > n_samples: ret 0 as str
  (*stt).pcm_len = actual
  if _stt_compute_mel(stt) != STT_OK: ret 0 as str
  if (*stt).last_text != 0: free((*stt).last_text)
  (*stt).last_text = _stt_rule_decode(stt)
  ret (*stt).last_text

fn stt_last_text(stt:*SttEngine) -> str:
  if stt == 0: ret 0 as str
  ret (*stt).last_text

fn stt_model_loaded(stt:*SttEngine) -> int:
  if stt == 0: ret 0
  ret (*stt).model_loaded
