// Public runtime API. Implementation sections live in runtime/.
import "runtime.state"
import "runtime.memory"
import "runtime.format"
import "runtime.system"
import "runtime.utility"

let _RT_ENV_MAX:int = 64
let _RT_ENV_KEY_MAX:int = 128
let _RT_ENV_VAL_MAX:int = 4096

fn memcpy(dst:*char, src:*char, n:int) -> *char:
  ret runtime.memory.memcpy(dst, src, n)

fn memmove(dst:*char, src:*char, n:int) -> *char:
  ret runtime.memory.memmove(dst, src, n)

fn memset(dst:*char, c:int, n:int) -> *char:
  ret runtime.memory.memset(dst, c, n)

fn memcmp(a:*char, b:*char, n:int) -> int:
  ret runtime.memory.memcmp(a, b, n)

fn memchr(buf:*char, c:int, n:int) -> int:
  ret runtime.memory.memchr(buf, c, n)

fn strlen(s:str) -> int:
  ret runtime.memory.strlen(s)

fn strncmp(a:str, b:str, n:int) -> int:
  ret runtime.memory.strncmp(a, b, n)

fn strcpy(dst:*char, src:str) -> *char:
  ret runtime.memory.strcpy(dst, src)

fn strncpy(dst:*char, src:str, n:int) -> *char:
  ret runtime.memory.strncpy(dst, src, n)

fn strcat(dst:*char, src:str) -> *char:
  ret runtime.memory.strcat(dst, src)

fn strncat(dst:*char, src:str, n:int) -> *char:
  ret runtime.memory.strncat(dst, src, n)

fn strchr(s:str, c:int) -> int:
  ret runtime.memory.strchr(s, c)

fn strrchr(s:str, c:int) -> int:
  ret runtime.memory.strrchr(s, c)

fn strstr(haystack:str, needle:str) -> int:
  ret runtime.memory.strstr(haystack, needle)

fn atoi(s:str) -> int:
  ret runtime.format.atoi(s)

fn atol(s:str) -> int:
  ret runtime.format.atol(s)

fn atof(s:str) -> float:
  ret runtime.format.atof(s)

fn itoa(n:int) -> *char:
  ret runtime.format.itoa(n)

fn ftoa(f:float, decimals:int) -> *char:
  ret runtime.format.ftoa(f, decimals)

fn _rt_putc(buf:*char, pos:int, c:char) -> int:
  ret runtime.format._rt_putc(buf, pos, c)

fn _rt_puts_n(buf:*char, pos:int, s:str, max_chars:int) -> int:
  ret runtime.format._rt_puts_n(buf, pos, s, max_chars)

fn _rt_put_int(buf:*char, pos:int, n:int, base:int, uppercase:int) -> int:
  ret runtime.format._rt_put_int(buf, pos, n, base, uppercase)

fn _rt_put_float(buf:*char, pos:int, f:float, decimals:int, compact:int) -> int:
  ret runtime.format._rt_put_float(buf, pos, f, decimals, compact)

fn sprintf0(buf:*char, fmt:str) -> int:
  ret runtime.format.sprintf0(buf, fmt)

fn sprintf_int(buf:*char, fmt:str, arg:int) -> int:
  ret runtime.format.sprintf_int(buf, fmt, arg)

fn sprintf_str(buf:*char, fmt:str, arg:str) -> int:
  ret runtime.format.sprintf_str(buf, fmt, arg)

fn sprintf_float(buf:*char, fmt:str, arg:float) -> int:
  ret runtime.format.sprintf_float(buf, fmt, arg)

fn sprintf(buf:*char, fmt:str) -> int:
  ret runtime.format.sprintf(buf, fmt)

fn fputs(s:str, h:*char) -> int:
  ret runtime.system.fputs(s, h)

fn fputc(c:int, h:*char) -> int:
  ret runtime.system.fputc(c, h)

fn fgets(buf:*char, n:int, h:*char) -> int:
  ret runtime.system.fgets(buf, n, h)

fn _rt_env_init() -> int:
  ret runtime.system._rt_env_init()

fn setenv(key:str, value:str) -> int:
  ret runtime.system.setenv(key, value)

fn getenv(key:str) -> str:
  ret runtime.system.getenv(key)

fn unsetenv(key:str) -> int:
  ret runtime.system.unsetenv(key)

fn rt_abs(n:int) -> int:
  ret runtime.utility.rt_abs(n)

fn rt_min(a:int, b:int) -> int:
  ret runtime.utility.rt_min(a, b)

fn rt_max(a:int, b:int) -> int:
  ret runtime.utility.rt_max(a, b)

fn rt_clamp(v:int, lo:int, hi:int) -> int:
  ret runtime.utility.rt_clamp(v, lo, hi)

fn rt_fabs(f:float) -> float:
  ret runtime.utility.rt_fabs(f)

fn rt_fmin(a:float, b:float) -> float:
  ret runtime.utility.rt_fmin(a, b)

fn rt_fmax(a:float, b:float) -> float:
  ret runtime.utility.rt_fmax(a, b)

fn rt_fclamp(v:float, lo:float, hi:float) -> float:
  ret runtime.utility.rt_fclamp(v, lo, hi)

fn rt_alloc_str(n:int) -> *char:
  ret runtime.utility.rt_alloc_str(n)

fn rt_strdup(s:str) -> *char:
  ret runtime.utility.rt_strdup(s)

fn rt_strndup(s:str, n:int) -> *char:
  ret runtime.utility.rt_strndup(s, n)

fn rt_strcat_new(a:str, b:str) -> *char:
  ret runtime.utility.rt_strcat_new(a, b)

fn rt_strcat3_new(a:str, b:str, c:str) -> *char:
  ret runtime.utility.rt_strcat3_new(a, b, c)

fn rt_int_to_str(n:int) -> str:
  ret runtime.utility.rt_int_to_str(n)

fn rt_float_to_str(f:float) -> str:
  ret runtime.utility.rt_float_to_str(f)

fn rt_float_to_str_g(f:float) -> str:
  ret runtime.utility.rt_float_to_str_g(f)
