import "io"

let TTS_MAX_TEXT = 8192

fn _tts_strdup(s:*u8) -> *u8:
  if s == 0:
    ret 0 as *u8
  let n = len(s)
  let p:*u8 = malloc(n + 1)
  if p == 0:
    ret 0 as *u8
  unsafe:
    memcpy(p, s as *u8, n)
  p[n] = 0 as u8
  ret p as *u8

fn _tts_join2(a:*u8, b:*u8) -> *u8:
  if a == 0 || b == 0:
    ret 0 as *u8
  let na = len(a)
  let nb = len(b)
  let p:*u8 = malloc(na + nb + 1)
  if p == 0:
    ret 0 as *u8
  unsafe:
    memcpy(p, a as *u8, na)
    memcpy(p + na, b as *u8, nb)
  p[na + nb] = 0 as u8
  ret p as *u8

fn _tts_itoa_words(n:i64) -> *u8:
  if n == 0 - 9223372036854775807 - 1:
    ret _tts_strdup("negative nine quintillion two hundred twenty three quadrillion three hundred seventy two trillion thirty six billion eight hundred fifty four million seven hundred seventy five thousand eight hundred eight")
  if n < 0:
    let pos:*u8 = _tts_itoa_words(0 - n)
    let out:*u8 = _tts_join2("negative ", pos)
    free(pos)
    ret out
  if n == 0:
    ret _tts_strdup("zero")
  let ones:[*u8;20]
  ones[0] = ""
  ones[1] = "one"
  ones[2] = "two"
  ones[3] = "three"
  ones[4] = "four"
  ones[5] = "five"
  ones[6] = "six"
  ones[7] = "seven"
  ones[8] = "eight"
  ones[9] = "nine"
  ones[10] = "ten"
  ones[11] = "eleven"
  ones[12] = "twelve"
  ones[13] = "thirteen"
  ones[14] = "fourteen"
  ones[15] = "fifteen"
  ones[16] = "sixteen"
  ones[17] = "seventeen"
  ones[18] = "eighteen"
  ones[19] = "nineteen"
  let tens:[*u8;10]
  tens[0] = ""
  tens[1] = ""
  tens[2] = "twenty"
  tens[3] = "thirty"
  tens[4] = "forty"
  tens[5] = "fifty"
  tens[6] = "sixty"
  tens[7] = "seventy"
  tens[8] = "eighty"
  tens[9] = "ninety"
  if n < 20:
    ret _tts_strdup(ones[n])
  if n < 100:
    let t:*u8 = tens[n / 10]
    let r = n % 10
    if r == 0:
      ret _tts_strdup(t)
    let out:*u8 = _tts_join2(t, " ")
    let out2:*u8 = _tts_join2(out, ones[r])
    free(out)
    ret out2
  if n < 1000:
    let h:*u8 = ones[n / 100]
    let hstr:*u8 = _tts_join2(h, " hundred")
    let rem = n % 100
    if rem == 0:
      ret hstr
    let rstr:*u8 = _tts_itoa_words(rem)
    let out:*u8 = _tts_join2(hstr, " ")
    let out2:*u8 = _tts_join2(out, rstr)
    free(hstr)
    free(rstr)
    free(out)
    ret out2
  if n < 1000000:
    let t:*u8 = _tts_itoa_words(n / 1000)
    let ts:*u8 = _tts_join2(t, " thousand")
    free(t)
    let rem = n % 1000
    if rem == 0:
      ret ts
    let rstr:*u8 = _tts_itoa_words(rem)
    let out:*u8 = _tts_join2(ts, " ")
    let out2:*u8 = _tts_join2(out, rstr)
    free(ts)
    free(rstr)
    free(out)
    ret out2
  let scales:[i64;5] = [1000000, 1000000000, 1000000000000, 1000000000000000, 1000000000000000000]
  let names:[*u8;5] = [" million", " billion", " trillion", " quadrillion", " quintillion"]
  let group = 4
  while group >= 0:
    if n >= scales[group]:
      let prefix:*u8 = _tts_itoa_words(n / scales[group])
      let head:*u8 = _tts_join2(prefix, names[group])
      free(prefix)
      let rem = n % scales[group]
      if rem == 0:
        ret head
      let tail:*u8 = _tts_itoa_words(rem)
      let spaced:*u8 = _tts_join2(head, " ")
      let result:*u8 = _tts_join2(spaced, tail)
      free(head)
      free(tail)
      free(spaced)
      ret result
    group = group - 1
  ret 0 as *u8

fn _tts_normalize(text:*u8) -> *u8:
  if text == 0:
    ret 0 as *u8
  let n = len(text)
  if n > TTS_MAX_TEXT:
    ret 0 as *u8
  let capacity = n * 32 + 16
  let out:*u8 = malloc(capacity)
  if out == 0:
    ret 0 as *u8
  let oi = 0
  let i = 0
  while i < n:
    let c = (text as *u8)[i] as i64
    if c == 32 || c == 9 || c == 10 || c == 13:
      if oi > 0 && out[oi - 1] != 32 as u8:
        out[oi] = 32 as u8
        oi = oi + 1
      i = i + 1
      continue
    if c == 45 && i + 1 < n:
      let next = text[i + 1] as i64
      let boundary = 0
      if i == 0:
        boundary = 1
      else:
        if text[i - 1] == 32 as u8 || text[i - 1] == 9 as u8 || text[i - 1] == 10 as u8 || text[i - 1] == 13 as u8:
          boundary = 1
      if boundary != 0 && next >= 48 && next <= 57:
        memcpy(out + oi, "negative " as *u8, 9)
        oi = oi + 9
        i = i + 1
        continue
    if c >= 48 && c <= 57:
      let start = i
      while i < n:
        let d = (text as *u8)[i] as i64
        if d < 48 || d > 57:
          break
        i = i + 1
      let j = start
      while j < i:
        let num = 0
        if i - start <= 18:
          while j < i:
            num = num * 10 + ((text as *u8)[j] as i64 - 48)
            j = j + 1
        else:
          num = (text as *u8)[j] as i64 - 48
          j = j + 1
        let words:*u8 = _tts_itoa_words(num)
        if words == 0:
          free(out)
          ret 0 as *u8
        let wlen = len(words)
        if oi + wlen + 2 >= capacity:
          free(words)
          free(out)
          ret 0 as *u8
        if oi > 0 && out[oi - 1] != 32 as u8:
          out[oi] = 32 as u8
          oi = oi + 1
        memcpy(out + oi, words as *u8, wlen)
        oi = oi + wlen
        free(words)
      if i + 1 < n && text[i] == 46 as u8:
        let next = text[i + 1] as i64
        if next >= 48 && next <= 57:
          memcpy(out + oi, " point" as *u8, 6)
          oi = oi + 6
          i = i + 1
          while i < n:
            let digit = text[i] as i64 - 48
            if digit < 0 || digit > 9:
              break
            let word:*u8 = _tts_itoa_words(digit)
            if word == 0:
              free(out)
              ret 0 as *u8
            let size = len(word)
            out[oi] = 32 as u8
            oi = oi + 1
            memcpy(out + oi, word as *u8, size)
            oi = oi + size
            free(word)
            i = i + 1
      if i < n:
        out[oi] = 32 as u8
        oi = oi + 1
      continue
    let abbreviation = _abbreviation(text, i)
    if abbreviation >= 0:
      let short:[*u8;8] = ["mr.", "mrs.", "dr.", "ms.", "prof.", "jr.", "sr.", "etc."]
      let full:[*u8;8] = ["Mister", "Missus", "Doctor", "Miz", "Professor", "Junior", "Senior", "et cetera"]
      let size = len(full[abbreviation])
      memcpy(out + oi, full[abbreviation] as *u8, size)
      oi = oi + size
      i = i + len(short[abbreviation])
      if i < n:
        out[oi] = 32 as u8
        oi = oi + 1
      continue
    if c == 46 || c == 33 || c == 63 || c == 44:
      if oi > 0 && out[oi - 1] == 32 as u8:
        oi = oi - 1
      if c == 44:
        out[oi] = 44 as u8
      else:
        out[oi] = 46 as u8
      oi = oi + 1
      out[oi] = 32 as u8
      oi = oi + 1
      i = i + 1
      continue
    out[oi] = c as u8
    oi = oi + 1
    i = i + 1
  if oi > 0 && out[oi - 1] == 32 as u8:
    oi = oi - 1
  out[oi] = 0 as u8
  ret out as *u8

fn _abbreviation(text:*u8, index:i64):
  if index > 0:
    let previous = text[index - 1] as i64
    if previous >= 65 && previous <= 90:
      ret -1
    if previous >= 97 && previous <= 122:
      ret -1
    if previous >= 48 && previous <= 57:
      ret -1
    if previous == 39:
      ret -1
  let short:[*u8;8] = ["mr.", "mrs.", "dr.", "ms.", "prof.", "jr.", "sr.", "etc."]
  let length = len(text)
  let k = 0
  while k < 8:
    let size = len(short[k])
    if index + size <= length:
      let j = 0
      while j < size:
        let c = text[index + j] as i64
        if c >= 65 && c <= 90:
          c = c + 32
        if c != short[k][j] as i64:
          break
        j = j + 1
      if j == size:
        ret k
    k = k + 1
  ret -1

fn _latin1(second:i64):
  if second == 159:
    ret 0
  if second >= 160:
    second = second - 32
  if second >= 128 && second <= 133:
    ret 97
  if second == 135:
    ret 99
  if second >= 136 && second <= 139:
    ret 101
  if second >= 140 && second <= 143:
    ret 105
  if second == 144:
    ret 100
  if second == 145:
    ret 110
  if second >= 146 && second <= 150:
    ret 111
  if second == 152:
    ret 111
  if second >= 153 && second <= 156:
    ret 117
  if second == 157 || second == 159:
    ret 121
  ret 0

fn _ascii(text:*u8) -> *u8:
  if text == 0:
    ret 0 as *u8
  let length = len(text)
  if length > TTS_MAX_TEXT:
    ret 0 as *u8
  let out:*u8 = malloc(length + 1)
  if out == 0:
    ret 0 as *u8
  let i = 0
  let used = 0
  while i < length:
    let c = text[i] as i64 & 255
    let consumed = 1
    if c >= 128:
      c = 0
      let first = text[i] as i64 & 255
      if first == 195 && i + 1 < length:
        c = _latin1(text[i + 1] as i64 & 255)
        consumed = 2
      else:
        if first == 226 && i + 2 < length && (text[i + 1] as i64 & 255) == 128:
          let last = text[i + 2] as i64 & 255
          if last == 152 || last == 153:
            c = 39
          else:
            if last == 156 || last == 157:
              c = 34
            else:
              if last == 147 || last == 148:
                c = 45
          consumed = 3
      if c == 0:
        free(out)
        ret 0 as *u8
    out[used] = c as u8
    used = used + 1
    i = i + consumed
  out[used] = 0 as u8
  ret out as *u8

fn normalize(text:*u8) -> *u8:
  let ascii:*u8 = _ascii(text)
  if ascii == 0:
    ret 0 as *u8
  let expanded:*u8 = _tts_normalize(ascii)
  free(ascii)
  if expanded == 0:
    ret 0 as *u8
  let length = len(expanded)
  let out:*u8 = expanded as *u8
  let i = 0
  let used = 0
  while i < length:
    let c = expanded[i] as i64
    if c >= 65 && c <= 90:
      c = c + 32
    if c >= 97 && c <= 122 || c == 39:
      out[used] = c as u8
      used = used + 1
    else:
      if c == 32 || c == 9 || c == 10 || c == 13 || c == 46 || c == 44 || c == 58 || c == 59 || c == 45 || c == 34 || c == 40 || c == 41 || c == 91 || c == 93:
        if used > 0 && out[used - 1] != 32 as u8:
          out[used] = 32 as u8
          used = used + 1
      else:
        free(expanded)
        ret 0 as *u8
    i = i + 1
  if used > 0 && out[used - 1] == 32 as u8:
    used = used - 1
  out[used] = 0 as u8
  ret expanded

fn encode(text:*u8, labels:*i64, capacity:i64):
  if labels == 0 || capacity < 1:
    ret -1
  let canonical:*u8 = normalize(text)
  if canonical == 0:
    ret -1
  let length = len(canonical)
  if length < 1 || length > 448 || length > capacity:
    free(canonical)
    ret -1
  let i = 0
  while i < length:
    let c = canonical[i] as i64
    let label = c - 97 + 3
    if c == 32:
      label = 1
    else:
      if c == 39:
        label = 2
    labels[i] = label
    i = i + 1
  free(canonical)
  ret length

