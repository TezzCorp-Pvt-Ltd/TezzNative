import "tensor"
import "tensor_ptr"
import "tnx"

// v1 used dtype 0 for floating values. New files explicitly identify f64.
let MODEL_DTYPE_F32:int = 0
let MODEL_DTYPE_F64:int = 1
let MODEL_DTYPE_BOOL:int = 2

struct DenseModel:
  name:str
  in_dim:int
  out_dim:int
  w:*Tensor
  b:*Tensor

fn _mdl_strdup(s:str) -> str:
  if s == 0 as str: ret 0 as str
  n:int = len(s)
  out:*char = (*char)malloc(n + 1)
  if out == 0 as *char: ret 0 as str
  memcpy(out, s as *char, n + 1)
  ret out as str

fn _mdl_name(s:str) -> str:
  if s == 0 as str || len(s) == 0: ret "dense"
  ret s

// These helpers consume a child on both success and failure.
fn _mdl_set(parent:*TnxValue, key:str, value:*TnxValue) -> int:
  if value == 0 as *TnxValue: ret 0 - 1
  if tnx.obj_set(parent, key, value) == 0: ret 0
  tnx.release(value)
  ret 0 - 1

fn _mdl_push(parent:*TnxValue, value:*TnxValue) -> int:
  if value == 0 as *TnxValue: ret 0 - 1
  if tnx.arr_push(parent, value) == 0: ret 0
  tnx.release(value)
  ret 0 - 1

fn _mdl_array_len(value:*TnxValue) -> int:
  if value == 0 as *TnxValue || value.kind != 5: ret 0 - 1
  count:int = 0
  node:*TnxNode = value.head
  while node != 0 as *TnxNode:
    count = count + 1
    node = node.next
  ret count

fn _mdl_schema(root:*TnxValue, schema:str) -> int:
  if root == 0 as *TnxValue || root.kind != 6: ret 0
  value:str = tnx.tnx_as_str(tnx.obj_get(root, "schema"))
  if value == 0 as str: ret 0
  if strcmp(value, schema) == 0: ret 1
  ret 0

fn _mdl_load(path:str) -> *TnxValue:
  if path == 0 as str: ret 0 as *TnxValue
  root:*TnxValue = tnx.load_b(path)
  if root == 0 as *TnxValue: root = tnx.load(path)
  ret root

fn _mdl_numbers(value:*TnxValue, count:int) -> int:
  if _mdl_array_len(value) != count: ret 0
  node:*TnxNode = value.head
  while node != 0 as *TnxNode:
    if node.val == 0 as *TnxValue: ret 0
    if node.val.kind != 2 && node.val.kind != 3: ret 0
    node = node.next
  ret 1

fn _mdl_fill(value:*Tensor, array:*TnxValue) -> int:
  if value == 0 as *Tensor || _mdl_numbers(array, value.size) == 0: ret 0 - 1
  node:*TnxNode = array.head
  i:int = 0
  while node != 0 as *TnxNode:
    tensor_ptr.set_f(value, i, tnx.tnx_as_float(node.val))
    node = node.next
    i = i + 1
  ret 0

fn _mdl_data(value:*Tensor) -> *TnxValue:
  if value == 0 as *Tensor || value.data == 0 as *float: ret 0 as *TnxValue
  array:*TnxValue = tnx.arr()
  if array == 0 as *TnxValue: ret array
  i:int = 0
  while i < value.size:
    if _mdl_push(array, tnx.tnx_float(tensor_ptr.get_f(value, i))) != 0:
      tnx.release(array)
      ret 0 as *TnxValue
    i = i + 1
  ret array

fn dense_new(in_dim:int, out_dim:int, name:str) -> *DenseModel:
  if in_dim <= 0 || out_dim <= 0 || in_dim > 1152921504606846975 / out_dim: ret 0 as *DenseModel
  model:*DenseModel = (*DenseModel)malloc(sizeof(DenseModel))
  if model == 0 as *DenseModel: ret model
  model.name = _mdl_strdup(_mdl_name(name))
  model.in_dim = in_dim
  model.out_dim = out_dim
  model.w = 0 as *Tensor
  model.b = 0 as *Tensor
  shape:[int;2] = [in_dim, out_dim]
  bias:[int;1] = [out_dim]
  model.w = tensor_ptr.create(&shape[0], 2, 1)
  model.b = tensor_ptr.create(&bias[0], 1, 1)
  if model.name == 0 as str || model.w == 0 as *Tensor || model.b == 0 as *Tensor:
    dense_free(model)
    ret 0 as *DenseModel
  i:int = 0
  while i < model.w.size:
    tensor_ptr.set_f(model.w, i, (((i % 97) - 48) as float) / 97.0)
    i = i + 1
  ret model

fn dense_free(model:*DenseModel) -> int:
  if model == 0 as *DenseModel: ret 0
  tensor_ptr.release(model.w)
  tensor_ptr.release(model.b)
  if model.name != 0 as str: free(model.name as *char)
  free(model as *char)
  ret 0

fn dense_forward(model:*DenseModel, x:*Tensor) -> *Tensor:
  if model == 0 as *DenseModel || x == 0 as *Tensor: ret 0 as *Tensor
  if x.ndim != 2 || x.shape1 != model.in_dim: ret 0 as *Tensor
  product:*Tensor = tensor_ptr.matmul(x, model.w)
  if product == 0 as *Tensor: ret product
  out:*Tensor = tensor_ptr.add(product, model.b)
  tensor_ptr.release(product)
  ret out

fn tensor_save_tnxb(value:*Tensor, path:str) -> int:
  if value == 0 as *Tensor || value.data == 0 as *float || path == 0 as str: ret 0 - 1
  if value.dtype != tensor.tensor_dtype_f64() || value.ndim < 0 || value.ndim > 8: ret 0 - 1
  root:*TnxValue = tnx.obj()
  if root == 0 as *TnxValue: ret 0 - 1
  if _mdl_set(root, "schema", tnx.tnx_str("tezz_tensor_v2")) != 0 || _mdl_set(root, "dtype", tnx.tnx_int(value.dtype)) != 0 || _mdl_set(root, "rank", tnx.tnx_int(value.ndim)) != 0:
    tnx.release(root)
    ret 0 - 1
  shape:*TnxValue = tnx.arr()
  if _mdl_set(root, "shape", shape) != 0:
    tnx.release(root)
    ret 0 - 1
  i:int = 0
  while i < value.ndim:
    if _mdl_push(shape, tnx.tnx_int(tensor.tensor_shape(*value, i))) != 0:
      tnx.release(root)
      ret 0 - 1
    i = i + 1
  if _mdl_set(root, "data", _mdl_data(value)) != 0:
    tnx.release(root)
    ret 0 - 1
  status:int = tnx.save_b(path, root)
  tnx.release(root)
  ret status

fn tensor_load_tnxb(path:str) -> *Tensor:
  root:*TnxValue = _mdl_load(path)
  if root == 0 as *TnxValue: ret 0 as *Tensor
  legacy:int = _mdl_schema(root, "tezz_tensor_v1")
  dtype:*TnxValue = tnx.obj_get(root, "dtype")
  rank_value:*TnxValue = tnx.obj_get(root, "rank")
  valid:int = 1
  if legacy == 0 && _mdl_schema(root, "tezz_tensor_v2") == 0: valid = 0
  if dtype == 0 as *TnxValue || rank_value == 0 as *TnxValue: valid = 0
  if valid != 0:
    if dtype.kind != 2 || rank_value.kind != 2: valid = 0
    if legacy != 0:
      if dtype.i != MODEL_DTYPE_F32: valid = 0
    else:
      if dtype.i != tensor.tensor_dtype_f64(): valid = 0
  if valid == 0:
    tnx.release(root)
    ret 0 as *Tensor
  rank:int = rank_value.i
  shape:*TnxValue = tnx.obj_get(root, "shape")
  data:*TnxValue = tnx.obj_get(root, "data")
  if rank < 0 || rank > 8 || _mdl_array_len(shape) != rank:
    tnx.release(root)
    ret 0 as *Tensor
  dims:[int;8]
  i:int = 0
  total:int = 1
  while i < rank:
    d:*TnxValue = tnx.arr_get(shape, i)
    if d == 0 as *TnxValue || d.kind != 2:
      tnx.release(root)
      ret 0 as *Tensor
    if d.i <= 0 || total > 1152921504606846975 / d.i:
      tnx.release(root)
      ret 0 as *Tensor
    dims[i] = d.i
    total = total * d.i
    i = i + 1
  if _mdl_numbers(data, total) == 0:
    tnx.release(root)
    ret 0 as *Tensor
  out:*Tensor = tensor_ptr.create(&dims[0], rank, 0)
  if out != 0 as *Tensor: _mdl_fill(out, data)
  tnx.release(root)
  ret out

fn dense_save(model:*DenseModel, path:str) -> int:
  if model == 0 as *DenseModel || path == 0 as str || model.w == 0 as *Tensor || model.b == 0 as *Tensor: ret 0 - 1
  if model.w.ndim != 2 || model.w.shape0 != model.in_dim || model.w.shape1 != model.out_dim || model.b.ndim != 1 || model.b.size != model.out_dim: ret 0 - 1
  root:*TnxValue = tnx.obj()
  if root == 0 as *TnxValue: ret 0 - 1
  if _mdl_set(root, "schema", tnx.tnx_str("tezz_dense_v1")) != 0 || _mdl_set(root, "name", tnx.tnx_str(_mdl_name(model.name))) != 0 || _mdl_set(root, "in_dim", tnx.tnx_int(model.in_dim)) != 0 || _mdl_set(root, "out_dim", tnx.tnx_int(model.out_dim)) != 0 || _mdl_set(root, "w", _mdl_data(model.w)) != 0 || _mdl_set(root, "b", _mdl_data(model.b)) != 0:
    tnx.release(root)
    ret 0 - 1
  status:int = tnx.save_b(path, root)
  tnx.release(root)
  ret status

fn dense_load(path:str) -> *DenseModel:
  root:*TnxValue = _mdl_load(path)
  if _mdl_schema(root, "tezz_dense_v1") == 0:
    tnx.release(root)
    ret 0 as *DenseModel
  in_value:*TnxValue = tnx.obj_get(root, "in_dim")
  out_value:*TnxValue = tnx.obj_get(root, "out_dim")
  name:str = tnx.tnx_as_str(tnx.obj_get(root, "name"))
  if in_value == 0 as *TnxValue || out_value == 0 as *TnxValue:
    tnx.release(root)
    ret 0 as *DenseModel
  if in_value.kind != 2 || out_value.kind != 2 || in_value.i <= 0 || out_value.i <= 0:
    tnx.release(root)
    ret 0 as *DenseModel
  if in_value.i > 1152921504606846975 / out_value.i:
    tnx.release(root)
    ret 0 as *DenseModel
  weights:*TnxValue = tnx.obj_get(root, "w")
  biases:*TnxValue = tnx.obj_get(root, "b")
  if _mdl_numbers(weights, in_value.i * out_value.i) == 0 || _mdl_numbers(biases, out_value.i) == 0:
    tnx.release(root)
    ret 0 as *DenseModel
  model:*DenseModel = dense_new(in_value.i, out_value.i, name)
  if model != 0 as *DenseModel:
    _mdl_fill(model.w, weights)
    _mdl_fill(model.b, biases)
  tnx.release(root)
  ret model
