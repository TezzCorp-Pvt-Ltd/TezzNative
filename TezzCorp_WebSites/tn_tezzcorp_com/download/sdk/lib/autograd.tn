// Compatibility entry points for the current tensor reverse-mode engine.
// These functions share tensor's tape, saved values, and gradient ownership.
import "tensor"

let AG_OP_NONE:int = 0
let AG_OP_ADD:int = 1
let AG_OP_SUB:int = 2
let AG_OP_MUL:int = 3
let AG_OP_MATMUL:int = 4
let AG_OP_RELU:int = 5
let AG_OP_SIGMOID:int = 6
let AG_OP_SILU:int = 7
let AG_OP_GELU:int = 8
let AG_OP_SCALE:int = 9
let AG_OP_SUM:int = 10
let AG_OP_MEAN:int = 11
let AG_OP_MSE_LOSS:int = 12

fn autograd_init(cap:int) -> int:
  // The shared engine reports capacity exhaustion instead of dropping nodes.
  if cap > 8192: ret 0 - 1
  tensor.tape_set_enabled(1)
  ret tensor.tape_init()

fn autograd_reset() -> int:
  ret tensor.tape_reset()

fn ag_parameter(t:Tensor) -> Tensor:
  ret tensor.tensor_require_grad(t)

fn ag_grad(t:Tensor) -> Tensor:
  ret tensor.tensor_get_grad(t)

fn ag_zero_grad(t:Tensor) -> int:
  ret tensor.tensor_zero_grad(t)

// Low-level compatibility hook. The caller must attach out.grad first.
fn _record_node(op:int, a:Tensor, b:Tensor, out:Tensor, aux:float) -> int:
  if out.grad == 0 as *Tensor || out.requires_grad == 0: ret 0 - 1
  mapped:int = 0
  if op == AG_OP_ADD: mapped = 1
  else if op == AG_OP_SUB: mapped = 2
  else if op == AG_OP_MUL: mapped = 3
  else if op == AG_OP_MATMUL: mapped = 5
  else if op == AG_OP_RELU: mapped = 8
  else if op == AG_OP_SIGMOID: mapped = 11
  else if op == AG_OP_SILU: mapped = 10
  else if op == AG_OP_GELU: mapped = 9
  else if op == AG_OP_SCALE: mapped = 6
  else if op == AG_OP_SUM: mapped = 13
  else if op == AG_OP_MEAN: mapped = 14
  else if op == AG_OP_MSE_LOSS: mapped = 20
  if mapped == 0: ret 0 - 1
  status:int = 0
  if op == AG_OP_ADD || op == AG_OP_SUB || op == AG_OP_MUL || op == AG_OP_MATMUL || op == AG_OP_MSE_LOSS:
    status = tensor.tape_record_binary(mapped, out, a, b, aux, 0, 0)
  else:
    status = tensor.tape_record_unary(mapped, out, a, out, aux, 0, 0)
  if status != 0: ret status
  ret tensor.tape_len()

fn _accum_grad_to_target(grad_ptr:int, tgt_r:int, tgt_c:int, g_src:*float, g_size:int, out_r:int, out_c:int) -> int:
  if grad_ptr == 0: ret 0
  if g_src == 0 as *float || g_size <= 0 || out_r <= 0: ret 0 - 1
  unsafe:
    target:*Tensor = grad_ptr as *Tensor
    gradient:Tensor = tensor.tensor_load_p(target)
    gradient.data = g_src
    gradient.grad = 0 as *Tensor
    gradient.requires_grad = 0
    gradient.is_view = 1
    gradient.offset = 0
    gradient.ndim = 1
    gradient.shape0 = out_r
    gradient.shape1 = 0
    if out_c > 0:
      if out_r > 1152921504606846975 / out_c || g_size != out_r * out_c: ret 0 - 1
      gradient.ndim = 2
      gradient.shape1 = out_c
    else:
      if g_size != out_r: ret 0 - 1
    gradient.size = g_size
    gradient = tensor.tensor_calc_strides(gradient)
    collapsed:Tensor = tensor.tensor_collapse_to_shape(gradient, tensor.tensor_load_p(target))
    status:int = tensor.tensor_accumulate_grad(target, collapsed)
    tensor.tensor_free_tensor(collapsed)
    ret status

fn _accum_to_node(node_id:int, g_src:*float, g_size:int) -> int:
  if node_id <= 0 || node_id > tensor.tape_len() || g_src == 0 as *float: ret 0 - 1
  unsafe:
    nodes:*TapeNode = tensor.tape_get()
    target:*Tensor = nodes[node_id - 1].out_grad
    if target == 0 as *Tensor || target.size != g_size: ret 0 - 1
    gradient:Tensor = tensor.tensor_load_p(target)
    gradient.data = g_src
    gradient.grad = 0 as *Tensor
    gradient.requires_grad = 0
    gradient.is_view = 1
    ret tensor.tensor_accumulate_grad(target, gradient)

fn ag_add(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.tensor_add(a, b)

fn ag_sub(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.tensor_sub(a, b)

fn ag_mul(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.tensor_mul(a, b)

fn ag_matmul(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.tensor_matmul(a, b)

fn ag_scale(a:Tensor, s:float) -> Tensor:
  ret tensor.tensor_scale(a, s)

fn ag_relu(a:Tensor) -> Tensor:
  ret tensor.tensor_relu(a)

fn ag_sigmoid(a:Tensor) -> Tensor:
  ret tensor.tensor_sigmoid(a)

fn ag_silu(a:Tensor) -> Tensor:
  ret tensor.tensor_silu(a)

fn ag_gelu(a:Tensor) -> Tensor:
  ret tensor.tensor_gelu(a)

fn ag_sum(a:Tensor) -> Tensor:
  ret tensor.tensor_sum_all_t(a)

fn ag_mean(a:Tensor) -> Tensor:
  ret tensor.tensor_mean_all_t(a)

fn ag_mse_loss(pred:Tensor, target:Tensor) -> Tensor:
  ret tensor.tensor_mse_loss(pred, target)

fn autograd_backward(loss:Tensor) -> int:
  ret tensor.tensor_backward(loss)
