// Local static-file development server. Binds only to loopback.
// Authentication/enrollment and database authorization belong to the application;
// the former unauthenticated demonstration endpoints are explicitly unavailable.
import "net"
import "str"
import "io"
import "runtime"

extern fn tn_security_public_path(root:str, relative:str) -> str

let SERVER_MAX_REQUEST_BYTES:int = 16384
let SERVER_MAX_BODY_BYTES:int = 4096

fn get_mime_type(filename:str) -> str:
  if filename == 0 as str:
    ret "application/octet-stream"
  
  // HTML & Documents
  if str.str_ends_with(filename, ".html") != 0 || str.str_ends_with(filename, ".htm") != 0:
    ret "text/html; charset=utf-8"
  if str.str_ends_with(filename, ".css") != 0:
    ret "text/css; charset=utf-8"
  if str.str_ends_with(filename, ".js") != 0 || str.str_ends_with(filename, ".mjs") != 0:
    ret "application/javascript; charset=utf-8"
  if str.str_ends_with(filename, ".ts") != 0 && str.str_ends_with(filename, ".m3u8.ts") == 0:
    ret "application/typescript; charset=utf-8"
  if str.str_ends_with(filename, ".json") != 0:
    ret "application/json; charset=utf-8"
  if str.str_ends_with(filename, ".xml") != 0:
    ret "application/xml; charset=utf-8"
  if str.str_ends_with(filename, ".yaml") != 0 || str.str_ends_with(filename, ".yml") != 0:
    ret "text/yaml; charset=utf-8"
  if str.str_ends_with(filename, ".pdf") != 0:
    ret "application/pdf"
  if str.str_ends_with(filename, ".txt") != 0 || str.str_ends_with(filename, ".md") != 0:
    ret "text/plain; charset=utf-8"
  if str.str_ends_with(filename, ".csv") != 0:
    ret "text/csv; charset=utf-8"

  // Programming & Scripts
  if str.str_ends_with(filename, ".tn") != 0:
    ret "text/x-tezznative; charset=utf-8"
  if str.str_ends_with(filename, ".py") != 0:
    ret "text/x-python; charset=utf-8"
  if str.str_ends_with(filename, ".c") != 0 || str.str_ends_with(filename, ".h") != 0 || str.str_ends_with(filename, ".cpp") != 0:
    ret "text/x-c; charset=utf-8"
  if str.str_ends_with(filename, ".java") != 0:
    ret "text/x-java; charset=utf-8"
  if str.str_ends_with(filename, ".go") != 0:
    ret "text/x-go; charset=utf-8"
  if str.str_ends_with(filename, ".rs") != 0:
    ret "text/x-rust; charset=utf-8"
  if str.str_ends_with(filename, ".php") != 0:
    ret "application/x-httpd-php; charset=utf-8"
  if str.str_ends_with(filename, ".sh") != 0 || str.str_ends_with(filename, ".ps1") != 0:
    ret "application/x-sh; charset=utf-8"

  // Images & Graphics
  if str.str_ends_with(filename, ".png") != 0:
    ret "image/png"
  if str.str_ends_with(filename, ".jpg") != 0 || str.str_ends_with(filename, ".jpeg") != 0:
    ret "image/jpeg"
  if str.str_ends_with(filename, ".webp") != 0:
    ret "image/webp"
  if str.str_ends_with(filename, ".gif") != 0:
    ret "image/gif"
  if str.str_ends_with(filename, ".svg") != 0:
    ret "image/svg+xml"
  if str.str_ends_with(filename, ".ico") != 0:
    ret "image/x-icon"
  if str.str_ends_with(filename, ".avif") != 0:
    ret "image/avif"
  if str.str_ends_with(filename, ".bmp") != 0:
    ret "image/bmp"
  if str.str_ends_with(filename, ".tiff") != 0 || str.str_ends_with(filename, ".tif") != 0:
    ret "image/tiff"

  // Audio & Video Streaming
  if str.str_ends_with(filename, ".mp4") != 0:
    ret "video/mp4"
  if str.str_ends_with(filename, ".webm") != 0:
    ret "video/webm"
  if str.str_ends_with(filename, ".mkv") != 0:
    ret "video/x-matroska"
  if str.str_ends_with(filename, ".avi") != 0:
    ret "video/x-msvideo"
  if str.str_ends_with(filename, ".mov") != 0:
    ret "video/quicktime"
  if str.str_ends_with(filename, ".m3u8") != 0:
    ret "application/x-mpegURL"
  if str.str_ends_with(filename, ".ts") != 0:
    ret "video/MP2T"
  if str.str_ends_with(filename, ".mp3") != 0:
    ret "audio/mpeg"
  if str.str_ends_with(filename, ".wav") != 0:
    ret "audio/wav"
  if str.str_ends_with(filename, ".ogg") != 0:
    ret "audio/ogg"
  if str.str_ends_with(filename, ".flac") != 0:
    ret "audio/flac"
  if str.str_ends_with(filename, ".m4a") != 0:
    ret "audio/mp4"

  // Fonts
  if str.str_ends_with(filename, ".woff2") != 0:
    ret "font/woff2"
  if str.str_ends_with(filename, ".woff") != 0:
    ret "font/woff"
  if str.str_ends_with(filename, ".ttf") != 0:
    ret "font/ttf"
  if str.str_ends_with(filename, ".otf") != 0:
    ret "font/otf"
  if str.str_ends_with(filename, ".eot") != 0:
    ret "application/vnd.ms-fontobject"

  // Archives & Compressed
  if str.str_ends_with(filename, ".zip") != 0:
    ret "application/zip"
  if str.str_ends_with(filename, ".tar") != 0:
    ret "application/x-tar"
  if str.str_ends_with(filename, ".gz") != 0:
    ret "application/gzip"
  if str.str_ends_with(filename, ".7z") != 0:
    ret "application/x-7z-compressed"
  if str.str_ends_with(filename, ".rar") != 0:
    ret "application/vnd.rar"
  if str.str_ends_with(filename, ".bz2") != 0:
    ret "application/x-bzip2"
  if str.str_ends_with(filename, ".xz") != 0:
    ret "application/x-xz"

  // Databases & Tezz Bytecode
  if str.str_ends_with(filename, ".sql") != 0:
    ret "application/sql; charset=utf-8"
  if str.str_ends_with(filename, ".db") != 0 || str.str_ends_with(filename, ".sqlite") != 0:
    ret "application/x-sqlite3"
  if str.str_ends_with(filename, ".tnx") != 0 || str.str_ends_with(filename, ".tnxb") != 0:
    ret "application/x-tezz-bytecode"
  if str.str_ends_with(filename, ".wasm") != 0:
    ret "application/wasm"

  ret "application/octet-stream"

// Append consumes only the owned left operand.
fn _append(owned:str, suffix:str) -> str:
  if owned == 0: ret 0 as str
  out:str = str.str_cat(owned, suffix)
  free(owned)
  ret out

fn html_escape(value:str) -> str:
  if value == 0: ret str.str_dup("")
  n:int = len(value)
  if n > 1048576: ret 0 as str
  out:*char = malloc(n * 6 + 1)
  if out == 0: ret 0 as str
  i:int = 0
  used:int = 0
  while i < n:
    c:int = value[i] as int
    replacement:str = ""
    if c == 38: replacement = "&amp;"
    else if c == 60: replacement = "&lt;"
    else if c == 62: replacement = "&gt;"
    else if c == 34: replacement = "&quot;"
    else if c == 39: replacement = "&#39;"
    if replacement[0] != 0 as char:
      amount:int = len(replacement)
      unsafe:
        memcpy(out + used, replacement as *char, amount)
      used = used + amount
    else:
      out[used] = value[i]
      used = used + 1
    i = i + 1
  out[used] = 0 as char
  ret out as str

fn _hex(c:int) -> int:
  if c >= 48 && c <= 57: ret c - 48
  if c >= 65 && c <= 70: ret c - 55
  if c >= 97 && c <= 102: ret c - 87
  ret -1

// An owned relative path on success; NULL means malformed or private.
fn sanitize_request_path(req_path:str) -> str:
  if req_path == 0 || len(req_path) == 0 || req_path[0] != 47 as char:
    ret 0 as str
  n:int = len(req_path)
  if n > 4096: ret 0 as str
  out:*char = malloc(n + 1)
  if out == 0: ret 0 as str
  i:int = 1
  used:int = 0
  component_start:int = 1
  while i < n:
    c:int = req_path[i] as int & 255
    if c == 63: break
    if c == 37:
      if i + 2 >= n:
        free(out)
        ret 0 as str
      high:int = _hex(req_path[i + 1] as int)
      low:int = _hex(req_path[i + 2] as int)
      if high < 0 || low < 0:
        free(out)
        ret 0 as str
      c = high * 16 + low
      i = i + 2
    // Reject NUL/control bytes, Windows path syntax and hidden components.
    if c < 32 || c == 127 || c == 92 || c == 58 || c == 35:
      free(out)
      ret 0 as str
    if component_start != 0 && c == 46:
      free(out)
      ret 0 as str
    if c == 47:
      if used == 0 || component_start != 0:
        free(out)
        ret 0 as str
      component_start = 1
    else:
      component_start = 0
    out[used] = c as char
    used = used + 1
    i = i + 1
  if used == 0:
    out[used] = 46 as char
    used = used + 1
  out[used] = 0 as char
  ret out as str

fn _private_file(path:str) -> int:
  lower:str = str.str_lower(path)
  if lower == 0: ret 1
  denied:int = str.str_ends_with(lower, ".tdb") || str.str_ends_with(lower, ".db")
  denied = denied || str.str_ends_with(lower, ".sqlite") || str.str_ends_with(lower, ".sqlite3")
  denied = denied || str.str_ends_with(lower, ".wal") || str.str_ends_with(lower, "-journal")
  denied = denied || str.str_ends_with(lower, ".key") || str.str_ends_with(lower, ".pem")
  denied = denied || str.str_ends_with(lower, ".pfx") || str.str_ends_with(lower, ".p12")
  free(lower)
  ret denied

fn render_directory_html(dir_path:str, raw_url:str) -> str:
  safe_url:str = html_escape(raw_url)
  if safe_url == 0: ret 0 as str
  page:str = str.str_cat("<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Directory: ", safe_url)
  page = _append(page, "</title><style>body{font-family:system-ui;margin:2rem;line-height:1.5}main{max-width:60rem;margin:auto}a{display:block;padding:.75rem;overflow-wrap:anywhere}</style></head><body><main><h1>Directory: ")
  page = _append(page, safe_url)
  page = _append(page, "</h1><ul>")
  free(safe_url)
  base:str = str.str_dup(raw_url)
  query:int = str.str_find(base, "?")
  if query >= 0:
    shorter:str = str.str_slice(base, 0, query)
    free(base)
    base = shorter
  if str.str_ends_with(base, "/") == 0: base = _append(base, "/")
  entries:str = io.dir_list(dir_path)
  pos:int = 0
  n:int = str.str_len(entries)
  while pos < n:
    start:int = pos
    while pos < n && entries[pos] != 10 as char: pos = pos + 1
    name:str = str.str_slice(entries, start, pos)
    pos = pos + 1
    if name != 0 && len(name) > 0 && name[0] != 46 as char && _private_file(name) == 0:
      child:str = tn_security_public_path(dir_path, name)
      if child != 0 && _private_file(child) == 0:
        encoded:str = net.url_encode_component(name)
        href:str = str.str_cat(base, encoded)
        if io.dir_exists(child) != 0: href = _append(href, "/")
        safe_href:str = html_escape(href)
        safe_name:str = html_escape(name)
        page = _append(page, "<li><a href='")
        page = _append(page, safe_href)
        page = _append(page, "'>")
        page = _append(page, safe_name)
        page = _append(page, "</a></li>")
        if encoded != 0: free(encoded)
        if href != 0: free(href)
        if safe_href != 0: free(safe_href)
        if safe_name != 0: free(safe_name)
      if child != 0: free(child)
    if name != 0: free(name)
  if entries != 0: free(entries)
  if base != 0: free(base)
  ret _append(page, "</ul></main></body></html>")

fn render_404_html(raw_path:str) -> str:
  safe:str = html_escape(raw_path)
  if safe == 0: ret 0 as str
  page:str = str.str_cat3("<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>404 Not Found</title><h1>404 Not Found</h1><p>Path: <code>", safe, "</code></p></html>")
  free(safe)
  ret page

fn handle_health_api(sock:int, active_port:int) -> int:
  port:str = str.int_to_str(active_port)
  response:str = str.str_cat3("{\"status\":\"ACTIVE\",\"server\":\"TezzNative local server\",\"port\":", port, "}")
  if port != 0: free(port)
  result:int = net.http_respond_json(sock, 200, response)
  if response != 0: free(response)
  ret result

fn handle_db_api(sock:int, raw_path:str) -> int:
  ret net.http_respond_json(sock, 403, "{\"error\":\"Database HTTP access requires application authorization\"}")

fn handle_db_api_legacy(sock:int, raw_path:str) -> int:
  ret handle_db_api(sock, raw_path)

fn handle_otp_api(sock:int, raw_path:str) -> int:
  ret net.http_respond_json(sock, 503, "{\"error\":\"OTP HTTP access requires application enrollment and replay protection\"}")

// Streams at most 64 KiB at a time; a short read or send reports failure.
fn stream_file_response(sock:int, file_path:str, mime:str, file_size:int) -> int:
  if file_size < 0: ret -1
  file:*File = io.file_open(file_path, "rb")
  if file == 0: ret -1
  buffer:*char = malloc(65536)
  if buffer == 0:
    io.file_close(file)
    ret -1
  size_text:str = str.int_to_str(file_size)
  header:str = str.str_cat("HTTP/1.1 200 OK\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\nContent-Type: ", mime)
  header = _append(header, "\r\nContent-Length: ")
  header = _append(header, size_text)
  header = _append(header, "\r\n\r\n")
  if size_text != 0: free(size_text)
  remaining:int = file_size
  status:int = -1
  if header != 0 && net.tcp_send_all(sock, header as *char, len(header)) == len(header):
    while remaining > 0:
      amount:int = 65536
      if remaining < amount: amount = remaining
      count:int = io.file_read(file, buffer, amount)
      if count <= 0: break
      if net.tcp_send_all(sock, buffer, count) != count: break
      remaining = remaining - count
    if remaining == 0: status = 0
  free(buffer)
  if header != 0: free(header)
  if io.file_close(file) != 0: status = -1
  ret status

fn serve_request(sock:int, raw_path:str, active_port:int) -> int:
  if str.str_eq(raw_path, "/health") != 0:
    ret handle_health_api(sock, active_port)
  if str.str_starts_with(raw_path, "/api/db") != 0:
    ret handle_db_api(sock, raw_path)
  if str.str_starts_with(raw_path, "/api/otp") != 0:
    ret handle_otp_api(sock, raw_path)
  relative:str = sanitize_request_path(raw_path)
  if relative == 0: ret net.http_respond_bad_request(sock)
  file_path:str = tn_security_public_path(".", relative)
  free(relative)
  if file_path == 0: ret net.http_respond_not_found(sock)
  if _private_file(file_path) != 0:
    free(file_path)
    ret net.http_respond_not_found(sock)
  if io.dir_exists(file_path) != 0:
    index_html:str = str.str_cat(file_path, "/index.html")
    index_htm:str = str.str_cat(file_path, "/index.htm")
    selected:str = 0 as str
    if io.file_exists(index_html) != 0:
      selected = tn_security_public_path(file_path, "index.html")
    else if io.file_exists(index_htm) != 0:
      selected = tn_security_public_path(file_path, "index.htm")
    free(index_html)
    free(index_htm)
    if selected != 0:
      free(file_path)
      file_path = selected
    else:
      page:str = render_directory_html(file_path, raw_path)
      status:int = net.http_write_response(sock, 200, "text/html; charset=utf-8", page)
      if page != 0: free(page)
      free(file_path)
      ret status
  status:int = stream_file_response(sock, file_path, get_mime_type(file_path), io.file_size_bytes(file_path))
  free(file_path)
  ret status

fn write_server_lockfile(port:int, pid:int, cwd_path:str, base_dir:str) -> int:
  port_text:str = str.int_to_str(port)
  pid_text:str = str.int_to_str(pid)
  content:str = str.str_cat("PORT=", port_text)
  content = _append(content, "\nPID=")
  content = _append(content, pid_text)
  content = _append(content, "\nDIR=")
  content = _append(content, cwd_path)
  content = _append(content, "\nSTATUS=ACTIVE\n")
  if port_text != 0: free(port_text)
  if pid_text != 0: free(pid_text)
  if content == 0: ret -1
  home_dir:str = runtime.getenv("USERPROFILE")
  if home_dir != 0 && len(home_dir) > 0:
    install_lock:str = io.path_join2(home_dir, ".tezznative/tezz_server.lock")
    io.write_all(install_lock, content)
    if install_lock != 0: free(install_lock)
  if home_dir != 0: free(home_dir)
  if io.dir_exists(".log") == 0: io.dir_make(".log")
  result:int = io.write_all(".log/tezz_server.lock", content)
  free(content)
  ret result

fn server_arg_int(index:int, fallback:int) -> int:
  if index < 0 || index >= args_count(): ret fallback
  raw:str = arg(index)
  if raw == 0 || len(raw) == 0: ret fallback
  value:int = 0
  i:int = 0
  while i < len(raw):
    c:int = raw[i] as int
    if c < 48 || c > 57 || value > 214748364: ret fallback
    value = value * 10 + c - 48
    i = i + 1
  ret value

fn get_server_port() -> int:
  ret server_arg_int(0, 8000)

fn _local_host(request:str, port:int) -> int:
  host:str = net.http_get_header(request, "Host")
  number:str = str.int_to_str(port)
  expected_ip:str = str.str_cat("127.0.0.1:", number)
  expected_name:str = str.str_cat("localhost:", number)
  valid:int = str.str_eq(host, expected_ip) || str.str_eq(host, expected_name)
  if port == 80: valid = valid || str.str_eq(host, "127.0.0.1") || str.str_eq(host, "localhost")
  origin:str = net.http_get_header(request, "Origin")
  if origin != 0 && len(origin) > 0:
    origin_ip:str = str.str_cat("http://", expected_ip)
    origin_name:str = str.str_cat("http://", expected_name)
    valid = valid && (str.str_eq(origin, origin_ip) || str.str_eq(origin, origin_name))
    free(origin_ip)
    free(origin_name)
  if origin != 0: free(origin)
  if host != 0: free(host)
  if number != 0: free(number)
  if expected_ip != 0: free(expected_ip)
  if expected_name != 0: free(expected_name)
  ret valid

fn run_server(port:int) -> int:
  if port <= 0 || port >= 65536: ret 2
  if net.init() != 0: ret 1
  listener:int = net.http_server_listen("127.0.0.1", port, 128)
  if listener < 0: ret 1
  cwd_path:str = io.cwd()
  write_server_lockfile(port, server_arg_int(1, 0), cwd_path, cwd_path)
  if cwd_path != 0: free(cwd_path)
  say "[TezzNative local HTTP server] Ready on 127.0.0.1:", port
  while 1:
    client:int = net.http_server_accept(listener, 2000)
    if client < 0: continue
    net.set_timeout(client, 5000)
    request:str = net.http_read_request(client, SERVER_MAX_REQUEST_BYTES)
    if request != 0:
      if net.http_request_start_line_valid(request) == 0:
        net.http_respond_bad_request(client)
      else if _local_host(request, port) == 0:
        net.http_respond_text(client, 403, "Local Host and Origin required")
      else:
        method:str = net.http_method(request)
        path:str = net.http_path(request)
        body_length:int = net.http_content_length(request)
        if body_length < 0 || body_length > SERVER_MAX_BODY_BYTES:
          net.http_respond_text(client, 413, "Request body too large")
        else if str.str_eq(method, "GET") != 0:
          serve_request(client, path, port)
        else:
          net.http_respond_text(client, 405, "Method Not Allowed")
        if method != 0: free(method)
        if path != 0: free(path)
      free(request)
    net.close(client)
  ret 0

fn main() -> int:
  ret run_server(get_server_port())
