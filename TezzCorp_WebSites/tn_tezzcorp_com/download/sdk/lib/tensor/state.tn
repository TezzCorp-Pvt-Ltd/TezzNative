  unsafe:
    ret &AUTOGRAD_OP_SIGMOID

fn _state_AUTOGRAD_OP_TANH() -> *int:
  unsafe:
    ret &AUTOGRAD_OP_TANH

fn _state_AUTOGRAD_OP_SUM_ALL() -> *int:
  unsafe:
    ret &AUTOGRAD_OP_SUM_ALL

fn _state_AUTOGRAD_OP_MEAN_ALL() -> *int:
  unsafe:
