  unsafe:
    ret &AUTOGRAD_OP_SCALE

fn _state_AUTOGRAD_OP_NEG() -> *int:
  unsafe:
    ret &AUTOGRAD_OP_NEG

fn _state_AUTOGRAD_OP_RELU() -> *int:
  unsafe:
