fn _tensor_backward_mse(node:*TapeNode, out_grad:Tensor) -> int:
  ret tensor.backward._tensor_backward_mse(node, out_grad)

fn tensor_backward(loss:Tensor) -> int:
  ret tensor.backward.tensor_backward(loss)

fn tensor_matmul(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.operators.tensor_matmul(a, b)

fn tensor_add(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.operators.tensor_add(a, b)

fn tensor_sub(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.operators.tensor_sub(a, b)

fn tensor_mul(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.operators.tensor_mul(a, b)

fn tensor_div(a:Tensor, b:Tensor) -> Tensor:
  ret tensor.operators.tensor_div(a, b)

fn tensor_scale(a:Tensor, s:float) -> Tensor:
  ret tensor.operators.tensor_scale(a, s)

fn tensor_neg(a:Tensor) -> Tensor:
  ret tensor.operators.tensor_neg(a)

fn tensor_relu(a:Tensor) -> Tensor:
  ret tensor.operators.tensor_relu(a)

fn tensor_gelu(a:Tensor) -> Tensor:
  ret tensor.operators.tensor_gelu(a)

fn tensor_silu(a:Tensor) -> Tensor:
  ret tensor.operators.tensor_silu(a)

fn tensor_sigmoid(a:Tensor) -> Tensor:
  ret tensor.operators.tensor_sigmoid(a)

fn tensor_tanh(a:Tensor) -> Tensor:
  ret tensor.operators.tensor_tanh(a)

fn lr_linear_schedule(initial_lr:float, min_lr:float, cur_step:int, total_steps:int) -> float:
  ret tensor.optimizers.lr_linear_schedule(initial_lr, min_lr, cur_step, total_steps)

fn lr_cosine_schedule(max_lr:float, min_lr:float, cur_step:int, warmup_steps:int, total_steps:int) -> float:
  ret tensor.optimizers.lr_cosine_schedule(max_lr, min_lr, cur_step, warmup_steps, total_steps)

fn adamw_create(lr:float, beta1:float, beta2:float, eps:float, weight_decay:float) -> AdamW:
  ret tensor.optimizers.adamw_create(lr, beta1, beta2, eps, weight_decay)

fn adamw_add_param(opt:*AdamW, p:*Tensor) -> int:
  ret tensor.optimizers.adamw_add_param(opt, p)

fn adamw_zero_grad(opt:*AdamW) -> int:
  ret tensor.optimizers.adamw_zero_grad(opt)

fn adamw_clip_grad_norm(opt:*AdamW, max_norm:float) -> float:
  ret tensor.optimizers.adamw_clip_grad_norm(opt, max_norm)

fn adamw_step(opt:*AdamW) -> int:
  ret tensor.optimizers.adamw_step(opt)

fn adamw_free(opt:*AdamW) -> int:
  ret tensor.optimizers.adamw_free(opt)

fn sgd_create(lr:float, momentum:float, weight_decay:float, nesterov:int) -> SGD:
  ret tensor.optimizers.sgd_create(lr, momentum, weight_decay, nesterov)

fn sgd_add_param(opt:*SGD, p:*Tensor) -> int:
  ret tensor.optimizers.sgd_add_param(opt, p)

fn sgd_zero_grad(opt:*SGD) -> int:
  ret tensor.optimizers.sgd_zero_grad(opt)

fn sgd_clip_grad_norm(opt:*SGD, max_norm:float) -> float:
  ret tensor.optimizers.sgd_clip_grad_norm(opt, max_norm)

fn sgd_step(opt:*SGD) -> int:
  ret tensor.optimizers.sgd_step(opt)

fn sgd_free(opt:*SGD) -> int:
  ret tensor.optimizers.sgd_free(opt)
