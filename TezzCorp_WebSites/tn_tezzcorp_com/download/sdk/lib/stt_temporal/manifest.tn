fn read_line(file:*u8) -> *u8:
  unsafe:
    let line:*u8 = malloc(8193)
    if line == 0:
      ret 0 as *u8
    let count = 0
    while count < 8192:
      let value:u8 = 0 as u8
      if fread(&value, 1, 1, file) != 1:
        break
      if value == 10 as u8:
        break
      line[count] = value
      count = count + 1
    line[count] = 0 as u8
    if count == 0:
      free(line)
      ret 0 as *u8
    ret line

fn encode(text:*u8, labels:*i64):
  if text == 0 || labels == 0:
    ret 0
  unsafe:
    let count = len(text)
    if count < 1 || count > 448:
      ret 0
    let i = 0
    while i < count:
      let character = text[i] as i64
      let label = 0
      if character == 32:
        label = 1
      else:
        if character == 39:
          label = 2
        else:
          if character >= 97 && character <= 122:
            label = character - 97 + 3
          else:
            ret 0
      labels[i] = label
      i = i + 1
    ret count

