// RFC 4226 HOTP and RFC 6238 TOTP using the platform cryptography provider.
// Returned strings are owned by the caller; null means invalid input/failure.
// Verification is stateless. Persist matched_step atomically per identity to
// prevent replay, and enforce enrollment, expiry, and rate limits in the app.

import "time"

extern fn tn_security_otp_secret() -> str
extern fn tn_security_otp_numeric(length:int) -> str
extern fn tn_security_otp_random_u32() -> int
extern fn tn_security_otp_hotp(secret:str, counter:int, digits:int) -> str
extern fn tn_security_otp_match(secret:str, code:str, counter:int, window:int, digits:int) -> int
extern fn tn_security_otp_uri(secret:str, account:str, issuer:str) -> str

fn get_base32_alphabet() -> str:
  ret "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

// Kept for source compatibility: the seed is ignored; randomness is from CSPRNG.
// Failure returns -1, never a predictable fallback.
fn random_u32(seed:int) -> int:
  ret tn_security_otp_random_u32()

// A 160-bit secret, encoded as 32 Base32 characters without padding.
fn generate_secret() -> str:
  ret tn_security_otp_secret()

fn generate_numeric(length:int) -> str:
  if length <= 0: length = 6
  ret tn_security_otp_numeric(length)

fn base32_char_val(ch:int) -> int:
  if ch >= 65 && ch <= 90: ret ch - 65
  if ch >= 97 && ch <= 122: ret ch - 97
  if ch >= 50 && ch <= 55: ret ch - 24
  ret -1

fn generate_hotp(secret:str, counter:int, digits:int) -> str:
  ret tn_security_otp_hotp(secret, counter, digits)

// Compatibility helper: the moving factor is the HOTP counter, not a hash seed.
fn hash_totp_step(secret:str, time_step:int) -> int:
  code:str = generate_hotp(secret, time_step, 6)
  if code == 0: ret -1
  value:int = 0
  i:int = 0
  unsafe:
    while i < 6:
      value = value * 10 + ((code as *char)[i] as int) - 48
      i = i + 1
    free(code)
  ret value

fn generate_totp_at(secret:str, unix_seconds:int, digits:int) -> str:
  if unix_seconds < 0: ret 0 as str
  ret generate_hotp(secret, unix_seconds / 30, digits)

fn generate_totp(secret:str) -> str:
  ret generate_totp_at(secret, time.now(), 6)

// Window is bounded to 0..10; invalid inputs return -1. A valid result is the
// matched 30-second step, suitable for an application-owned replay counter.
fn matched_step(secret:str, code:str, unix_seconds:int, window:int, digits:int) -> int:
  if unix_seconds < 0: ret -1
  ret tn_security_otp_match(secret, code, unix_seconds / 30, window, digits)

fn verify_totp_at(secret:str, code:str, unix_seconds:int, window:int) -> int:
  if window < 0: window = 1
  ret matched_step(secret, code, unix_seconds, window, 6) >= 0

fn verify_totp(secret:str, input_code:str, window:int) -> int:
  ret verify_totp_at(secret, input_code, time.now(), window)

fn provisioning_uri(secret:str, account:str, issuer:str) -> str:
  ret tn_security_otp_uri(secret, account, issuer)
