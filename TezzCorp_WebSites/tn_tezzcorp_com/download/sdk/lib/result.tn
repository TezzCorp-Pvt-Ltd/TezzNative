// Concrete result types; the compiler does not support Result(T) generics.
// Error strings are borrowed and must outlive the result.
import "sys"

struct ResultInt:
  ok:int
  val:int
  err:str

struct ResultF64:
  ok:int
  val:f64
  err:str

fn ok(value:int) -> ResultInt:
  ret ResultInt { ok: 1, val: value, err: "" }

fn err(message:str) -> ResultInt:
  ret ResultInt { ok: 0, val: 0, err: message }

fn ok_f64(value:f64) -> ResultF64:
  ret ResultF64 { ok: 1, val: value, err: "" }

fn err_f64(message:str) -> ResultF64:
  ret ResultF64 { ok: 0, val: 0.0, err: message }

fn result_ok(r:ResultInt) -> int:
  ret r.ok

fn result_val(r:ResultInt) -> int:
  ret r.val

fn result_err(r:ResultInt) -> str:
  if r.ok == 0:
    ret r.err
  ret ""

fn result_expect(r:ResultInt, message:str) -> int:
  if r.ok == 0:
    say message
    say r.err
    sys.sys_exit(1)
  ret r.val

fn result_ok_f64(r:ResultF64) -> int:
  ret r.ok

fn result_val_f64(r:ResultF64) -> f64:
  ret r.val

fn result_err_f64(r:ResultF64) -> str:
  if r.ok == 0:
    ret r.err
  ret ""

fn result_map(r:ResultInt, f:fn(int)->int) -> ResultInt:
  if r.ok == 0:
    ret r
  if f == 0 as fn(int)->int:
    ret err("result_map requires a function")
  ret ok(f(r.val))
