fn console_read_char() -> int:
  // Prefer keyboard to avoid serial noise blocking input.
  c:int = kbd_poll_char()
  if c > 0:
    ret c
  if (*os.state._get_g_console_serial_in()) != 0 || (*os.state._get_g_console_backend()) == os.state._get_CONSOLE_SERIAL():
    c = serial_poll_char()
    if c > 0:
      ret c
  ret 0

fn debugcon_putc(ch:int) -> int:
  // QEMU debug console (port 0xE9).
  sys.sys_outb(233, ch)
  ret 0

fn debugcon_write(s:str) -> int:
  if s == 0:
    ret 0
  i:int = 0
  while 1:
    c:int = 0
    unsafe:
      c = s[i] as int
    if c == 0:
      break
    debugcon_putc(c)
    i = i + 1
  ret 0
