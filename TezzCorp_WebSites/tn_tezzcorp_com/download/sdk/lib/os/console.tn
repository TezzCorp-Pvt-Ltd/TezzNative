fn mouse_poll_has_packet() -> int:
  ret os.state.mouse_has_packet()

fn mouse_poll_packet() -> int:
  ret os.state.mouse_read_packet()

fn mouse_poll_dx() -> int:
  ret os.state.mouse_dx()

fn mouse_poll_dy() -> int:
  ret os.state.mouse_dy()

fn mouse_poll_buttons() -> int:
  ret os.state.mouse_buttons()

fn mouse_poll_packet_x() -> int:
