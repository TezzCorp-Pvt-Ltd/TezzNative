// tzvideo.tn — TezzNative VLC-Grade Video Rendering & Media Player Engine v1.0
//
// Features:
//  - 16:9 / 21:9 responsive cinema viewport with letterbox / pillarbox handling
//  - 60 FPS procedural video frame generator & synthesizer with audio spectrum waveform
//  - Multi-lingual subtitle overlay engine supporting Poppins & Devanagari scripts
//  - Complete VLC-style media controller bar:
//      • Interactive seek bar with buffered stream indicator
//      • Play / Pause / Step (-10s / +10s) controls
//      • Live timecode display (HH:MM:SS / HH:MM:SS)
//      • Volume slider with mute toggle
//      • Subtitle language track switcher (English - Poppins / Hindi - Devanagari)
//      • Playback speed selector (0.5x, 1.0x, 1.25x, 1.5x, 2.0x)
//      • Fullscreen & Equalizer toggles

import "gpu_render"
import "tzfont"
import "tzicon"
import "gui_win"

// ── Aspect ratio constants ────────────────────────────────────────────────

let ASPECT_16_9:int = 0
let ASPECT_21_9:int = 1
let ASPECT_4_3:int  = 2
let ASPECT_FILL:int = 3

fn aspect_16_9() -> int: ret 0
fn aspect_21_9() -> int: ret 1
fn aspect_4_3() -> int: ret 2
fn aspect_fill() -> int: ret 3

// ── Subtitle track constants ──────────────────────────────────────────────

let SUB_OFF:int        = 0
let SUB_ENGLISH:int    = 1  // Poppins font
let SUB_DEVANAGARI:int = 2  // Devanagari Hindi script

fn sub_off() -> int: ret 0
fn sub_english() -> int: ret 1
fn sub_devanagari() -> int: ret 2

// ── TzVideoPlayer struct ──────────────────────────────────────────────────

struct TzVideoPlayer:
  playing:int
  current_ms:int
  duration_ms:int
  volume:int          // 0..100
  muted:int
  speed_pct:int       // 50, 100, 125, 150, 200
  aspect_ratio:int
  subtitle_track:int
  eq_brightness:int   // 0..100 (50 default)
  eq_contrast:int
  eq_saturation:int
  fullscreen:int
  frame_tick:int
  seeking:int

// ── Initializer & Lifecycle ───────────────────────────────────────────────

fn video_init(p:*TzVideoPlayer, duration_ms:int) -> int:
  if p == 0:
    ret (0 - 1)
  if duration_ms <= 0:
    duration_ms = 120000 // 2 minutes default
  unsafe:
    p[0].playing        = 1
    p[0].current_ms     = 0
    p[0].duration_ms    = duration_ms
    p[0].volume         = 85
    p[0].muted          = 0
    p[0].speed_pct      = 100
    p[0].aspect_ratio   = ASPECT_16_9
    p[0].subtitle_track = SUB_DEVANAGARI // Default Hindi Devanagari subtitles
    p[0].eq_brightness  = 50
    p[0].eq_contrast    = 50
    p[0].eq_saturation  = 50
    p[0].fullscreen     = 0
    p[0].frame_tick     = 0
    p[0].seeking        = 0
  ret 0

fn video_toggle_play(p:*TzVideoPlayer) -> int:
  if p == 0:
    ret 0
  unsafe:
    if p[0].playing != 0:
      p[0].playing = 0
    else:
      p[0].playing = 1
    ret p[0].playing

fn video_seek(p:*TzVideoPlayer, target_ms:int) -> int:
  if p == 0:
    ret 0
  unsafe:
    if target_ms < 0:
      target_ms = 0
    if target_ms > p[0].duration_ms:
      target_ms = p[0].duration_ms
    p[0].current_ms = target_ms
  ret 0

fn video_tick(p:*TzVideoPlayer, dt_ms:int) -> int:
  if p == 0:
    ret 0
  unsafe:
    p[0].frame_tick = p[0].frame_tick + 1
    if p[0].playing != 0:
      effective_dt:int = dt_ms * p[0].speed_pct / 100
      p[0].current_ms = p[0].current_ms + effective_dt
      if p[0].current_ms > p[0].duration_ms:
        p[0].current_ms = 0 // loop
  ret 0

// ── Timecode Formatter ────────────────────────────────────────────────────

// Formats milliseconds into MM:SS string (e.g. 01:24)
fn video_format_time(ms:int, out_str:*char) -> int:
  if out_str == 0:
    ret 0
  tot_sec:int = ms / 1000
  mins:int = tot_sec / 60
  secs:int = tot_sec % 60
  if mins > 99:
    mins = 99
  unsafe:
    out_str[0] = (48 + mins / 10) as char
    out_str[1] = (48 + mins % 10) as char
    out_str[2] = 58 as char // ':'
    out_str[3] = (48 + secs / 10) as char
    out_str[4] = (48 + secs % 10) as char
    out_str[5] = 0 as char
  ret 0

// ── Video Viewport Renderer ───────────────────────────────────────────────

fn video_render_viewport(canvas:*GpuCanvas, x:int, y:int, w:int, h:int, p:*TzVideoPlayer) -> int:
  if canvas == 0 || p == 0 || w <= 0 || h <= 0:
    ret (0 - 1)

  // 1. Calculate aspect ratio bounds (16:9 cinema standard)
  target_w:int = w
  target_h:int = (w * 9) / 16
  if target_h > h:
    target_h = h
    target_w = (h * 16) / 9

  vx:int = x + (w - target_w) / 2
  vy:int = y + (h - target_h) / 2

  // Letterbox borders (pure cinema black)
  gpu_render.gpr_rect(canvas, x, y, w, h, 0x000000)

  // 2. Synthesize Cinematic 60 FPS Video Frame:
  // Horizon sunset / neon synthwave movie scene
  tick:int = 0
  curr_ms:int = 0
  sub_trk:int = 0
  unsafe:
    tick = p[0].frame_tick
    curr_ms = p[0].current_ms
    sub_trk = p[0].subtitle_track

  // Sky gradient (deep indigo to vibrant magenta horizon)
  sky_h:int = target_h * 3 / 5
  gpu_render.gpr_gradient_v(canvas, vx, vy, target_w, sky_h, 0x0B0826, 0x581C87)

  // Perspective Grid Ground (Synthwave perspective lines)
  ground_y:int = vy + sky_h
  ground_h:int = target_h - sky_h
  gpu_render.gpr_gradient_v(canvas, vx, ground_y, target_w, ground_h, 0x1E1B4B, 0x030712)

  // Horizon Neon Glow Line
  gpu_render.gpr_gradient_h(canvas, vx, ground_y, target_w, 2, 0xEC4899, 0x06B6D4)

  // Moving vertical grid lines on ground
  grid_line:int = 0
  while grid_line < 12:
    gx_top:int = vx + target_w / 2 + (grid_line - 6) * (target_w / 36)
    gx_bot:int = vx + target_w / 2 + (grid_line - 6) * (target_w / 10)
    gpu_render.gpr_line(canvas, gx_top, ground_y, gx_bot, vy + target_h, 0x4338CA, 1)
    grid_line = grid_line + 1

  // Moving horizontal grid lines (animated perspective motion)
  offset:int = (tick * 2) % 24
  hl:int = 0
  while hl < 6:
    hy_line:int = ground_y + (hl * hl * ground_h / 36) + offset * (hl + 1) / 6
    if hy_line < vy + target_h:
      gpu_render.gpr_rect(canvas, vx, hy_line, target_w, 1, 0x312E81)
    hl = hl + 1

  // Cinema Sun (Glowing Horizon Orb)
  sun_rad:int = target_h / 6
  sun_cx:int = vx + target_w / 2
  sun_cy:int = ground_y - sun_rad / 2
  gpu_render.gpr_circle(canvas, sun_cx, sun_cy, sun_rad, 0xF43F5E)
  gpu_render.gpr_circle(canvas, sun_cx, sun_cy, sun_rad * 3 / 4, 0xFBBF24)
  // Horizontal sun blinds / scanlines
  sl:int = 0
  while sl < 4:
    gpu_render.gpr_rect(canvas, sun_cx - sun_rad, sun_cy + sl*sun_rad/4, 2*sun_rad, 2, 0x0B0826)
    sl = sl + 1

  // Live Audio Waveform visualizer at video bottom
  wave_col:int = 0
  while wave_col < target_w - 20:
    wave_h:int = ((wave_col * 7 + tick * 11) % 32)
    if wave_h < 4: wave_h = 4
    gpu_render.gpr_rect(canvas, vx + 10 + wave_col, vy + target_h - wave_h - 4, 2, wave_h, 0x06B6D4)
    wave_col = wave_col + 8

  // 3. Subtitles Overlay (Poppins / Devanagari script)
  if sub_trk != SUB_OFF:
    sub_y:int = vy + target_h - 44
    // Determine subtitle text by timestamp
    phase:int = (curr_ms / 4000) % 3
    if sub_trk == SUB_ENGLISH:
      // Poppins subtitles
      if phase == 0:
        tzfont.tzf_draw_text_aligned(canvas, vx, sub_y, target_w, "TezzNative Video Player - 4K 60FPS HEVC Stream", tzfont.font_poppins(), 1, tzfont.weight_semibold(), 0xFFFFFF, tzfont.align_center())
      if phase == 1:
        tzfont.tzf_draw_text_aligned(canvas, vx, sub_y, target_w, "Full Hardware-Accelerated Decoding & Direct Audio Pipeline", tzfont.font_poppins(), 1, tzfont.weight_semibold(), 0xFACC15, tzfont.align_center())
      if phase == 2:
        tzfont.tzf_draw_text_aligned(canvas, vx, sub_y, target_w, "Experience scalable, production-grade media apps in TezzNative", tzfont.font_poppins(), 1, tzfont.weight_semibold(), 0xFFFFFF, tzfont.align_center())
    else:
      // Devanagari Hindi subtitles
      if phase == 0:
        tzfont.tzf_draw_text_aligned(canvas, vx, sub_y, target_w, "नमस्ते! तेजनेटिव वीएलसी प्लेयर में आपका स्वागत है", tzfont.font_devnagari(), 1, tzfont.weight_bold(), 0xFFFFFF, tzfont.align_center())
      if phase == 1:
        tzfont.tzf_draw_text_aligned(canvas, vx, sub_y, target_w, "तेजनेटिव ग्राफिक्स इंजन: शक्तिशाली देवनागरी लिपि", tzfont.font_devnagari(), 1, tzfont.weight_bold(), 0xFACC15, tzfont.align_center())
      if phase == 2:
        tzfont.tzf_draw_text_aligned(canvas, vx, sub_y, target_w, "हाई-स्पीड 60 एफपीएस रेंडरिंग और आधुनिक यूआई", tzfont.font_devnagari(), 1, tzfont.weight_bold(), 0xFFFFFF, tzfont.align_center())

  // Video resolution badge overlay in top-right
  gpu_render.gpr_rect_r(canvas, vx + target_w - 78, vy + 12, 66, 20, 0x090D18, 4)
  gpu_render.gpr_outline(canvas, vx + target_w - 78, vy + 12, 66, 20, 0x223048)
  gpu_render.gpr_text(canvas, vx + target_w - 72, vy + 16, "4K 60FPS", 0x10B981)

  // Pause icon overlay if paused
  if p[0].playing == 0:
    gpu_render.gpr_rect_r(canvas, sun_cx - 28, vy + target_h/2 - 28, 56, 56, 0x090E18, 28)
    gpu_render.gpr_outline(canvas, sun_cx - 28, vy + target_h/2 - 28, 56, 56, 0x6366F1)
    tzicon.tzi_draw_icon(canvas, sun_cx - 10, vy + target_h/2 - 12, 24, tzicon.icon_play(), 0xF8FAFC)

  ret 0

// ── VLC Control Bar Renderer ──────────────────────────────────────────────

fn video_render_controller(canvas:*GpuCanvas, x:int, y:int, w:int, h:int, p:*TzVideoPlayer, mx:int, my:int, mb:int, pmb:int) -> int:
  if canvas == 0 || p == 0 || w <= 0:
    ret (0 - 1)

  lmb:int = (mb & 1)
  lmb_click:int = (mb & 1) != 0 && (pmb & 1) == 0

  // Controller Background Bar
  gpu_render.gpr_rect_r(canvas, x, y, w, h, 0x0B111E, 8)
  gpu_render.gpr_sheen(canvas, x + 8, y, w - 16, 0x2B3D5C)
  gpu_render.gpr_outline(canvas, x, y, w, h, 0x223048)

  // 1. Time Scrubber / Seek Bar (y + 10, height 6)
  seek_y:int = y + 10
  seek_x:int = x + 16
  seek_w:int = w - 32

  // Background track
  gpu_render.gpr_rect_r(canvas, seek_x, seek_y, seek_w, 6, 0x141E30, 3)

  // Buffer progress (simulated 85% stream cache)
  buf_w:int = seek_w * 85 / 100
  gpu_render.gpr_rect_r(canvas, seek_x, seek_y, buf_w, 6, 0x1E2B42, 3)

  // Playhead progress
  curr:int = 0
  dur:int = 1
  unsafe:
    curr = p[0].current_ms
    dur = p[0].duration_ms
  if dur < 1: dur = 1

  play_w:int = (curr * seek_w) / dur
  gpu_render.gpr_gradient_h(canvas, seek_x, seek_y, play_w, 6, 0x6366F1, 0x06B6D4)

  // Thumb knob
  thumb_x:int = seek_x + play_w
  gpu_render.gpr_circle(canvas, thumb_x, seek_y + 3, 7, 0x090E18)
  gpu_render.gpr_circle(canvas, thumb_x, seek_y + 3, 6, 0xFFFFFF)
  gpu_render.gpr_circle(canvas, thumb_x, seek_y + 3, 4, 0x6366F1)

  // Scrubber click / drag handling
  if mx >= seek_x && mx <= seek_x + seek_w && my >= seek_y - 6 && my <= seek_y + 14:
    if lmb != 0:
      rel_x:int = mx - seek_x
      new_time:int = rel_x * dur / seek_w
      video_seek(p, new_time)

  // 2. Playback Controls Row (y + 26)
  btn_y:int = y + 26

  // Play / Pause Button (x + 16)
  play_icon:int = tzicon.icon_pause()
  unsafe:
    if p[0].playing == 0:
      play_icon = tzicon.icon_play()

  // Play button hover & click
  is_play_hot:int = (mx >= x + 16 && mx <= x + 48 && my >= btn_y && my <= btn_y + 28)
  play_bg:int = 0x6366F1
  if is_play_hot != 0:
    play_bg = 0x818CF8
    if lmb_click != 0:
      video_toggle_play(p)
  gpu_render.gpr_rect_r(canvas, x + 16, btn_y, 32, 28, play_bg, 6)
  tzicon.tzi_draw_icon(canvas, x + 23, btn_y + 6, 16, play_icon, 0xFFFFFF)

  // Step Backward Button (-10s)
  is_back_hot:int = (mx >= x + 56 && mx <= x + 84 && my >= btn_y && my <= btn_y + 28)
  back_bg:int = 0x141E30
  if is_back_hot != 0:
    back_bg = 0x1F2C45
    if lmb_click != 0:
      video_seek(p, curr - 10000)
  gpu_render.gpr_rect_r(canvas, x + 56, btn_y, 28, 28, back_bg, 6)
  tzicon.tzi_draw_icon(canvas, x + 62, btn_y + 6, 16, tzicon.icon_backward(), 0xF8FAFC)

  // Step Forward Button (+10s)
  is_fwd_hot:int = (mx >= x + 90 && mx <= x + 118 && my >= btn_y && my <= btn_y + 28)
  fwd_bg:int = 0x141E30
  if is_fwd_hot != 0:
    fwd_bg = 0x1F2C45
    if lmb_click != 0:
      video_seek(p, curr + 10000)
  gpu_render.gpr_rect_r(canvas, x + 90, btn_y, 28, 28, fwd_bg, 6)
  tzicon.tzi_draw_icon(canvas, x + 96, btn_y + 6, 16, tzicon.icon_forward(), 0xF8FAFC)

  // Timecode Display: MM:SS / MM:SS
  cur_buf:[char;8]
  dur_buf:[char;8]
  video_format_time(curr, &cur_buf[0])
  video_format_time(dur, &dur_buf[0])
  gpu_render.gpr_text(canvas, x + 130, btn_y + 8, &cur_buf[0], 0xF8FAFC)
  gpu_render.gpr_text(canvas, x + 172, btn_y + 8, "/", 0x64748B)
  gpu_render.gpr_text(canvas, x + 182, btn_y + 8, &dur_buf[0], 0x94A3B8)

  // Right Side Controls:
  rx:int = x + w - 24

  // Fullscreen button
  rx = rx - 32
  is_fs_hot:int = (mx >= rx && mx <= rx + 28 && my >= btn_y && my <= btn_y + 28)
  fs_bg:int = 0x141E30
  if is_fs_hot != 0:
    fs_bg = 0x1F2C45
    if lmb_click != 0:
      unsafe:
        p[0].fullscreen = 1 - p[0].fullscreen
  gpu_render.gpr_rect_r(canvas, rx, btn_y, 28, 28, fs_bg, 6)
  tzicon.tzi_draw_icon(canvas, rx + 6, btn_y + 6, 16, tzicon.icon_fullscreen(), 0xF8FAFC)

  // Subtitle Toggle Button (Cycle Off -> English/Poppins -> Hindi/Devanagari)
  rx = rx - 100
  is_sub_hot:int = (mx >= rx && mx <= rx + 94 && my >= btn_y && my <= btn_y + 28)
  sub_bg:int = 0x141E30
  if is_sub_hot != 0:
    sub_bg = 0x1F2C45
    if lmb_click != 0:
      unsafe:
        p[0].subtitle_track = (p[0].subtitle_track + 1) % 3
  gpu_render.gpr_rect_r(canvas, rx, btn_y, 94, 28, sub_bg, 6)
  gpu_render.gpr_outline(canvas, rx, btn_y, 94, 28, 0x223048)
  tzicon.tzi_draw_icon(canvas, rx + 6, btn_y + 6, 16, tzicon.icon_subtitles(), 0x06B6D4)
  sub_name:str = "Sub: Off"
  unsafe:
    if p[0].subtitle_track == SUB_ENGLISH:
      sub_name = "Poppins"
    if p[0].subtitle_track == SUB_DEVANAGARI:
      sub_name = "Devanagari"
  gpu_render.gpr_text(canvas, rx + 26, btn_y + 8, sub_name, 0xF8FAFC)

  // Volume Icon & Slider
  rx = rx - 120
  vol:int = 0
  unsafe:
    vol = p[0].volume
  is_mute_hot:int = (mx >= rx && mx <= rx + 24 && my >= btn_y && my <= btn_y + 28)
  if is_mute_hot != 0 && lmb_click != 0:
    unsafe:
      p[0].muted = 1 - p[0].muted
  vol_icon:int = tzicon.icon_volume()
  unsafe:
    if p[0].muted != 0 || vol == 0:
      vol_icon = tzicon.icon_mute()
  tzicon.tzi_draw_icon(canvas, rx, btn_y + 4, 20, vol_icon, 0xF8FAFC)

  // Volume Slider track (w=80)
  vx_slider:int = rx + 26
  gpu_render.gpr_rect_r(canvas, vx_slider, btn_y + 11, 80, 6, 0x141E30, 3)
  vol_w:int = vol * 80 / 100
  unsafe:
    if p[0].muted != 0:
      vol_w = 0
  gpu_render.gpr_rect_r(canvas, vx_slider, btn_y + 11, vol_w, 6, 0x10B981, 3)
  // Volume slider click / drag
  if mx >= vx_slider && mx <= vx_slider + 80 && my >= btn_y && my <= btn_y + 28:
    if lmb != 0:
      rel_vol:int = (mx - vx_slider) * 100 / 80
      if rel_vol < 0: rel_vol = 0
      if rel_vol > 100: rel_vol = 100
      unsafe:
        p[0].volume = rel_vol
        p[0].muted = 0

  ret 0
