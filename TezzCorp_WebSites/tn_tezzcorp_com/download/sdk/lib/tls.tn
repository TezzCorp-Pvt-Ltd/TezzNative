// tls module: verified OS-backed TLS/HTTPS helpers
import "net"

struct Tls:
  h:int

let TLS_MIN_DEFAULT:int = 0
let TLS_MIN_12:int = 12
let TLS_MIN_13:int = 13

// connect uses the current runtime policy and verifies the peer identity.
fn connect(host:str, port:int) -> *Tls:
  h:int = tls_connect(host, port)
  if h < 0:
    ret 0 as *Tls
  t:*Tls = (*Tls)malloc(sizeof(Tls))
  if t == 0:
    tls_close(h)
    ret 0 as *Tls
  (*t).h = h
  ret t

// A per-request policy leaves the runtime's global policy unchanged.
fn connect_with_policy(host:str, port:int, min_version:int, handshake_timeout_ms:int, pin_hex:str) -> *Tls:
  h:int = tls_connect_ex(host, port, min_version, handshake_timeout_ms, pin_hex)
  if h < 0:
    ret 0 as *Tls
  t:*Tls = (*Tls)malloc(sizeof(Tls))
  if t == 0:
    tls_close(h)
    ret 0 as *Tls
  (*t).h = h
  ret t

fn send(t:*Tls, buf:*char, n:int) -> int:
  if t == 0:
    ret 0 - 1
  ret tls_send((*t).h, buf, n)

fn recv(t:*Tls, buf:*char, n:int) -> int:
  if t == 0:
    ret 0 - 1
  ret tls_recv((*t).h, buf, n)

fn close(t:*Tls) -> int:
  if t == 0:
    ret 0 - 1
  r:int = tls_close((*t).h)
  free(t)
  ret r

fn last_error() -> int:
  ret tls_last_error()

// min_version: 0 (secure default), 12 (TLS1.2+), or 13 (TLS1.3+).
fn policy_reset() -> int:
  ret tls_policy_reset()

fn policy_set_min(min_version:int) -> int:
  ret tls_policy_set_min(min_version)

fn policy_set_pin_sha256(pin_hex:str) -> int:
  ret tls_policy_set_pin_sha256(pin_hex)

fn policy_set_handshake_timeout(timeout_ms:int) -> int:
  ret tls_policy_set_handshake_timeout(timeout_ms)

fn policy_get_min() -> int:
  ret tls_policy_get_min()

fn policy_get_handshake_timeout() -> int:
  ret tls_policy_get_handshake_timeout()

fn policy_pin_enabled() -> int:
  ret tls_policy_pin_enabled()

fn download(url:str, out_path:str) -> int:
  ret net.download(url, out_path)
