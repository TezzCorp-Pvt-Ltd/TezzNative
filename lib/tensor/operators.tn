fn tensor_sigmoid(a:Tensor) -> Tensor:
  c:Tensor = _tensor_sigmoid_raw(a)
  if (*tensor.state._state__tape_enabled()) != 0 && a.requires_grad != 0:
    c = tensor.tape.tensor_require_grad(c)
