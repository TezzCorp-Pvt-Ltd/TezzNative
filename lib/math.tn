// math module — complete mathematical functions for TezzNative
// Maps to native runtime implementations for maximum performance.

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
fn PI() -> float:
  ret 3.14159265358979323846
fn TAU() -> float:
  ret 6.28318530717958647692
fn E() -> float:
  ret 2.71828182845904523536
fn SQRT2() -> float:
  ret 1.41421356237309504880
fn LN2() -> float:
  ret 0.69314718055994530942
fn LN10() -> float:
  ret 2.30258509299404568402
fn PHI() -> float:
  ret 1.61803398874989484820
fn INF() -> float:
  ret 1.0 / 0.0

// ---------------------------------------------------------------------------
// Integer math
// ---------------------------------------------------------------------------

fn abs(x:int) -> int:
  if x < 0:
    ret 0 - x
  ret x

fn min(a:int, b:int) -> int:
  if a < b:
    ret a
  ret b

fn max(a:int, b:int) -> int:
  if a > b:
    ret a
  ret b

fn clamp(x:int, lo:int, hi:int) -> int:
  if x < lo:
    ret lo
  if x > hi:
    ret hi
  ret x

fn sign(x:int) -> int:
  if x > 0:
    ret 1
  if x < 0:
    ret 0 - 1
  ret 0

fn gcd(a:int, b:int) -> int:
  a2:int = abs(a)
  b2:int = abs(b)
  while b2 != 0:
    t:int = b2
    b2 = a2 % b2
    a2 = t
  ret a2

fn lcm(a:int, b:int) -> int:
  if a == 0 || b == 0:
    ret 0
  ret abs(a / gcd(a, b) * b)

fn pow_int(base:int, exp:int) -> int:
  if exp < 0:
    ret 0
  result:int = 1
  b:int = base
  e:int = exp
  while e > 0:
    if (e & 1) != 0:
      result = result * b
    b = b * b
    e = e >> 1
  ret result

fn divmod(a:int, b:int, out_q:*int, out_r:*int) -> int:
  if b == 0 || out_q == 0 || out_r == 0:
    ret 0 - 1
  unsafe:
    *out_q = a / b
    *out_r = a % b
  ret 0

// ---------------------------------------------------------------------------
// Float math (wraps runtime builtins)
// ---------------------------------------------------------------------------

fn absf(x:float) -> float:
  if x < 0.0:
    ret 0.0 - x
  ret x

fn minf(a:float, b:float) -> float:
  if a < b:
    ret a
  ret b

fn maxf(a:float, b:float) -> float:
  if a > b:
    ret a
  ret b

fn clampf(x:float, lo:float, hi:float) -> float:
  if x < lo:
    ret lo
  if x > hi:
    ret hi
  ret x

fn signf(x:float) -> float:
  if x > 0.0:
    ret 1.0
  if x < 0.0:
    ret 0.0 - 1.0
  ret 0.0

// Square root (Newton-Raphson fallback — runtime provides fast path)
fn sqrt(x:float) -> float:
  if x != x:
    ret x
  if x < 0.0:
    ret 0.0
  if x == 0.0:
    ret x
  if x > 1.7976931348623157e308:
    ret x
  m:float = x
  scale:float = 1.0
  i:int = 0
  while m >= 4.0 && i < 512:
    m = m * 0.25
    scale = scale * 2.0
    i = i + 1
  i = 0
  while m < 1.0 && i < 538:
    m = m * 4.0
    scale = scale * 0.5
    i = i + 1
  guess:float = (m + 1.0) * 0.5
  i = 0
  while i < 10:
    next:float = (guess + m / guess) * 0.5
    if next == guess:
      break
    guess = next
    i = i + 1
  ret guess * scale

// Fast inverse sqrt (Quake trick for normalized vectors)
fn rsqrt(x:float) -> float:
  if x <= 0.0:
    ret 0.0
  ret 1.0 / sqrt(x)

// Floor (round toward -infinity)
fn floor(x:float) -> float:
  if x != x || x == 0.0:
    ret x
  if x >= 4503599627370496.0 || x <= -4503599627370496.0:
    ret x
  n:int = x as int
  fn2:float = n as float
  if fn2 > x:
    ret fn2 - 1.0
  ret fn2

// Ceiling (round toward +infinity)
fn ceil(x:float) -> float:
  if x != x || x == 0.0:
    ret x
  if x >= 4503599627370496.0 || x <= -4503599627370496.0:
    ret x
  n:int = x as int
  fn2:float = n as float
  if fn2 < x:
    ret fn2 + 1.0
  ret fn2

// Round to nearest integer
fn round(x:float) -> float:
  if x >= 0.0:
    ret floor(x + 0.5)
  ret ceil(x - 0.5)

// Truncate toward zero
fn trunc(x:float) -> float:
  if x != x || x == 0.0:
    ret x
  if x >= 4503599627370496.0 || x <= -4503599627370496.0:
    ret x
  ret (x as int) as float

// Fractional part (always non-negative)
fn frac(x:float) -> float:
  t:float = trunc(x)
  f:float = x - t
  if f < 0.0:
    ret f + 1.0
  ret f

// Modulo that always returns positive result
fn fmod(a:float, b:float) -> float:
  if b == 0.0:
    ret 0.0
  q:float = trunc(a / b)
  ret a - q * b

// Linear interpolation: lerp(a, b, t) = a + t*(b-a)
fn lerp(a:float, b:float, t:float) -> float:
  ret a + t * (b - a)

// Smooth step (3t^2 - 2t^3)
fn smoothstep(edge0:float, edge1:float, x:float) -> float:
  if edge0 == edge1:
    if x < edge0:
      ret 0.0
    ret 1.0
  t:float = clampf((x - edge0) / (edge1 - edge0), 0.0, 1.0)
  ret t * t * (3.0 - 2.0 * t)

// ---------------------------------------------------------------------------
// Trigonometry (minimax polynomial approximations)
// ---------------------------------------------------------------------------

// Reduce angle to [-PI, PI]
fn _angle_reduce(x:float) -> float:
  tau:float = TAU()
  x2:float = x
  if x2 > tau || x2 < 0.0 - tau:
    k:float = trunc(x2 / tau)
    x2 = x2 - k * tau
  while x2 > PI():
    x2 = x2 - tau
  while x2 < 0.0 - PI():
    x2 = x2 + tau
  ret x2

// Sine via Taylor series (accurate for reduced angles in [-PI/2, PI/2])
fn _sin_reduced(x:float) -> float:
  x2:float = x * x
  // 6-term Taylor: x * (1 - x^2/6 + x^4/120 - x^6/5040 + x^8/362880 - x^10/39916800)
  ret x * (1.0 - x2 * (0.16666666666666666 - x2 * (0.00833333333333333 - x2 * (0.0001984126984127 - x2 * (0.0000027557319224 - x2 * 0.0000000250521084)))))

fn sin(x:float) -> float:
  r:float = _angle_reduce(x)
  half_pi:float = PI() * 0.5
  if r > half_pi:
    ret _sin_reduced(PI() - r)
  if r < 0.0 - half_pi:
    ret _sin_reduced((0.0 - PI()) - r)
  ret _sin_reduced(r)

fn cos(x:float) -> float:
  ret sin(x + PI() * 0.5)

fn tan(x:float) -> float:
  c:float = cos(x)
  if absf(c) < 1.0e-15:
    ret 1.0e15
  ret sin(x) / c

fn _atan_poly_unit(r:float) -> float:
  r2:float = r * r
  term:float = r
  result:float = r
  n:int = 3
  while n <= 41:
    term = 0.0 - term * r2
    add:float = term / (n as float)
    result = result + add
    if absf(add) < 1.0e-18:
      break
    n = n + 2
  ret result

fn _atan_ratio(r:float) -> float:
  if r != r:
    ret r
  a:float = absf(r)
  inverted:int = 0
  if a > 1.0:
    a = 1.0 / a
    inverted = 1
  result:float = 0.0
  if a > 0.41421356237309504880:
    result = PI() * 0.25 + _atan_poly_unit((a - 1.0) / (a + 1.0))
  else:
    result = _atan_poly_unit(a)
  if inverted != 0:
    result = PI() * 0.5 - result
  if r < 0.0:
    ret 0.0 - result
  ret result

// Atan2 via polynomial approximation with quadrant-correct output.
fn atan2(y:float, x:float) -> float:
  if y != y:
    ret y
  if x != x:
    ret x
  if absf(y) > 1.7976931348623157e308:
    result:float = PI() * 0.5
    if absf(x) > 1.7976931348623157e308:
      result = PI() * 0.25
      if x < 0.0:
        result = PI() * 0.75
    if y < 0.0:
      ret 0.0 - result
    ret result
  if x > 0.0:
    ret _atan_ratio(y / x)
  if x < 0.0:
    result:float = _atan_ratio(y / x)
    if y >= 0.0:
      ret result + PI()
    ret result - PI()
  if y > 0.0:
    ret PI() * 0.5
  if y < 0.0:
    ret 0.0 - PI() * 0.5
  ret 0.0

fn atan(x:float) -> float:
  ret atan2(x, 1.0)

fn asin(x:float) -> float:
  if x < 0.0 - 1.0 || x > 1.0:
    ret 0.0
  ret atan2(x, sqrt(1.0 - x * x))

fn acos(x:float) -> float:
  if x < 0.0 - 1.0 || x > 1.0:
    ret 0.0
  ret PI() * 0.5 - asin(x)

// ---------------------------------------------------------------------------
// Exponential / Logarithm
// ---------------------------------------------------------------------------

// exp(x) via Maclaurin series — accurate for small x
fn _exp_core(x:float) -> float:
  result:float = 1.0
  term:float = 1.0
  i:int = 1
  while i <= 30:
    term = term * x / (i as float)
    result = result + term
    if absf(term) < 1.0e-15:
      break
    i = i + 1
  ret result

// exp(x) with range reduction: exp(x) = 2^k * exp(r) where r in [-0.5*ln2, 0.5*ln2]
fn exp(x:float) -> float:
  if x != x:
    ret x
  if x > 709.782712893384:
    ret INF()
  if x < -745.1332191019411:
    ret 0.0
  q:float = x / LN2()
  k:int = 0
  if q >= 0.0:
    k = (q + 0.5) as int
  else:
    k = (q - 0.5) as int
  // Split ln(2) avoids cancellation for inputs near the range limits.
  r:float = (x - (k as float) * 0.6931471803691238) - (k as float) * 1.9082149292705877e-10
  base:float = _exp_core(r)
  i:int = 0
  while k > 0 && i < 1024:
    base = base * 2.0
    k = k - 1
    i = i + 1
  i = 0
  while k < 0 && i < 1075:
    base = base * 0.5
    k = k + 1
    i = i + 1
  ret base

// Natural logarithm via Newton's method: ln(x) = 2*atanh((x-1)/(x+1))
fn log(x:float) -> float:
  if x != x:
    ret x
  if x <= 0.0:
    ret 0.0 - 1.0e15
  if x > 1.7976931348623157e308:
    ret x
  if x == 1.0:
    ret 0.0
  // Reduce to [sqrt(2)/2, sqrt(2)]
  m:float = x
  k:int = 0
  while m > SQRT2() && k < 1024:
    m = m * 0.5
    k = k + 1
  while m < 0.70710678118654752440 && k > -1074:
    m = m * 2.0
    k = k - 1
  // ln(m) via series: 2*atanh((m-1)/(m+1))
  y:float = (m - 1.0) / (m + 1.0)
  y2:float = y * y
  term:float = y
  series:float = y
  n:int = 3
  while n <= 39:
    term = term * y2
    add:float = term / (n as float)
    series = series + add
    if absf(add) < 1.0e-18:
      break
    n = n + 2
  ret 2.0 * series + (k as float) * LN2()

fn log2(x:float) -> float:
  ret log(x) / LN2()

fn log10(x:float) -> float:
  ret log(x) / LN10()

// General power: a^b = exp(b * ln(a))
fn pow(base:float, exp2:float) -> float:
  if exp2 == 0.0 || base == 1.0:
    ret 1.0
  if base != base:
    ret base
  if exp2 != exp2:
    ret exp2
  if base == 0.0:
    if exp2 <= 0.0:
      ret 1.0
    ret 0.0
  magnitude:float = base
  negative:int = 0
  if magnitude < 0.0:
    // Only valid for integer exponents
    if trunc(exp2) != exp2:
      ret 0.0
    magnitude = 0.0 - magnitude
    // Above 2^53 every representable finite exponent is an even integer.
    if absf(exp2) < 9007199254740992.0:
      n:int = exp2 as int
      negative = n & 1
  result:float = exp(exp2 * log(magnitude))
  if negative != 0:
    ret 0.0 - result
  ret result

// Hyperbolic functions
fn sinh(x:float) -> float:
  ex:float = exp(x)
  ret (ex - 1.0 / ex) * 0.5

fn cosh(x:float) -> float:
  ex:float = exp(x)
  ret (ex + 1.0 / ex) * 0.5

fn tanh(x:float) -> float:
  if x > 20.0:
    ret 1.0
  if x < 0.0 - 20.0:
    ret 0.0 - 1.0
  ex2:float = exp(2.0 * x)
  ret (ex2 - 1.0) / (ex2 + 1.0)

// ---------------------------------------------------------------------------
// Statistical helpers
// ---------------------------------------------------------------------------

fn sum_f64(arr:*float, n:int) -> float:
  if arr == 0 || n <= 0:
    ret 0.0
  acc:float = 0.0
  i:int = 0
  while i < n:
    unsafe:
      acc = acc + arr[i]
    i = i + 1
  ret acc

fn mean_f64(arr:*float, n:int) -> float:
  if n <= 0:
    ret 0.0
  ret sum_f64(arr, n) / (n as float)

fn variance_f64(arr:*float, n:int) -> float:
  if n <= 1:
    ret 0.0
  m:float = mean_f64(arr, n)
  acc:float = 0.0
  i:int = 0
  while i < n:
    d:float = 0.0
    unsafe:
      d = arr[i] - m
    acc = acc + d * d
    i = i + 1
  ret acc / (n as float)

fn stddev_f64(arr:*float, n:int) -> float:
  ret sqrt(variance_f64(arr, n))

// Dot product
fn dot_f64(a:*float, b:*float, n:int) -> float:
  if a == 0 || b == 0 || n <= 0:
    ret 0.0
  acc:float = 0.0
  i:int = 0
  while i < n:
    unsafe:
      acc = acc + a[i] * b[i]
    i = i + 1
  ret acc

