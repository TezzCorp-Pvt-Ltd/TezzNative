// tzwindow.tn — TezzNative Advanced Window & Modal Dialog Subsystem v1.0
//
// Features:
//  - System Modal Dialogs (Alert, Confirm, Input Prompt) with backdrop blur & dimming
//  - Window docking, minimizing, and desktop taskbar integration
//  - Full interaction handling with focus capture

import "gpu_render"
import "tzicon"
import "tzfont"

// ── Modal types ───────────────────────────────────────────────────────────

let MODAL_NONE:int    = 0
let MODAL_ALERT:int   = 1
let MODAL_CONFIRM:int = 2
let MODAL_INPUT:int   = 3

fn modal_none() -> int: ret 0
fn modal_alert() -> int: ret 1
fn modal_confirm() -> int: ret 2
fn modal_input() -> int: ret 3

// ── TzModalDialog struct ──────────────────────────────────────────────────

struct TzModalDialog:
  active:int
  kind:int
  title:str
  message:str
  confirmed:int
  cancelled:int

// ── Initializer ───────────────────────────────────────────────────────────

fn modal_init(m:*TzModalDialog) -> int:
  if m == 0:
    ret (0 - 1)
  unsafe:
    m[0].active    = 0
    m[0].kind      = MODAL_NONE
    m[0].title     = 0 as str
    m[0].message   = 0 as str
    m[0].confirmed = 0
    m[0].cancelled = 0
  ret 0

fn modal_show_alert(m:*TzModalDialog, title:str, message:str) -> int:
  if m == 0:
    ret (0 - 1)
  unsafe:
    m[0].active    = 1
    m[0].kind      = MODAL_ALERT
    m[0].title     = title
    m[0].message   = message
    m[0].confirmed = 0
    m[0].cancelled = 0
  ret 0

fn modal_show_confirm(m:*TzModalDialog, title:str, message:str) -> int:
  if m == 0:
    ret (0 - 1)
  unsafe:
    m[0].active    = 1
    m[0].kind      = MODAL_CONFIRM
    m[0].title     = title
    m[0].message   = message
    m[0].confirmed = 0
    m[0].cancelled = 0
  ret 0

fn modal_close(m:*TzModalDialog) -> int:
  if m == 0:
    ret 0
  unsafe:
    m[0].active = 0
  ret 0

// ── Modal Renderer ────────────────────────────────────────────────────────

fn modal_render(canvas:*GpuCanvas, m:*TzModalDialog, screen_w:int, screen_h:int, mx:int, my:int, mb:int, pmb:int) -> int:
  if canvas == 0 || m == 0:
    ret 0
  is_act:int = 0
  unsafe:
    is_act = m[0].active
  if is_act == 0:
    ret 0

  lmb_click:int = (mb & 1) != 0 && (pmb & 1) == 0

  // 1. Full-screen backdrop dimming
  gpu_render.gpr_blend(canvas, 0, 0, screen_w, screen_h, 0x03060C, 160)

  // 2. Elevated Modal Dialog Card
  mw:int = 420
  mh:int = 200
  dx:int = (screen_w - mw) / 2
  dy:int = (screen_h - mh) / 2

  // Deep shadow
  gpu_render.gpr_shadow(canvas, dx, dy, mw, mh, 12, 180)
  gpu_render.gpr_rect_r(canvas, dx, dy, mw, mh, 0x111A2B, 10)
  gpu_render.gpr_sheen(canvas, dx + 10, dy, mw - 20, 0x3A5078)
  gpu_render.gpr_outline(canvas, dx, dy, mw, mh, 0x364B6E)

  // Top header bar
  gpu_render.gpr_rect_r(canvas, dx, dy, mw, 36, 0x152033, 10)
  gpu_render.gpr_rect_r(canvas, dx, dy + 28, mw, 8, 0x152033, 0)
  gpu_render.gpr_rect_r(canvas, dx, dy + 36, mw, 1, 0x223048, 0)

  // Title icon & text
  title_str:str = "Dialog"
  msg_str:str = "Notice"
  kind_val:int = 0
  unsafe:
    if m[0].title != 0: title_str = m[0].title
    if m[0].message != 0: msg_str = m[0].message
    kind_val = m[0].kind

  icon_c:int = 0x6366F1
  if kind_val == MODAL_ALERT:
    icon_c = 0xF59E0B
    tzicon.tzi_draw_icon(canvas, dx + 14, dy + 10, 16, tzicon.icon_warning(), icon_c)
  else:
    tzicon.tzi_draw_icon(canvas, dx + 14, dy + 10, 16, tzicon.icon_info(), icon_c)

  tzfont.tzf_draw_text(canvas, dx + 38, dy + 11, title_str, tzfont.font_poppins(), 1, tzfont.weight_semibold(), 0xF8FAFC)

  // Close 'X' in top-right
  is_x_hot:int = (mx >= dx + mw - 28 && mx <= dx + mw - 8 && my >= dy + 8 && my <= dy + 28)
  if is_x_hot != 0:
    gpu_render.gpr_rect_r(canvas, dx + mw - 28, dy + 8, 20, 20, 0x1F2C45, 4)
    if lmb_click != 0:
      modal_close(m)
  tzicon.tzi_draw_icon(canvas, dx + mw - 26, dy + 10, 16, tzicon.icon_close(), 0x94A3B8)

  // Dialog Message Body
  tzfont.tzf_draw_text(canvas, dx + 20, dy + 60, msg_str, tzfont.font_poppins(), 1, tzfont.weight_regular(), 0x94A3B8)

  // Bottom action buttons
  btn_y:int = dy + mh - 48

  if kind_val == MODAL_CONFIRM:
    // Cancel button
    cx_btn:int = dx + mw - 196
    is_c_hot:int = (mx >= cx_btn && mx <= cx_btn + 86 && my >= btn_y && my <= btn_y + 34)
    c_bg:int = 0x18243A
    if is_c_hot != 0:
      c_bg = 0x22324E
      if lmb_click != 0:
        unsafe:
          m[0].cancelled = 1
        modal_close(m)
    gpu_render.gpr_rect_r(canvas, cx_btn, btn_y, 86, 34, c_bg, 6)
    gpu_render.gpr_outline(canvas, cx_btn, btn_y, 86, 34, 0x24324D)
    tzfont.tzf_draw_text_aligned(canvas, cx_btn, btn_y + 10, 86, "Cancel", tzfont.font_poppins(), 1, tzfont.weight_regular(), 0x94A3B8, tzfont.align_center())

    // Confirm button
    ok_btn:int = dx + mw - 100
    is_ok_hot:int = (mx >= ok_btn && mx <= ok_btn + 86 && my >= btn_y && my <= btn_y + 34)
    ok_bg:int = 0x6366F1
    if is_ok_hot != 0:
      ok_bg = 0x818CF8
      if lmb_click != 0:
        unsafe:
          m[0].confirmed = 1
        modal_close(m)
    gpu_render.gpr_rect_r(canvas, ok_btn, btn_y, 86, 34, ok_bg, 6)
    gpu_render.gpr_sheen(canvas, ok_btn + 4, btn_y, 78, 0xA5B4FC)
    tzfont.tzf_draw_text_aligned(canvas, ok_btn, btn_y + 10, 86, "Confirm", tzfont.font_poppins(), 1, tzfont.weight_semibold(), 0xFFFFFF, tzfont.align_center())
  else:
    // OK button
    ok_single:int = dx + mw - 110
    is_s_hot:int = (mx >= ok_single && mx <= ok_single + 96 && my >= btn_y && my <= btn_y + 34)
    s_bg:int = 0x6366F1
    if is_s_hot != 0:
      s_bg = 0x818CF8
      if lmb_click != 0:
        unsafe:
          m[0].confirmed = 1
        modal_close(m)
    gpu_render.gpr_rect_r(canvas, ok_single, btn_y, 96, 34, s_bg, 6)
    gpu_render.gpr_sheen(canvas, ok_single + 4, btn_y, 88, 0xA5B4FC)
    tzfont.tzf_draw_text_aligned(canvas, ok_single, btn_y + 10, 96, "OK", tzfont.font_poppins(), 1, tzfont.weight_semibold(), 0xFFFFFF, tzfont.align_center())

  ret 1
