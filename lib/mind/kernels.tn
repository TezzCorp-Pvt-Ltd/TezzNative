// mind implementation: kernels.
import "math"
import "str"
import "nn"
import "mind.core"
import "mind.state"

fn _rmsnorm_forward(x:*float, out:*float, gamma:*float, T:int, dim:int) -> int:
  eps:float = 1.0e-05
  t:int = 0
  while t < T:
    sq_sum:float = 0.0
    j:int = 0
    while j < dim:
      v:float = mind.core._mf(x, t * dim + j)
      sq_sum = sq_sum + v * v
      j = j + 1
    rms_inv:float = 1.0 / math.sqrt(sq_sum / (dim as float) + eps)
    j = 0
    while j < dim:
      xv:float = mind.core._mf(x, t * dim + j)
      g:float = 1.0
      if gamma != 0 as *float:
        g = mind.core._mf(gamma, j)
      mind.core._mw(out, t * dim + j, xv * rms_inv * g)
      j = j + 1
    t = t + 1
  ret 0

fn _rmsnorm_backward(dx_norm:*float, x:*float, gamma:*float, dx:*float, dgamma:*float, T:int, dim:int) -> int:
  eps:float = 1.0e-05
  xv:float = 0.0
  dyn:float = 0.0
  g:float = 1.0
  t:int = 0
  while t < T:
    sq_sum:float = 0.0
    j:int = 0
    while j < dim:
      v:float = mind.core._mf(x, t * dim + j)
      sq_sum = sq_sum + v * v
      j = j + 1
    rms:float = math.sqrt(sq_sum / (dim as float) + eps)
    rms_inv:float = 1.0 / rms

    sum_dy_x_gamma:float = 0.0
    j = 0
    while j < dim:
      xv = mind.core._mf(x, t * dim + j)
      dyn = mind.core._mf(dx_norm, t * dim + j)
      g = 1.0
      if gamma != 0 as *float:
        g = mind.core._mf(gamma, j)
      sum_dy_x_gamma = sum_dy_x_gamma + dyn * xv * g
      j = j + 1

    j = 0
    while j < dim:
      xv = mind.core._mf(x, t * dim + j)
      dyn = mind.core._mf(dx_norm, t * dim + j)
      g = 1.0
      if gamma != 0 as *float:
        g = mind.core._mf(gamma, j)

      term1:float = (g * dyn) * rms_inv
      term2:float = (xv * rms_inv * rms_inv * rms_inv / (dim as float)) * sum_dy_x_gamma
      mind.core._mw(dx, t * dim + j, mind.core._mf(dx, t * dim + j) + term1 - term2)

      if dgamma != 0 as *float:
        mind.core._mw(dgamma, j, mind.core._mf(dgamma, j) + dyn * xv * rms_inv)
      j = j + 1
    t = t + 1
  ret 0

fn _matmul_forward_scalar(x:*float, w:*float, out:*float, T:int, in_dim:int, out_dim:int) -> int:
  if x == 0 as *float || w == 0 as *float || out == 0 as *float:
    ret 0 - 1
  if T <= 0 || in_dim <= 0 || out_dim <= 0:
    ret 0 - 1
  t:int = 0
  while t < T:
    j:int = 0
    while j < out_dim:
      acc:float = 0.0
      k:int = 0
      while k < in_dim:
        acc = acc + mind.core._mf(x, t * in_dim + k) * mind.core._mf(w, k * out_dim + j)
        k = k + 1
      mind.core._mw(out, t * out_dim + j, acc)
      j = j + 1
    t = t + 1
  ret 0

fn _matmul_forward(x:*float, w:*float, out:*float, T:int, in_dim:int, out_dim:int) -> int:
  if out == x || out == w:
    slots:int = T * out_dim
    tmp_raw:*char
    unsafe:
      tmp_raw = malloc(slots * 8)
    if tmp_raw == 0:
      ret 0 - 1
    tmp:*float = tmp_raw as *float
    rc_alias:int = _matmul_forward_scalar(x, w, tmp, T, in_dim, out_dim)
    i:int = 0
    while i < slots:
      mind.core._mw(out, i, mind.core._mf(tmp, i))
      i = i + 1
    unsafe:
      free(tmp_raw)
    ret rc_alias
  rc:int = mind.core.nn_matmul_avx2(x, w, out, T, in_dim, out_dim)
  if rc == 0:
    ret 0
  ret _matmul_forward_scalar(x, w, out, T, in_dim, out_dim)

fn _matmul_backward_inputs(dy:*float, w:*float, dx:*float, T:int, in_dim:int, out_dim:int) -> int:
  t:int = 0
  while t < T:
    k:int = 0
    while k < in_dim:
      acc:float = 0.0
      j:int = 0
      while j < out_dim:
        acc = acc + mind.core._mf(dy, t * out_dim + j) * mind.core._mf(w, k * out_dim + j)
        j = j + 1
      mind.core._mw(dx, t * in_dim + k, mind.core._mf(dx, t * in_dim + k) + acc)
      k = k + 1
    t = t + 1
  ret 0

fn _matmul_backward_weights(x:*float, dy:*float, dw:*float, T:int, in_dim:int, out_dim:int) -> int:
  k:int = 0
  while k < in_dim:
    j:int = 0
    while j < out_dim:
      acc:float = 0.0
      t:int = 0
      while t < T:
        acc = acc + mind.core._mf(x, t * in_dim + k) * mind.core._mf(dy, t * out_dim + j)
        t = t + 1
      mind.core._mw(dw, k * out_dim + j, mind.core._mf(dw, k * out_dim + j) + acc)
      j = j + 1
    k = k + 1
  ret 0

fn _rope_forward(q:*float, k:*float, T:int, q_heads:int, kv_heads:int, head_dim:int, pos_offset:int) -> int:
  eps_base:float = 10000.0
  log_base:float = math.log(eps_base)
  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * q_heads * head_dim + qh * head_dim + i
        idx1:int = idx0 + 1
        q0:float = mind.core._mf(q, idx0)
        q1:float = mind.core._mf(q, idx1)
        mind.core._mw(q, idx0, q0 * cc - q1 * ss)
        mind.core._mw(q, idx1, q0 * ss + q1 * cc)
        i = i + 2
      qh = qh + 1

    kvh:int = 0
    while kvh < kv_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * kv_heads * head_dim + kvh * head_dim + i
        idx1:int = idx0 + 1
        k0:float = mind.core._mf(k, idx0)
        k1:float = mind.core._mf(k, idx1)
        mind.core._mw(k, idx0, k0 * cc - k1 * ss)
        mind.core._mw(k, idx1, k0 * ss + k1 * cc)
        i = i + 2
      kvh = kvh + 1
    t = t + 1
  ret 0

fn _rope_backward(dq:*float, dk:*float, T:int, q_heads:int, kv_heads:int, head_dim:int, pos_offset:int) -> int:
  eps_base:float = 10000.0
  log_base:float = math.log(eps_base)
  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * q_heads * head_dim + qh * head_dim + i
        idx1:int = idx0 + 1
        dq0:float = mind.core._mf(dq, idx0)
        dq1:float = mind.core._mf(dq, idx1)
        mind.core._mw(dq, idx0, dq0 * cc + dq1 * ss)
        mind.core._mw(dq, idx1, (0.0 - dq0) * ss + dq1 * cc)
        i = i + 2
      qh = qh + 1

    kvh:int = 0
    while kvh < kv_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * kv_heads * head_dim + kvh * head_dim + i
        idx1:int = idx0 + 1
        dk0:float = mind.core._mf(dk, idx0)
        dk1:float = mind.core._mf(dk, idx1)
        mind.core._mw(dk, idx0, dk0 * cc + dk1 * ss)
        mind.core._mw(dk, idx1, (0.0 - dk0) * ss + dk1 * cc)
        i = i + 2
      kvh = kvh + 1
    t = t + 1
  ret 0

fn _gqa_forward(q:*float, k:*float, v:*float, out:*float, probs_buf:*float, T:int, q_heads:int, kv_heads:int, head_dim:int) -> int:
  groups:int = q_heads / kv_heads
  scale:float = 1.0 / math.sqrt(head_dim as float)

  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      kvh:int = qh / groups

      max_score:float = 0.0 - 1.0e+09
      p:int = 0
      while p <= t:
        dot:float = 0.0
        c:int = 0
        while c < head_dim:
          qv:float = mind.core._mf(q, t * q_heads * head_dim + qh * head_dim + c)
          kv:float = mind.core._mf(k, p * kv_heads * head_dim + kvh * head_dim + c)
          dot = dot + qv * kv
          c = c + 1
        score:float = dot * scale
        mind.core._mw(probs_buf, t * q_heads * T + qh * T + p, score)
        if score > max_score:
          max_score = score
        p = p + 1

      exp_sum:float = 0.0
      p = 0
      while p <= t:
        sc:float = mind.core._mf(probs_buf, t * q_heads * T + qh * T + p)
        ev:float = math.exp(sc - max_score)
        mind.core._mw(probs_buf, t * q_heads * T + qh * T + p, ev)
        exp_sum = exp_sum + ev
        p = p + 1

      if exp_sum > 0.0:
        p = 0
        while p <= t:
          ev:float = mind.core._mf(probs_buf, t * q_heads * T + qh * T + p)
          mind.core._mw(probs_buf, t * q_heads * T + qh * T + p, ev / exp_sum)
          p = p + 1

      c = 0
      while c < head_dim:
        acc:float = 0.0
        p = 0
        while p <= t:
          attn:float = mind.core._mf(probs_buf, t * q_heads * T + qh * T + p)
          vv:float = mind.core._mf(v, p * kv_heads * head_dim + kvh * head_dim + c)
          acc = acc + attn * vv
          p = p + 1
        mind.core._mw(out, t * q_heads * head_dim + qh * head_dim + c, acc)
        c = c + 1

      qh = qh + 1
    t = t + 1
  ret 0

fn _gqa_backward(dq:*float, dk:*float, dv:*float, q:*float, k:*float, v:*float, probs_buf:*float, d_out:*float, d_probs_temp:*float, T:int, q_heads:int, kv_heads:int, head_dim:int) -> int:
  groups:int = q_heads / kv_heads
  scale:float = 1.0 / math.sqrt(head_dim as float)
  do:float = 0.0
  d_pr:float = 0.0
  pr:float = 0.0

  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      kvh:int = qh / groups

      p:int = 0
      while p <= t:
        d_pr = 0.0
        c:int = 0
        while c < head_dim:
          do = mind.core._mf(d_out, t * q_heads * head_dim + qh * head_dim + c)
          vv:float = mind.core._mf(v, p * kv_heads * head_dim + kvh * head_dim + c)
          d_pr = d_pr + do * vv
          c = c + 1
        mind.core._mw(d_probs_temp, p, d_pr)

        pr = mind.core._mf(probs_buf, t * q_heads * T + qh * T + p)
        c = 0
        while c < head_dim:
          do = mind.core._mf(d_out, t * q_heads * head_dim + qh * head_dim + c)
          idx:int = p * kv_heads * head_dim + kvh * head_dim + c
          mind.core._mw(dv, idx, mind.core._mf(dv, idx) + pr * do)
          c = c + 1
        p = p + 1

      sum_dpr_pr:float = 0.0
      p = 0
      while p <= t:
        d_pr = mind.core._mf(d_probs_temp, p)
        pr = mind.core._mf(probs_buf, t * q_heads * T + qh * T + p)
        sum_dpr_pr = sum_dpr_pr + d_pr * pr
        p = p + 1

      p = 0
      while p <= t:
        d_pr = mind.core._mf(d_probs_temp, p)
        pr = mind.core._mf(probs_buf, t * q_heads * T + qh * T + p)
        d_sc:float = pr * (d_pr - sum_dpr_pr)

        c = 0
        while c < head_dim:
          qv:float = mind.core._mf(q, t * q_heads * head_dim + qh * head_dim + c)
          kv:float = mind.core._mf(k, p * kv_heads * head_dim + kvh * head_dim + c)

          q_idx:int = t * q_heads * head_dim + qh * head_dim + c
          k_idx:int = p * kv_heads * head_dim + kvh * head_dim + c

          mind.core._mw(dq, q_idx, mind.core._mf(dq, q_idx) + d_sc * kv * scale)
          mind.core._mw(dk, k_idx, mind.core._mf(dk, k_idx) + d_sc * qv * scale)
          c = c + 1
        p = p + 1

      qh = qh + 1
    t = t + 1
  ret 0

fn _swiglu_forward(gate:*float, up:*float, out:*float, T:int, ffn:int) -> int:
  t:int = 0
  while t < T:
    i:int = 0
    while i < ffn:
      g:float = mind.core._mf(gate, t * ffn + i)
      u:float = mind.core._mf(up, t * ffn + i)
      ag:float = g
      if ag < 0.0:
        ag = 0.0 - ag
      sig_g:float = 0.5 * (g / (1.0 + ag)) + 0.5
      mind.core._mw(out, t * ffn + i, sig_g * g * u)
      i = i + 1
    t = t + 1
  ret 0

fn _swiglu_backward(d_out:*float, gate:*float, up:*float, d_gate:*float, d_up:*float, T:int, ffn:int) -> int:
  t:int = 0
  while t < T:
    i:int = 0
    while i < ffn:
      g:float = mind.core._mf(gate, t * ffn + i)
      u:float = mind.core._mf(up, t * ffn + i)
      do:float = mind.core._mf(d_out, t * ffn + i)

      ag:float = g
      if ag < 0.0:
        ag = 0.0 - ag
      sig_g:float = 0.5 * (g / (1.0 + ag)) + 0.5

      dsilu:float = sig_g * (1.0 + g * (1.0 - sig_g))

      mind.core._mw(d_up, t * ffn + i, mind.core._mf(d_up, t * ffn + i) + do * (sig_g * g))
      mind.core._mw(d_gate, t * ffn + i, mind.core._mf(d_gate, t * ffn + i) + do * u * dsilu)
      i = i + 1
    t = t + 1
  ret 0

