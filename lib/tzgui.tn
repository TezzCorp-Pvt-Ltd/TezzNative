struct TzWidgetStyle:
  bg:int
  fg:int
  border_color:int
  border_width:int
  radius:int
  gradient_color:int
  gradient_axis:int
  shadow_color:int
  shadow_size:int
  text_align:int
  hover_bg:int
  pressed_bg:int
  disabled_bg:int
  focus_color:int
  hover_border:int
  text_scale:int
  text_bold:int
  font_size:int
  font_weight:int
  font_family:str

struct TzWidgetLayout:
  mode:int
  gap:int
  justify:int
  align:int
  pad_top:int
  pad_right:int
  pad_bottom:int
  pad_left:int

fn _tree_color_scale(color:int, pct:int) -> int:
  r:int = (color / 65536) % 256
  g:int = (color / 256) % 256
  b:int = color % 256
  r = r * pct / 100
  g = g * pct / 100
  b = b * pct / 100
  if r > 255:
    r = 255
  if g > 255:
    g = 255
  if b > 255:
    b = 255
  ret r * 65536 + g * 256 + b

fn widget_style_init(out:*TzWidgetStyle, bg:int, fg:int) -> int:
  if out == 0:
    ret 0 - 1
  out[0].bg = bg
  out[0].fg = fg
  out[0].border_color = 0x334155
  out[0].border_width = 1
  out[0].radius = 6
  out[0].gradient_color = bg
  out[0].gradient_axis = TZ_GRADIENT_NONE
  out[0].shadow_color = 0x03060C
  out[0].shadow_size = 0
  out[0].text_align = 0
  out[0].hover_bg = _tree_color_scale(bg, 112)
  out[0].pressed_bg = _tree_color_scale(bg, 82)
  out[0].disabled_bg = _tree_color_scale(bg, 70)
  out[0].focus_color = 0x818CF8
  out[0].hover_border = 0 - 1
  out[0].text_scale = 1
  out[0].text_bold = 0
  out[0].font_size = 0
  out[0].font_weight = 0
  out[0].font_family = "Segoe UI"
  ret 0

fn widget_layout_init(out:*TzWidgetLayout, mode:int) -> int:
  if out == 0:
    ret 0 - 1
  if mode < TZ_LAYOUT_ABSOLUTE || mode > TZ_LAYOUT_COLUMN:
    ret 0 - 2
  out[0].mode = mode
  out[0].gap = 8
  out[0].justify = TZ_JUSTIFY_START
  out[0].align = TZ_ALIGN_STRETCH
  out[0].pad_top = 0
  out[0].pad_right = 0
  out[0].pad_bottom = 0
  out[0].pad_left = 0
  ret 0

