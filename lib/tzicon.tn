// tzicon.tn — TezzNative Vector Icon, App Icon & Notification Engine v1.0
//
// Features:
//  - Procedural vector iconography (scalable to 12px..64px without pixelation)
//  - Comprehensive icon set: Media/VLC, navigation, system, file types, status
//  - Glossy app icon generator (macOS / iOS style rounded tiles with emblems)
//  - Notification badge & system tray icon support (unread counters, status pips)

import "gpu_render"
import "tzfont"

// ── Icon ID constants & accessors ─────────────────────────────────────────

let ICON_PLAY:int           = 0
let ICON_PAUSE:int          = 1
let ICON_STOP:int           = 2
let ICON_FORWARD:int        = 3
let ICON_BACKWARD:int       = 4
let ICON_VOLUME:int         = 5
let ICON_MUTE:int           = 6
let ICON_SUBTITLES:int      = 7
let ICON_FULLSCREEN:int     = 8
let ICON_SPEED:int          = 9
let ICON_HOME:int           = 10
let ICON_SETTINGS:int       = 11
let ICON_SEARCH:int         = 12
let ICON_BELL:int           = 13
let ICON_FOLDER:int         = 14
let ICON_FILE:int           = 15
let ICON_VIDEO:int          = 16
let ICON_MUSIC:int          = 17
let ICON_USER:int           = 18
let ICON_CHECK:int          = 19
let ICON_CLOSE:int          = 20
let ICON_REFRESH:int        = 21
let ICON_CHEVRON_LEFT:int   = 22
let ICON_CHEVRON_RIGHT:int  = 23
let ICON_CHEVRON_DOWN:int   = 24
let ICON_CHEVRON_UP:int     = 25
let ICON_INFO:int           = 26
let ICON_WARNING:int        = 27
let ICON_ERROR:int          = 28
let ICON_SUCCESS:int        = 29
let ICON_WIFI:int           = 30
let ICON_BATTERY:int        = 31

fn icon_play() -> int: ret 0
fn icon_pause() -> int: ret 1
fn icon_stop() -> int: ret 2
fn icon_forward() -> int: ret 3
fn icon_backward() -> int: ret 4
fn icon_volume() -> int: ret 5
fn icon_mute() -> int: ret 6
fn icon_subtitles() -> int: ret 7
fn icon_fullscreen() -> int: ret 8
fn icon_speed() -> int: ret 9
fn icon_home() -> int: ret 10
fn icon_settings() -> int: ret 11
fn icon_search() -> int: ret 12
fn icon_bell() -> int: ret 13
fn icon_folder() -> int: ret 14
fn icon_file() -> int: ret 15
fn icon_video() -> int: ret 16
fn icon_music() -> int: ret 17
fn icon_user() -> int: ret 18
fn icon_check() -> int: ret 19
fn icon_close() -> int: ret 20
fn icon_refresh() -> int: ret 21
fn icon_chevron_left() -> int: ret 22
fn icon_chevron_right() -> int: ret 23
fn icon_chevron_down() -> int: ret 24
fn icon_chevron_up() -> int: ret 25
fn icon_info() -> int: ret 26
fn icon_warning() -> int: ret 27
fn icon_error() -> int: ret 28
fn icon_success() -> int: ret 29
fn icon_wifi() -> int: ret 30
fn icon_battery() -> int: ret 31

// App types for App Icon generator
let APP_VLC:int        = 0
let APP_STUDIO:int     = 1
let APP_TYPOGRAPHY:int = 2
let APP_CODE:int       = 3
let APP_SETTINGS:int   = 4
let APP_BROWSER:int    = 5
let APP_TERMINAL:int   = 6
let APP_FILES:int      = 7
let APP_MEDIA:int      = 8

fn app_vlc() -> int: ret 0
fn app_studio() -> int: ret 1
fn app_typography() -> int: ret 2
fn app_code() -> int: ret 3
fn app_settings() -> int: ret 4
fn app_browser() -> int: ret 5
fn app_terminal() -> int: ret 6
fn app_files() -> int: ret 7
fn app_media() -> int: ret 8

// ── Vector Icon Renderer ──────────────────────────────────────────────────

fn tzi_draw_icon(canvas:*GpuCanvas, x:int, y:int, size:int, icon_id:int, color:int) -> int:
  if canvas == 0 || size <= 0:
    ret (0 - 1)
  half:int = size / 2
  cx:int = x + half
  cy:int = y + half
  thick:int = size / 8
  if thick < 1:
    thick = 1

  // PLAY: Right-pointing triangle
  if icon_id == ICON_PLAY:
    col:int = 0
    while col < size - thick:
      h_col:int = ((size - thick - col) * half) / (size - thick)
      gpu_render.gpr_rect(canvas, x + col, cy - h_col, 1, 2 * h_col + 1, color)
      col = col + 1
    ret 0

  // PAUSE: Two vertical bars
  if icon_id == ICON_PAUSE:
    bar_w:int = size / 4
    if bar_w < 2: bar_w = 2
    gpu_render.gpr_rect_r(canvas, x + size/6, y, bar_w, size, color, 1)
    gpu_render.gpr_rect_r(canvas, x + size - size/6 - bar_w, y, bar_w, size, color, 1)
    ret 0

  // STOP: Centered filled square
  if icon_id == ICON_STOP:
    inset:int = size / 6
    gpu_render.gpr_rect_r(canvas, x + inset, y + inset, size - 2*inset, size - 2*inset, color, 2)
    ret 0

  // FORWARD: Two right-pointing triangles
  if icon_id == ICON_FORWARD:
    w1:int = half
    col1:int = 0
    while col1 < w1:
      h1:int = ((w1 - col1) * half) / w1
      gpu_render.gpr_rect(canvas, x + col1, cy - h1, 1, 2*h1 + 1, color)
      gpu_render.gpr_rect(canvas, x + half/2 + col1, cy - h1, 1, 2*h1 + 1, color)
      col1 = col1 + 1
    ret 0

  // BACKWARD: Two left-pointing triangles
  if icon_id == ICON_BACKWARD:
    w2:int = half
    col2:int = 0
    while col2 < w2:
      h2:int = (col2 * half) / w2
      gpu_render.gpr_rect(canvas, x + col2, cy - h2, 1, 2*h2 + 1, color)
      gpu_render.gpr_rect(canvas, x + half/2 + col2, cy - h2, 1, 2*h2 + 1, color)
      col2 = col2 + 1
    ret 0

  // VOLUME: Speaker cone + sound wave
  if icon_id == ICON_VOLUME || icon_id == ICON_MUTE:
    // Speaker back
    gpu_render.gpr_rect(canvas, x, cy - size/6, size/4, size/3, color)
    // Speaker cone expansion
    i:int = 0
    while i < size/3:
      gpu_render.gpr_rect(canvas, x + size/4 + i, cy - size/6 - i, 1, size/3 + 2*i, color)
      i = i + 1
    // Sound wave arcs
    if icon_id == ICON_VOLUME:
      gpu_render.gpr_line(canvas, cx + size/4, cy - size/4, cx + size/3, cy, color, thick)
      gpu_render.gpr_line(canvas, cx + size/3, cy, cx + size/4, cy + size/4, color, thick)
    else:
      // MUTE slash 'X'
      gpu_render.gpr_line(canvas, cx + size/5, cy - size/4, cx + size/2, cy + size/4, 0xF43F5E, thick)
      gpu_render.gpr_line(canvas, cx + size/5, cy + size/4, cx + size/2, cy - size/4, 0xF43F5E, thick)
    ret 0

  // SUBTITLES: Rounded box with text lines
  if icon_id == ICON_SUBTITLES:
    gpu_render.gpr_outline(canvas, x, y + size/6, size, size*2/3, color)
    gpu_render.gpr_rect(canvas, x + size/5, cy - thick, size*3/5, thick, color)
    gpu_render.gpr_rect(canvas, x + size/4, cy + thick, size/2, thick, color)
    ret 0

  // FULLSCREEN: 4 corner brackets
  if icon_id == ICON_FULLSCREEN:
    arm:int = size / 3
    // Top-left
    gpu_render.gpr_rect(canvas, x, y, arm, thick, color)
    gpu_render.gpr_rect(canvas, x, y, thick, arm, color)
    // Top-right
    gpu_render.gpr_rect(canvas, x + size - arm, y, arm, thick, color)
    gpu_render.gpr_rect(canvas, x + size - thick, y, thick, arm, color)
    // Bottom-left
    gpu_render.gpr_rect(canvas, x, y + size - thick, arm, thick, color)
    gpu_render.gpr_rect(canvas, x, y + size - arm, thick, arm, color)
    // Bottom-right
    gpu_render.gpr_rect(canvas, x + size - arm, y + size - thick, arm, thick, color)
    gpu_render.gpr_rect(canvas, x + size - thick, y + size - arm, thick, arm, color)
    ret 0

  // HOME: Roof + house body
  if icon_id == ICON_HOME:
    // Triangle roof
    r_row:int = 0
    while r_row < half:
      gpu_render.gpr_rect(canvas, cx - r_row, y + half - r_row, 2*r_row + 1, thick, color)
      r_row = r_row + thick
    // House base
    gpu_render.gpr_outline(canvas, x + size/5, cy, size*3/5, half, color)
    // Door
    gpu_render.gpr_rect(canvas, cx - size/8, y + size - size/4, size/4, size/4, color)
    ret 0

  // SETTINGS: Gear cog
  if icon_id == ICON_SETTINGS:
    gpu_render.gpr_circle(canvas, cx, cy, half - 1, color)
    gpu_render.gpr_circle(canvas, cx, cy, size/4, 0x080C14)
    // Gear teeth
    gpu_render.gpr_rect(canvas, cx - thick/2, y, thick, size, color)
    gpu_render.gpr_rect(canvas, x, cy - thick/2, size, thick, color)
    ret 0

  // SEARCH: Magnifying glass
  if icon_id == ICON_SEARCH:
    rad:int = size / 3
    gpu_render.gpr_circle(canvas, x + rad, y + rad, rad, color)
    gpu_render.gpr_circle(canvas, x + rad, y + rad, rad - thick, 0x080C14)
    gpu_render.gpr_line(canvas, x + rad*2 - 2, y + rad*2 - 2, x + size - 1, y + size - 1, color, thick + 1)
    ret 0

  // BELL: Notification bell
  if icon_id == ICON_BELL:
    gpu_render.gpr_circle(canvas, cx, cy, size/3, color)
    gpu_render.gpr_rect(canvas, cx - size/3, cy, size*2/3, size/4, color)
    gpu_render.gpr_circle(canvas, cx, y + size - thick, size/6, color)
    ret 0

  // CHECK: Checkmark
  if icon_id == ICON_CHECK:
    gpu_render.gpr_line(canvas, x + size/5, cy, cx, y + size - size/4, color, thick + 1)
    gpu_render.gpr_line(canvas, cx, y + size - size/4, x + size - size/6, y + size/5, color, thick + 1)
    ret 0

  // CLOSE: Cross 'X'
  if icon_id == ICON_CLOSE:
    gpu_render.gpr_line(canvas, x + size/5, y + size/5, x + size - size/5, y + size - size/5, color, thick)
    gpu_render.gpr_line(canvas, x + size/5, y + size - size/5, x + size - size/5, y + size/5, color, thick)
    ret 0

  // CHEVRONS
  if icon_id == ICON_CHEVRON_LEFT:
    gpu_render.gpr_line(canvas, cx + size/6, y + size/5, cx - size/6, cy, color, thick)
    gpu_render.gpr_line(canvas, cx - size/6, cy, cx + size/6, y + size - size/5, color, thick)
    ret 0
  if icon_id == ICON_CHEVRON_RIGHT:
    gpu_render.gpr_line(canvas, cx - size/6, y + size/5, cx + size/6, cy, color, thick)
    gpu_render.gpr_line(canvas, cx + size/6, cy, cx - size/6, y + size - size/5, color, thick)
    ret 0
  if icon_id == ICON_CHEVRON_DOWN:
    gpu_render.gpr_line(canvas, x + size/5, cy - size/6, cx, cy + size/6, color, thick)
    gpu_render.gpr_line(canvas, cx, cy + size/6, x + size - size/5, cy - size/6, color, thick)
    ret 0
  if icon_id == ICON_CHEVRON_UP:
    gpu_render.gpr_line(canvas, x + size/5, cy + size/6, cx, cy - size/6, color, thick)
    gpu_render.gpr_line(canvas, cx, cy - size/6, x + size - size/5, cy + size/6, color, thick)
    ret 0

  // REFRESH: Circular arrow
  if icon_id == ICON_REFRESH:
    gpu_render.gpr_circle(canvas, cx, cy, half - 1, color)
    gpu_render.gpr_circle(canvas, cx, cy, half - thick - 1, 0x080C14)
    gpu_render.gpr_rect(canvas, cx, cy - half, half, half, 0x080C14)
    gpu_render.gpr_line(canvas, cx, y, cx + size/4, y + size/4, color, thick)
    gpu_render.gpr_line(canvas, cx + size/4, y, cx, y, color, thick)
    ret 0

  // WIFI: Radiating signal bars
  if icon_id == ICON_WIFI:
    // Bottom dot
    gpu_render.gpr_circle(canvas, cx, y + size - thick - 2, thick, color)
    // Mid wave
    gpu_render.gpr_line(canvas, cx - size/4, y + size/2, cx, y + size*3/8, color, thick)
    gpu_render.gpr_line(canvas, cx, y + size*3/8, cx + size/4, y + size/2, color, thick)
    // Outer wave
    gpu_render.gpr_line(canvas, cx - half + 2, y + size/3, cx, y + size/6, color, thick)
    gpu_render.gpr_line(canvas, cx, y + size/6, cx + half - 2, y + size/3, color, thick)
    ret 0

  // BATTERY
  if icon_id == ICON_BATTERY:
    bw:int = size - 6
    bh:int = size / 2
    by:int = cy - bh / 2
    gpu_render.gpr_outline(canvas, x + 1, by, bw, bh, color)
    gpu_render.gpr_rect(canvas, x + 1 + bw, cy - bh / 4, 3, bh / 2, color)
    gpu_render.gpr_rect(canvas, x + 3, by + 2, bw - 4, bh - 4, color)
    ret 0

  // Fallback: filled dot
  gpu_render.gpr_circle(canvas, cx, cy, half - 2, color)
  ret 0

// ── App Icon Generator (macOS/iOS Glossy Squircle Tiles) ──────────────────

fn tzi_draw_app_icon(canvas:*GpuCanvas, x:int, y:int, size:int, app_type:int) -> int:
  if canvas == 0 || size <= 0:
    ret (0 - 1)
  r:int = size / 4
  // Drop shadow
  gpu_render.gpr_shadow(canvas, x, y, size, size, size/8, 160)

  // Gradient tile background
  c_top:int = 0x6366F1
  c_bot:int = 0x4338CA
  if app_type == APP_VLC:
    c_top = 0xF97316  // Orange
    c_bot = 0xC2410C
  if app_type == APP_TYPOGRAPHY:
    c_top = 0x06B6D4  // Cyan
    c_bot = 0x0E7490
  if app_type == APP_CODE:
    c_top = 0x10B981  // Emerald
    c_bot = 0x047857
  if app_type == APP_SETTINGS:
    c_top = 0x475569  // Slate
    c_bot = 0x1E293B
  if app_type == APP_BROWSER:
    c_top = 0x0284C7  // Sky Blue
    c_bot = 0x0369A1
  if app_type == APP_TERMINAL:
    c_top = 0x1E293B  // Dark Terminal
    c_bot = 0x0F172A
  if app_type == APP_FILES:
    c_top = 0xF59E0B  // Amber Folder
    c_bot = 0xD97706
  if app_type == APP_MEDIA:
    c_top = 0x8B5CF6  // Purple Media
    c_bot = 0x6D28D9

  gpu_render.gpr_gradient_v(canvas, x, y, size, size, c_top, c_bot)
  gpu_render.gpr_sheen(canvas, x + r, y, size - 2*r, gpu_render.gpr_brighten(c_top, 40))
  gpu_render.gpr_outline(canvas, x, y, size, size, gpu_render.gpr_darken(c_bot, 20))

  // App Emblems:
  cx:int = x + size / 2
  cy:int = y + size / 2
  emblem_sz:int = size / 2

  // VLC CONE EMBLEM
  if app_type == APP_VLC:
    // Base oval
    gpu_render.gpr_rect_r(canvas, cx - emblem_sz/2, cy + emblem_sz/4, emblem_sz, size/8, 0xFFFFFF, 2)
    // Cone body (orange with white horizontal stripes)
    cone_h:int = emblem_sz * 3 / 4
    row:int = 0
    while row < cone_h:
      w_row:int = emblem_sz/2 - (row * emblem_sz / 3) / cone_h
      col_stripe:int = 0xF97316
      if row > cone_h/4 && row < cone_h*2/4:
        col_stripe = 0xFFFFFF
      if row > cone_h*3/4:
        col_stripe = 0xFFFFFF
      gpu_render.gpr_rect(canvas, cx - w_row, cy + emblem_sz/4 - row, 2*w_row, 1, col_stripe)
      row = row + 1
    ret 0

  // STUDIO PRO EMBLEM
  if app_type == APP_STUDIO:
    tzi_draw_icon(canvas, cx - emblem_sz/2, cy - emblem_sz/2, emblem_sz, ICON_PLAY, 0xFFFFFF)
    ret 0

  // TYPOGRAPHY EMBLEM
  if app_type == APP_TYPOGRAPHY:
    gpu_render.gpr_text_ex(canvas, cx - size/4, cy - size/4, "Aa", 0xFFFFFF, size / 16, 1)
    ret 0

  // CODE EMBLEM: </>
  if app_type == APP_CODE:
    gpu_render.gpr_text_ex(canvas, cx - size/4, cy - size/4, "<>", 0xFFFFFF, size / 16, 1)
    ret 0

  // SETTINGS EMBLEM
  if app_type == APP_SETTINGS:
    tzi_draw_icon(canvas, cx - emblem_sz/2, cy - emblem_sz/2, emblem_sz, ICON_SETTINGS, 0xFFFFFF)
    ret 0

  // BROWSER EMBLEM (Globe)
  if app_type == APP_BROWSER:
    gpu_render.gpr_circle(canvas, cx, cy, emblem_sz/2, 0xFFFFFF)
    gpu_render.gpr_circle(canvas, cx, cy, emblem_sz/2 - 2, 0x0284C7)
    gpu_render.gpr_line(canvas, cx - emblem_sz/2, cy, cx + emblem_sz/2, cy, 0xFFFFFF, 1)
    gpu_render.gpr_line(canvas, cx, cy - emblem_sz/2, cx, cy + emblem_sz/2, 0xFFFFFF, 1)
    ret 0

  // TERMINAL EMBLEM (>_)
  if app_type == APP_TERMINAL:
    gpu_render.gpr_line(canvas, cx - emblem_sz/3, cy - emblem_sz/4, cx - emblem_sz/8, cy, 0x10B981, 2)
    gpu_render.gpr_line(canvas, cx - emblem_sz/8, cy, cx - emblem_sz/3, cy + emblem_sz/4, 0x10B981, 2)
    gpu_render.gpr_rect(canvas, cx + 2, cy + emblem_sz/6, emblem_sz/3, 2, 0x10B981)
    ret 0

  // FILES EMBLEM (Folder tab + sheet)
  if app_type == APP_FILES:
    tzi_draw_icon(canvas, cx - emblem_sz/2, cy - emblem_sz/2, emblem_sz, ICON_FOLDER, 0xFFFFFF)
    ret 0

  // MEDIA EMBLEM (Film reel)
  if app_type == APP_MEDIA:
    tzi_draw_icon(canvas, cx - emblem_sz/2, cy - emblem_sz/2, emblem_sz, ICON_VIDEO, 0xFFFFFF)
    ret 0

  ret 0

// Interactive desktop / launcher app tile with drop shadow, hover elevation, and label
fn tzi_draw_app_tile(canvas:*GpuCanvas, x:int, y:int, size:int, app_type:int, title:str, is_hot:int, is_active:int) -> int:
  if canvas == 0: ret (0 - 1)
  offset_y:int = 0
  if is_hot != 0:
    offset_y = 0 - 3

  tzi_draw_app_icon(canvas, x, y + offset_y, size, app_type)

  if is_hot != 0:
    gpu_render.gpr_outline(canvas, x - 2, y + offset_y - 2, size + 4, size + 4, 0x6366F1)

  if title != 0:
    tw:int = tzfont.tzf_measure_w(title, tzfont.font_poppins(), 1)
    tx:int = x + (size - tw) / 2
    ty:int = y + size + 8
    txt_c:int = 0x94A3B8
    txt_wt:int = tzfont.weight_regular()
    if is_active != 0:
      txt_c = 0xFFFFFF
      txt_wt = tzfont.weight_bold()
    tzfont.tzf_draw_text(canvas, tx, ty, title, tzfont.font_poppins(), 1, txt_wt, txt_c)

  if is_active != 0:
    gpu_render.gpr_circle(canvas, x + size/2, y + size + 22, 3, 0x10B981)

  ret 0

// ── Notification Badge & Status Indicator ─────────────────────────────────

fn tzi_draw_notification_badge(canvas:*GpuCanvas, x:int, y:int, count:int, bg:int) -> int:
  if canvas == 0 || count <= 0:
    ret 0
  bw:int = 18
  if count >= 10:
    bw = 26
  if count >= 100:
    bw = 34
  // Glowing notification pill
  gpu_render.gpr_shadow(canvas, x, y, bw, 18, 3, 140)
  gpu_render.gpr_rect_r(canvas, x, y, bw, 18, bg, 9)
  gpu_render.gpr_sheen(canvas, x + 2, y, bw - 4, gpu_render.gpr_brighten(bg, 40))
  // White count label
  if count < 10:
    s_digit:[char;2]
    unsafe:
      s_digit[0] = (48 + count) as char
      s_digit[1] = 0 as char
      gpu_render.gpr_text(canvas, x + 6, y + 5, &s_digit[0], 0xFFFFFF)
  else:
    if count < 100:
      s_double:[char;3]
      unsafe:
        s_double[0] = (48 + count / 10) as char
        s_double[1] = (48 + count % 10) as char
        s_double[2] = 0 as char
        gpu_render.gpr_text(canvas, x + 5, y + 5, &s_double[0], 0xFFFFFF)
    else:
      gpu_render.gpr_text(canvas, x + 5, y + 5, "99+", 0xFFFFFF)
  ret 0

// System tray status indicator with pulsing unread dot
fn tzi_draw_tray_icon(canvas:*GpuCanvas, x:int, y:int, icon_id:int, status_color:int, unread:int) -> int:
  if canvas == 0:
    ret (0 - 1)
  tzi_draw_icon(canvas, x, y, 20, icon_id, 0x94A3B8)
  if unread != 0:
    gpu_render.gpr_circle(canvas, x + 16, y + 4, 4, 0x080C14)
    gpu_render.gpr_circle(canvas, x + 16, y + 4, 3, status_color)
  ret 0
